# Here we list all the serial targets
serial_targets := ingen #Input file checker
serial_targets += write_default_input_file #Writes each namelist with default values
serial_targets += dump_grids #Initialises grids and writes to file
serial_targets += ball #Program to calculate ideal MHD ballooning stability
serial_targets += eiktest #Program to calculate eikcoeffs (geometry coefficients) and dump
serial_targets += ideal_ball #Calculates the ideal ballooning stability (optionally over a scan in shat/beta_prime)
serial_targets += mat_inv_benchmark #Matrix inverse benchmark
serial_targets += rungridgen #Driver program for gridgen?

# Replace the parallel mp with serial version in dependencies of codes
# we want to be serial
ifdef GK_BUILD_SERIAL_TOOLS_AS_SERIAL
make_serial = $(subst $(OBJDIR)/mp.o,$(OBJDIR)/mp_serial.o,$(1))
# Call make_serial on each of serial_targets to replace mp.o with mp_serial.o
ignored_junk := $(foreach tmp_target, $(serial_targets), $(eval $(tmp_target)_mod := $(call make_serial, $($(tmp_target)_mod))))
SERIAL_LDFLAGS:=-I$(MODDIR)/serial $(LDFLAGS)
else
SERIAL_LDFLAGS:=$(LDFLAGS)
endif
# undefined reference to `get_git_state` or `get_git_hash`? You need
# to manually add the affected binary name to needs_git_hash
# below. This file needs to be first in the list of dependencies so
# that the file that needs the functions can find them. Yes this is
# unpleasant, no we (probably?) can`t automate this like for the other
# dependencies. `fortdep` searches for module `use` statements, and
# we`re deliberately _not_ using a module for `git_hash`, otherwise
# basically the entire project needs to be rebuilt on new commits.
needs_git_hash := gs2 multigs2 ingen write_default_input_file dump_grids dump_response generate_fftw_wisdom ffttester box_to_ballooning_space gs2_export
ignored_junk := $(foreach tmp_target, $(needs_git_hash), \
	$(eval $(tmp_target)_mod := $(OBJDIR)/git_hash.o $($(tmp_target)_mod)))

# Here we have the parallel targets
parallel_targets := gs2 #Main code
parallel_targets += multigs2 #Multi-gs2 runner
parallel_targets += box_to_ballooning_space #Reports the equivalent ballooning space setup for a box mode run.
parallel_targets += dump_response #Calculates the field response matrix for current input file and writes to file
parallel_targets += ffttester #A program which test the fft transforms used in GS2
parallel_targets += generate_fftw_wisdom #Utility to produce fftw wisdom files for given problem size

# GPU-port tooling: built only on request (`make gs2_export`), deliberately not part of gs2_all so that
# default builds, `make tests` and CI keep their current target set.
gpu_port_targets := gs2_export #Dumps GS2 grids/coefficients/state (+ optional stage traces) to netCDF for the JAX port

############################################################################# PROGRAMS
gs2_all: $(serial_targets) $(parallel_targets)

$(foreach prog,$(parallel_targets),$(eval $(call build_program,$(prog),$(LDFLAGS))))
$(foreach prog,$(serial_targets),$(eval $(call build_program,$(prog),$(SERIAL_LDFLAGS))))
$(foreach prog,$(gpu_port_targets),$(eval $(call build_program,$(prog),$(LDFLAGS))))

############################################################################# LIBRARIES
### LIBGS2
$(LIBDIR)/libgs2.a: $(filter-out $(OBJDIR)/gs2.o, $(gs2_mod)) |$(LIBDIR)
	$(call messageOp,"Linking ","\\t:",$(call processName,$^),"\\n\\t\-\-\-\-\-\-\>",$(call processName,$@))
	$(QUIETSYM)$(ARCH) $(ARCHFLAGS) $@ $^
	$(QUIETSYM)$(RANLIB) $@

.PHONY: libgs2.a
libgs2.a: $(LIBDIR)/libgs2.a
