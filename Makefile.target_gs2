#Program to calculate ideal MHD ballooning stability | DOES NOT COMPILE
$(BINDIR)/ball: $(ball_mod) | $(BINDIR)
	$(call messageOp,"Linking ","\\t:",$(call processName,$^),"\\n\\t\-\-\-\-\-\-\>",$(call processName,$@))
