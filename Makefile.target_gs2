#A simple program to test linear regression on random data || Not at all gs2 specific!
$(BINDIR)/regress: $(drive_mod) | $(BINDIR)
	$(call messageOp,"Linking ","\\t:",$(call processName,$^),"\\n\\t\-\-\-\-\-\-\>",$(call processName,$@))
	$(QUIETSYM)$(LD) $(LDFLAGS) -o $@ $^ $(LIBS)

.PHONY: regress
regress: $(BINDIR)/regress

#A program which test the fft transforms used in GS2 | DOES NOT COMPILE
$(BINDIR)/ffttester: $(ffttester_mod) | $(BINDIR)
	$(call messageOp,"Linking ","\\t:",$(call processName,$^),"\\n\\t\-\-\-\-\-\-\>",$(call processName,$@))
	$(QUIETSYM)$(LD) $(LDFLAGS) -o $@ $^ $(LIBS)

