# Replace the parallel mp with serial version in dependencies of codes
# we want to be serial
ifdef GK_BUILD_SERIAL_TOOLS_AS_SERIAL
serial_targets := ingen write_default_input_file dump_grids
make_serial = $(subst $(OBJDIR)/mp.o,$(OBJDIR)/mp_serial.o,$(1))
# Call make_serial on each of serial_targets to replace mp.o with mp_serial.o
ignored_junk := $(foreach tmp_target, $(serial_targets), $(eval $(tmp_target)_mod := $(call make_serial, $($(tmp_target)_mod))))
SERIAL_LDFLAGS:=-I$(MODDIR)/serial $(LDFLAGS)
else
SERIAL_LDFLAGS:=$(LDFLAGS)
endif
# undefined reference to `get_git_state` or `get_git_hash`? You need
# to manually add the affected binary name to needs_git_hash
# below. This file needs to be first in the list of dependencies so
# that the file that needs the functions can find them. Yes this is
# unpleasant, no we (probably?) can`t automate this like for the other
# dependencies. `fortdep` searches for module `use` statements, and
# we`re deliberately _not_ using a module for `git_hash`, otherwise
# basically the entire project needs to be rebuilt on new commits.
needs_git_hash := gs2 ingen write_default_input_file dump_grids dump_response generate_fftw_wisdom ffttester box_to_ballooning_space
ignored_junk := $(foreach tmp_target, $(needs_git_hash), \
	$(eval $(tmp_target)_mod := $(OBJDIR)/git_hash.o $($(tmp_target)_mod)))

############################################################################# PROGRAMS
gs2_all: diagnostics modules gs2 ingen rungridgen generate_fftw_wisdom dump_response eiktest
gs2_all: dump_grids ideal_ball write_default_input_file

#Main code
$(BINDIR)/gs2: $(gs2_mod) | $(BINDIR)
	$(call messageOp,"Linking ","\\t:",$(call processName,$^),"\\n\\t\-\-\-\-\-\-\>",$(call processName,$@))
	$(QUIETSYM)$(LD) $(LDFLAGS) -o $@ $^ $(LIBS) 

.PHONY: gs2
gs2: $(BINDIR)/gs2

#Main code
$(BINDIR)/gs2.x: $(gs2_mod) | $(BINDIR)
	$(call messageOp,"Linking ","\\t:",$(call processName,$^),"\\n\\t\-\-\-\-\-\-\>",$(call processName,$@))
	$(QUIETSYM)$(LD) $(LDFLAGS) -o $@ $^ $(LIBS)

.PHONY: gs2.x
gs2.x: $(BINDIR)/gs2.x

#Mat inv benchmark
$(BINDIR)/mat_inv_benchmark: $(mat_inv_benchmark_mod) | $(BINDIR)
	$(call messageOp,"Linking ","\\t:",$(call processName,$^),"\\n\\t\-\-\-\-\-\-\>",$(call processName,$@))
	$(QUIETSYM)$(LD) $(LDFLAGS) -o $@ $^ $(LIBS)

.PHONY: mat_inv_benchmark
mat_inv_benchmark: $(BINDIR)/mat_inv_benchmark

#Input file checker
$(BINDIR)/ingen: $(ingen_mod) | $(BINDIR)
	$(call messageOp,"Linking ","\\t:",$(call processName,$^),"\\n\\t\-\-\-\-\-\-\>",$(call processName,$@))
	$(QUIETSYM)$(LD) $(SERIAL_LDFLAGS) -o $@ $^ $(LIBS)

.PHONY: ingen
ingen: $(BINDIR)/ingen

#Utility to produce fftw wisdom files for given problem size
