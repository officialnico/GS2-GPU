
ifdef USE_MPI
MACRO_DEFS += -DHAVE_MPI
endif

MACRO_DEFS+= -DFORTRAN_NETCDF -DISO_C_BINDING

ifdef USE_PARALLEL_NETCDF
	MACRO_DEFS += -DPARALLEL
endif

CFLAGS+= -I$(SRCDIR)/diagnostics/simpledataio

SIMPLEDATAIO_LIB_DIR_ABS=$(LIBDIR)
SIMPLEDATAIO_LIB=$(LIBDIR)/libsimpledataio.a
SIMPLEDATAIO_LIB_ABS=$(SIMPLEDATAIO_LIB_DIR_ABS)/libsimpledataio.a


distclean_simpledataio:
clean_simpledataio:
simpledataio:

SIMPLEDATAIO_VPATH=:diagnostics/simpledataio/src/:../diagnostics/simpledataio/src/:diagnostics/simpledataio/include/:../diagnostics/simpledataio/include/

diagnostics: $(LIBDIR)/libsimpledataio.a

$(LIBDIR)/libsimpledataio.a: $(OBJDIR)/simpledataio_write.o $(OBJDIR)/simpledataiof.o $(OBJDIR)/simpledataio.o $(OBJDIR)/simpledataio_read.o |$(LIBDIR)
	$(call messageOp,"Linking ","\\t:",$^,"\\n\\t\-\-\-\-\-\-\>",$@)
	$(QUIETSYM)$(ARCH) $(ARCHFLAGS) $@ $^
	$(QUIETSYM)$(RANLIB) $@

ifdef ONE_STEP_PP
$(OBJDIR)/simpledataio_write.o: simpledataio_write.F90 $(OBJDIR)/simpledataiof.o
	$(call messageOp,"Compiling and preprocessing","\\t:",$<)
	$(QUIETSYM)$(FC) $(MACRO_DEFS) $(subst $(DBLEFLAGS),,$(F90FLAGS)) -c $< -o $@

$(OBJDIR)/simpledataio_read.o: simpledataio_read.F90 $(OBJDIR)/simpledataiof.o $(OBJDIR)/simpledataio_write.o
	$(call messageOp,"Compiling and preprocessing","\\t:",$<)
	$(QUIETSYM)$(FC) $(MACRO_DEFS) $(subst $(DBLEFLAGS),,$(F90FLAGS)) -c $< -o $@

$(OBJDIR)/simpledataiof.o: simpledataiof.F90 $(OBJDIR)/simpledataio.o
	$(call messageOp,"Compiling and preprocessing","\\t:",$<)
	$(QUIETSYM)$(FC) $(MACRO_DEFS) $(subst $(DBLEFLAGS),,$(F90FLAGS)) -c $< -o $@
else
$(OBJDIR)/simpledataio_write.o: simpledataio_write.f90 $(OBJDIR)/simpledataiof.o
	$(call messageOp,"Compiling","\\t:",$<)
	$(QUIETSYM)$(FC) $(subst $(DBLEFLAGS),,$(F90FLAGS)) -c $< -o $@

$(OBJDIR)/simpledataio_read.o: simpledataio_read.f90 $(OBJDIR)/simpledataiof.o $(OBJDIR)/simpledataio_write.o
	$(call messageOp,"Compiling","\\t:",$<)
	$(QUIETSYM)$(FC) $(subst $(DBLEFLAGS),,$(F90FLAGS)) -c $< -o $@

$(OBJDIR)/simpledataiof.o: simpledataiof.f90 $(OBJDIR)/simpledataio.o
	$(call messageOp,"Compiling","\\t:",$<)
	$(QUIETSYM)$(FC) $(subst $(DBLEFLAGS),,$(F90FLAGS)) -c $< -o $@
endif

$(OBJDIR)/simpledataio.o: $(SRCDIR)/diagnostics/simpledataio/include/definitions.h $(SRCDIR)/diagnostics/simpledataio/include/simpledataio.h

#ifdef DBLE
#CPPFLAGS+=-DSDATIO_DEFAULT_DOUBLE
#endif

$(SRCDIR)/diagnostics/simpledataio/src/simpledataio_write.F90: diagnostics/simpledataio/src/generate_simpledataio_write.rb
	$(call messageOp,"Generating from ruby","\\t:",$<)
	$(QUIETSYM)$(call RUBY_GENERATE,$@,$<)
$(SRCDIR)/diagnostics/simpledataio/src/simpledataio_read.F90: diagnostics/simpledataio/src/generate_simpledataio_read.rb
	$(call messageOp,"Generating from ruby","\\t:",$<)
	$(QUIETSYM)$(call RUBY_GENERATE,$@,$<)

# Commands for generating repetitive Fortran files from Ruby scripts
$(SRCDIR)/diagnostics/diagnostics_create_and_write.f90: diagnostics/generate_diagnostics_create_and_write.rb
	$(call messageOp,"Generating from ruby","\\t:",$<)
	$(QUIETSYM)$(call RUBY_GENERATE,$@,$<)
$(SRCDIR)/diagnostics/diagnostics_config.f90: diagnostics/generate_diagnostics_config.rb
	$(call messageOp,"Generating from ruby","\\t:",$<)
	$(QUIETSYM)$(call RUBY_GENERATE,$@,$<)
$(SRCDIR)/diagnostics/diagnostics_ascii.f90: diagnostics/generate_diagnostics_ascii.rb
	$(call messageOp,"Generating from ruby","\\t:",$<)
	$(QUIETSYM)$(call RUBY_GENERATE,$@,$<)

# This must be built without promotion of reals to doubles
$(OBJDIR)/diagnostics_create_and_write.o: diagnostics_create_and_write.f90
	$(call messageOp,"Compiling","\\t:",$<)
	$(QUIETSYM)$(FC) $(subst $(DBLEFLAGS),,$(F90FLAGS)) -c $< -o $@

# This line ensures that libsimpledataio is built before any of the diagnostics
# modules
$(OBJDIR)/diagnostics_ascii.o $(OBJDIR)/diagnostics_dimensions.o: $(SIMPLEDATAIO_LIB)
