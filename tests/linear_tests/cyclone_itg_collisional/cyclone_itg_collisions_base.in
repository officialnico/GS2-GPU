&kt_grids_single_parameters
  aky = 0.4
/

&parameters
 beta = 1.0e-4
 zeff = 1.0
/

&theta_grid_parameters
 ntheta = 12
 nperiod = 1
 eps = 0.18
 epsl = 2.0
 shat = 0.8
 pk = 1.44
 shift = 0.0
/

&theta_grid_knobs
 equilibrium_option = "s-alpha"
/

&le_grids_knobs
 npassing = 5
 nesub = 10
 nesuper = 2
/

&knobs
 fphi = 1.0
 fapar = 1.0
 fbpar = 1.0
 delt = 0.05
 nstep = 600
/
&fields_knobs
 field_option = 'local'
/
&dist_fn_species_knobs_1
 fexpr = 0.45
 bakdif = 0.05
/
&dist_fn_species_knobs_2
 fexpr = 0.45
 bakdif = 0.05
/

&init_g_knobs
 chop_side = .false.
 phiinit = 0.001
 ginit_option = "default"
/

&gs2_diagnostics_knobs
 write_ascii = F
 print_line = .false.
 write_verr = .false.
 write_avg_moments = .F.
 nwrite = 10000
 navg = 10
 omegatol = -0.001
 omegatinst = 500.0
 save_for_restart = .false.
/
