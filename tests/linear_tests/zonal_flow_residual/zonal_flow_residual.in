!=================================================================
!                        GS2 INPUT FILE
!=================================================================
!
!  GS2 is a gyrokinetic flux tube initial value turbulence code
!  which can be used for fusion or astrophysical plasmas.
!
!  Website:
!            https://gyrokinetics.gitlab.io/gs2/
!  Repo:
!            https://bitbucket.org/gyrokinetics/gs2/
!  Citation:
!            https://zenodo.org/record/2551066
!  doi:
!            10.5281/zenodo.2551066
!
!=================================================================

!==============================
!GENERAL PARAMETERS
!==============================
&parameters
 beta = 0.0
 zeff = 1.0
/

&kt_grids_knobs
 grid_option = "single"
/

&kt_grids_single_parameters
 aky = 0.0
 akx = 0.002
/

&theta_grid_parameters
 ntheta = 64
 nperiod = 1
 eps = 0.02
 epsl = 1.3
 qinp = 1.3
 shat = 0.1
 pk = 1.0 ! pk = 2 a / q R, epsl / q
 shift = 0.0
/

&le_grids_knobs
 ngauss = 32
 negrid = 32
/

&knobs
 delt = 10
 nstep = 15
/

&theta_grid_knobs
 equilibrium_option = "s-alpha"
/

&theta_grid_salpha_knobs
 model_option = "default"
/

&theta_grid_eik_knobs
 s_hat_input = 0.1
/

&dist_fn_knobs
 adiabatic_option = "field-line-average-term"
 opt_source = T
/

&dist_fn_species_knobs_1
 fexpr = 0.4 ! Temporal implicitness parameter. Recommended value: 0.48
 bakdif = 0.05 ! Spatial implicitness parameter. Recommended value: 0.05
/

&fields_knobs
 field_option = "local"
/

&layouts_knobs
 layout = "lexys"
/

&collisions_knobs
 collision_model = "none"
/

&nonlinear_terms_knobs
 nonlinear_mode = "off"
 cfl = 0.5
/

&species_knobs
 nspec = 1
/

&species_parameters_1
 z = 1.0 ! Charge
 mass = 1.0 ! Mass
 dens = 1.0 ! Density
 temp = 1.0 ! Temperature
 tprim = 1 ! -1/T (dT/drho)
 fprim = 1 ! -1/n (dn/drho)
 uprim = 0.0 ! ?
 vnewk = 0.01 ! collisionality parameter
 type = "ion" ! Type of species, e.g. 'ion', 'electron', 'beam'
/

&init_g_knobs
 chop_side = .false. ! Rarely needed. Forces asymmetry into initial condition.
 phiinit = 0.001 ! Average amplitude of initial perturbation of each Fourier mode.
 ginit_option = "default" ! Sets the way that the distribution function is initialized.
/

&source_knobs
 source_option = "default"
 ! phi_ext = -1
 ! t0 = -1
/

&gs2_diagnostics_knobs
 nwrite =  1
 serial_netcdf4 =  F
 write_ascii =  F
 write_correlation =  F
 write_fields =  F
 write_flux_line =  F
 write_line =  F
 write_moments =  F
 write_nl_flux =  F
 write_omavg =  F
 write_omega =  F
 omegatol = -0.001
/
