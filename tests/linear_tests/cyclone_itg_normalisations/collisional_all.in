! Standard normalisation options - Collisional case, electron mass,
! high temperature, density, electron charge /2, length scale a/10
! Ion mass, ion temperature, minor radius, ion Larmor radius
! Should match collisional_baseline 
  
&kt_grids_single_parameters
 aky = 0.0737981722
/

&knobs
 delt = 135.5047111
 nstep = 2000
 fapar = 1.0
 fbpar = 1.0
 beta = 5.0
/

&species_parameters_1
 z = -2.0
 mass = 1836.15267
 dens = 0.1
 temp = 0.1
 tprim = 0.69
 fprim = 0.22
 uprim = 0.0
 vnewk = 0.0000172223
 type = "ion"
/

&dist_fn_species_knobs_1
 fexpr = 0.5
 bakdif = 0.0
/

&species_parameters_2
 z = 2.0
 mass = 1.0
 dens = 0.1
 temp = 0.1
 tprim = 0.69
 fprim = 0.22
 uprim = 0.0
 vnewk = 0.000737981722
 type = "electron"
/

&dist_fn_species_knobs_2
 fexpr = 0.5
 bakdif = 0.0
/

&species_knobs
 nspec = 2
/

&test_settings
  tolerance = 1.0e-5
  omega_expected = -0.000986984262
  gamma_expected = 0.000952913834
/

&theta_grid_parameters
 ntheta = 12
 nperiod = 1
 eps = 0.18
 epsl = 0.2
 shat = 0.8
 pk = 0.144
 shift = 0.0
/

!Include the shared parameters
!include grids.in
