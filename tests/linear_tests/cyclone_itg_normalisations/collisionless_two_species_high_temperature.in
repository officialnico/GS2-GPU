! Standard normalisation options - two species case, Tref x 10
! Ion mass, ion temperature, minor radius, ion Larmor radius
! Should match collisionless_two_species_baseline 
! Scale ky, dt up by sqrt(10), scale temp down by 10, gamma and omega down by sqrt(10)

&kt_grids_single_parameters
 aky = 1.5811388300842
/

&knobs
 delt = 0.3162277660168379
 nstep = 2000
/

&species_parameters_1
 z = 1.0
 mass = 1.0
 dens = 1.0
 temp = 0.1
 tprim = 6.9
 fprim = 2.2
 uprim = 0.0
 vnewk = 0.0
 type = "ion"
/

&dist_fn_species_knobs_1
 fexpr = 0.5
 bakdif = 0.0
/

&species_parameters_2
 z = -1.0
 mass = 0.000544617021
 dens = 1.0
 temp = 0.1
 tprim = 6.9
 fprim = 2.2
 uprim = 0.0
 vnewk = 0.0
 type = "electron"
/

&dist_fn_species_knobs_2
 fexpr = 0.5
 bakdif = 0.0
/

&species_knobs
 nspec = 2
/

&test_settings
  tolerance = 1.0e-5
  omega_expected = 0.243029556234928
  gamma_expected = 0.107272922145123
/
!Include the shared parameters
!include grids.in
