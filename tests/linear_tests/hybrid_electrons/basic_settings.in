&collisions_knobs
    collision_model = 'default'
/

&theta_grid_parameters
    ntheta = 32
    nperiod = 1
    rhoc = 0.54
    shat = 0.8
    qinp = 1.4
    rmaj = 3.0
    r_geo = 3.0
    shift = 0.0
    akappa = 1.0
    akappri = 0.0
    tri = 0.0
    tripri = 0.0
/

&parameters
    beta = 0.0
    zeff = 1.0
    tite = 1.0
/

&theta_grid_eik_knobs
    itor = 1
    iflux = 0
    irho = 2
    local_eq = .true.
    equal_arc = .true.
    bishop = 4
    s_hat_input = 0.8
    beta_prime_input = 0.0
    delrho = 0.001
    isym = 0
    writelots = .false.
/

&fields_knobs
    field_option = 'implicit'
/

&gs2_diagnostics_knobs
    print_flux_line = .false.
    write_nl_flux = .false.
    print_line = .false.
    write_line = .false.
    write_omega = .true.
    write_final_fields = .true.
    write_g = .false.
    write_verr = .false.
    nwrite = 50
    navg = 50
    omegatinst = 500.0
    save_for_restart = .false.
    save_distfn = .false.
    omegatol = 0.001
    write_ascii = F
/

&le_grids_knobs
    npassing = 3
    nesub = 6
    nesuper = 1
    wfbbc_option = 'passing'
/

&dist_fn_knobs
    adiabatic_option = 'iphi00=2'
    gridfac = 1.0
    boundary_option = 'default'
    mult_imp = .true.
/

&kt_grids_knobs
    grid_option = 'single'
/

&kt_grids_single_parameters
    aky = 0.5
    theta0 = 0.1
/

&init_g_knobs
    chop_side = .false.
    phiinit = 1000.0
    ginit_option = 'default'
    width0 = 3.0
    clean_init = .true.
/

&knobs
    fphi = 1.0
    fapar = 0.0
    fbpar = 0.0
    delt = 0.05
    nstep = 10000
/

&dist_fn_species_knobs_1
    fexpr = 0.48
    bakdif = 0.05
/

&dist_fn_species_knobs_2
    fexpr = 0.48
    bakdif = 0.0
/

&theta_grid_knobs
    equilibrium_option = 'eik'
/

&layouts_knobs
    layout = 'xyles'
/
