module test_asym_geo_fourier_mod
  use PFUNIT_MOD
  implicit none

  integer, parameter :: grid_size = 33 !! Theta-grid size

contains

  !> Calculates several geometric coefficients from the Fourier
  !! flux surface specification to verify that they have not changed
  @test(npes=[1])
  subroutine test_asym_geo_fourier(this)
    use theta_grid, only: bmag, grho, gbdrift, cvdrift, gds2, gds21
    use file_utils, only: init_file_utils, finish_file_utils
    use theta_grid_params, only: finish_theta_grid_params
    use theta_grid, only : init_theta_grid, finish_theta_grid, theta
    use mp, only : init_mp, proc0

    class(MPITestMethod), intent(inout) :: this

    logical :: dummy

    real, parameter :: previous_theta(grid_size) = [ &
         -3.14159265358979, -2.91713451542484, -2.79582156870002, &
         -2.67934723637406, -2.46167755781944, -2.26258362792251, &
         -2.07024684171549, -1.96938894250953, -1.76714586764426, &
         -1.63624617374468, -1.37444678594553, -1.11264739814639, &
         -0.850848010347236, -0.589048622548086, -0.327249234748937, &
         -0.0654498469497874, 0.111515157008186, 0.278437146313591, &
         0.495731986453196, 0.668830454136973, 0.801865143531036, &
         0.915255459643502, 1.04168918549771, 1.22226593954443, 1.34215834731803, &
         1.5707963267949, 1.70169602069447, 1.96349540849362, 2.22529479629277, &
         2.48709418409192, 2.61799387799149, 2.74889357189107, 3.14159265358979]
    real, parameter :: previous_Bmag(grid_size) = [ &
         1.33247920432863, 1.31612093179699, 1.29946662885891, &
         1.27867395216889, 1.22908882703966, 1.17543309109491, 1.12142773450549, &
         1.09405234184195, 1.04443737157047, 1.01743922357786, 0.976518584841352, &
         0.948852606064969, 0.92567112432382, 0.901560270524175, &
         0.876696387916461, 0.85804082941264, 0.853765119657491, 0.85804082941264, &
         0.876696387916461, 0.901560270524175, 0.92567112432382, &
         0.948852606064969, 0.976518584841352, 1.01743922357786, 1.04443737157047, &
         1.09405234184195, 1.12142773450549, 1.17543309109491, 1.22908882703966, &
         1.27867395216889, 1.29946662885891, 1.31612093179699, 1.33247920432863]
    real, parameter :: previous_grho(grid_size) = [ &
         0.671501483840073, 0.655487363476978, 0.645599213295501, &
         0.635742122445721, 0.620204424863232, 0.616915662327911, &
         0.632575635605876, 0.650716628967558, 0.711663176972256, &
         0.768652571882644, 0.909022015378649, 1.03232542753503, 1.08666674087534, &
         1.07815599588663, 1.00495867280352, 0.889888866243253, 0.818617134693027, &
         0.772032320636206, 0.750631280484544, 0.764578883372316, &
         0.789896470536241, 0.817870104282596, 0.851175136538189, &
         0.892941659244778, 0.91128898930372, 0.918178855186163, 0.90659125752746, &
         0.860302827460882, 0.799036245355089, 0.742509828797571, &
         0.720571978383817, 0.703462522329126, 0.671501483840073]
    real, parameter :: previous_gbdrift(grid_size) = [ &
         -1.02675076982787, -0.712188695393604, -0.559759077451707, &
         -0.427418148950962, -0.210617006620957, -0.0358574849251834, &
         0.1116700711218, 0.176698294507744, 0.270910693975262, 0.305423021141368, &
         0.327008185034375, 0.304605824264293, 0.308170760694442, &
         0.410862855446906, 0.538550943345619, 0.634509404720242, &
         0.690201732866358, 0.733489942139684, 0.766079697256556, &
         0.775936148677023, 0.778896257295165, 0.77833162211924, &
         0.769121449623944, 0.727713026880764, 0.676427872370098, &
         0.536177654032507, 0.444100418329852, 0.252102676776082, &
         0.0271704201450495, -0.266947097922213, -0.444224156248514, &
         -0.641131601923235, -1.30793358152605]
    real, parameter :: previous_cvdrift(grid_size) = [ &
         -0.993592265700363, -0.677794039751111, -0.52453365057772, &
         -0.391132079595237, -0.171522016484926, 0.00674530429816974, &
         0.158464671819693, 0.225933963622792, 0.325294877600104, &
         0.36311217577338, 0.390615818095827, 0.372744411462824, &
         0.379798997099257, 0.485852061122044, 0.616960268531764, &
         0.715284524279038, 0.771145235600003, 0.813219525923106, &
         0.84231516031188, 0.84821697604947, 0.847733242221914, 0.844130116660562, &
         0.831572101771524, 0.78567053085079, 0.731665886645086, &
         0.586798679367602, 0.492334631269755, 0.295888384568845, &
         0.0669182855674066, -0.230480773431685, -0.408990515658395, &
         -0.606803735548376, -1.27477507739854]
    real, parameter :: previous_gds2(grid_size) = [ &
         11.6049788732708, 9.15669065426713, 7.9741938845344, 6.9537966299253, &
         5.3440765622626, 4.16542746565929, 3.23360024015036, 2.81193778279101, &
         2.10574039065887, 1.75476375835388, 1.27773974817141, 0.977910917964627, &
         0.778943044644653, 0.72381779085515, 0.779773427152757, &
         0.914765658810115, 1.05714439231478, 1.22213615155228, 1.46545122221875, &
         1.69065842489429, 1.89977539274363, 2.11142850653197, 2.377386098724, &
         2.76926701272068, 2.9966278638664, 3.28687470178678, 3.3924932432907, &
         3.68816940490324, 4.40854661623836, 5.77781117787066, 6.72122080469637, &
         7.82487616839872, 11.6751919089698]
    real, parameter :: previous_gds21(grid_size) = [ &
         2.49282681756036, 1.98171057672493, 1.713167424188, &
         1.46178180604044, 1.02158965031201, 0.671201458202287, 0.384849911828544, &
         0.251709843723088, 0.00818196218607744, -0.137925348697144, &
         -0.378620178747353, -0.422100389034839, -0.199677854672951, &
         0.0671990372225844, 0.146307290631467, 0.0410681378244653, &
         -0.0765072059278562, -0.204285696511398, -0.404270059411236, &
         -0.606999009630022, -0.793734660038757, -0.971002365852916, &
         -1.1751364962134, -1.43837419210737, -1.56482228278578, &
         -1.65358650846827, -1.62808077621605, -1.52874236979382, &
         -1.51507996128859, -1.66427024835468, -1.79609246602364, &
         -1.95675858102594, -2.50400156926134]

    real, dimension(grid_size) :: new_bmag, new_grho, new_gbdrift, new_cvdrift, new_gds2, new_gds21

    call init_mp(this%getMpiCommunicator())
    if (proc0) then
      ! This is very fragile! Assumes executable is called from top-level directory
      ! FIXME: initialise relevant modules with parameters directly
      call init_file_utils(dummy, .true., .true., .false., 'tests/pfunit_tests/asym_geo_fourier/local')
    end if
    call init_theta_grid

    new_bmag = interpolate(bmag, previous_theta, theta)
    new_grho = interpolate(grho, previous_theta, theta)
    new_gbdrift = interpolate(gbdrift, previous_theta, theta)
    new_cvdrift = interpolate(cvdrift, previous_theta, theta)
    new_gds2 = interpolate(gds2, previous_theta, theta)
    new_gds21 = interpolate(gds21, previous_theta, theta)

    if (proc0) call finish_file_utils
    call finish_theta_grid

    ! Need to explicitly call finish_theta_grid_params here because
    ! finish_theta_grid _doesn't_ call it because "this is now handled
    ! separately by gs2_init"
    call finish_theta_grid_params

    @assertEqual(previous_bmag, new_Bmag, tolerance=1.e-8, message="Bmag")
    @assertEqual(previous_grho, new_grho, tolerance=1.e-8, message="grho")
    @assertEqual(previous_gbdrift, new_gbdrift, tolerance=1.e-8, message="gbdrift")
    @assertEqual(previous_cvdrift, new_cvdrift, tolerance=1.e-8, message="cvdrift")
    @assertEqual(previous_gds2, new_gds2, tolerance=1.e-8, message="gds2")
    @assertEqual(previous_gds21, new_gds21, tolerance=1.e-8, message="gds21")

  end subroutine test_asym_geo_fourier

  !> Interpolate `var` from `new_theta` onto `old_theta`
  function interpolate(var, old_theta, new_theta)
    use splines, only : new_spline, splint, delete_spline, spline_type => spline
    real, dimension(grid_size), intent(in) :: var       !! The variable to spline
    real, dimension(grid_size), intent(in) :: old_theta !! The old theta grid
    real, dimension(grid_size), intent(in) :: new_theta !! The new theta grid
    real, dimension(grid_size) :: interpolate
    type(spline_type) :: spline
    integer :: i

    call new_spline(size(var), new_theta, var, spline)
    do i = 1, grid_size
      interpolate(i) = splint(old_theta(i), spline)
    end do
    call delete_spline(spline)
  end function interpolate

end module test_asym_geo_fourier_mod
