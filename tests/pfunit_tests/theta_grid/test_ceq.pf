module test_ceq_mod
  use PFUNIT_MOD
  implicit none

  real, parameter :: derivative_tolerance = 5.e-3
  real, parameter :: value_tolerance = 5.e-12

contains

  @before
  subroutine setup
    ! DANGER: Empty setup to workaround bug in pfunit
  end subroutine setup

  @after
  subroutine teardown
    use ceq, only : ceq_finish
    call ceq_finish
  end subroutine teardown

  @test
  subroutine test_chease_chi_index
    use ceq, only : ceq_testing_type
    type(ceq_testing_type) :: ceq_privates
    integer, parameter :: nchi = 8

    @assertEqual(5, ceq_privates%chease_chi_index(nchi, 1))
    @assertEqual(6, ceq_privates%chease_chi_index(nchi, 2))
    @assertEqual(7, ceq_privates%chease_chi_index(nchi, 3))
    @assertEqual(8, ceq_privates%chease_chi_index(nchi, 4))
    @assertEqual(1, ceq_privates%chease_chi_index(nchi, 5))
    @assertEqual(2, ceq_privates%chease_chi_index(nchi, 6))
    @assertEqual(3, ceq_privates%chease_chi_index(nchi, 7))
    @assertEqual(4, ceq_privates%chease_chi_index(nchi, 8))
    @assertEqual(5, ceq_privates%chease_chi_index(nchi, 9))
  end subroutine test_chease_chi_index

  @test
  subroutine test_ceqin
    use ceq, only : ceq_testing_type
    use ceq, only : ceqin
    use read_chease, only: npsi_chease, nchi_chease, b0exp_chease, &
         psi_chease, f_chease, q_chease, p_chease, &
         r_chease, z_chease

    real :: psi_0_out, psi_a_out, rmaj, B_T0, avgrmid
    integer :: ntheta

    type(ceq_testing_type) :: ceq_privates

    npsi_chease = 3
    nchi_chease = 2

    b0exp_chease = 1

    allocate(psi_chease(npsi_chease))
    allocate(f_chease(npsi_chease))
    allocate(q_chease(npsi_chease))
    allocate(p_chease(npsi_chease))
    allocate(r_chease(npsi_chease, nchi_chease))
    allocate(z_chease(npsi_chease, nchi_chease))

    psi_chease = [1., 2., 3.]
    f_chease = [0.5, 0., -0.5]
    q_chease = [4., 9., 16.]
    p_chease = [3., 5., 7.]
    r_chease = reshape([0., 1., 2., &
                        3., 4., 5.], &
                        shape=shape(r_chease))
    z_chease = reshape([10., 21., 32., &
                        43., 54., 65.], &
                        shape=shape(z_chease))

    call ceq_privates%set_ceq_from_chease

    call ceqin("this won't be read", &
         psi_0_out, psi_a_out, rmaj, B_T0, avgrmid, &
         initeq=1, in_nt=.true., nthg=ntheta)

    @assertEqual(3.1111111, psi_0_out, tolerance=1e-5, message="psi_0_out")
    @assertEqual(9.3333333, psi_a_out, tolerance=1e-5, message="psi_a_out")
    @assertEqual(-2., rmaj, message="rmaj")
    @assertEqual(0.5/3.5, B_T0, message="B_T0")
    @assertEqual(-1.5, avgrmid, message="avgrmid")
    @assertEqual(3, ntheta, message="ntheta")
  end subroutine test_ceqin

  @test
  subroutine test_ceqin_non_init
    use ceq, only : ceq_testing_type
    use ceq, only : ceqin
    type(ceq_testing_type) :: ceq_privates

    real :: psi_0_out, psi_a_out, rmaj, B_T0, avgrmid
    integer :: ntheta

    integer, parameter :: expected_ntheta = 3

    call ceq_privates%set_ntnr(expected_ntheta, 4)
    call ceqin("this won't be read", &
         psi_0_out, psi_a_out, rmaj, B_T0, avgrmid, &
         initeq=0, in_nt=.true., nthg=ntheta)

    @assertEqual(expected_ntheta, ntheta)
  end subroutine test_ceqin_non_init

  @test
  subroutine test_derm_even_function()
    use constants, only : pi
    use ceq, only : ceq_testing_type
    type(ceq_testing_type) :: ceq_privates

    integer, parameter :: nradius = 3
    integer, parameter :: ntheta = 128
    integer, parameter :: total_size(2) = [nradius, ntheta]
    real, parameter :: theta_grid_spacing = 2 * pi / (ntheta - 1)
    real, dimension(nradius, ntheta) :: f_input
    real, dimension(nradius, ntheta, 2) :: df_result
    real, dimension(nradius, ntheta, 2) :: df_expected

    integer :: i, j

    call ceq_privates%set_ntnr(ntheta, nradius)

    f_input = reshape([([(i*i*cos(j * theta_grid_spacing), &
         i=0, nradius-1)], j=0, ntheta-1)], total_size)

    df_expected(:, :, 1) = reshape( &
         [([0., 2., 4.]*cos(j * theta_grid_spacing), &
         j=0, ntheta-1)], total_size)
    df_expected(:, :, 2) = reshape( &
         [([(-i*i*sin(j * theta_grid_spacing) * theta_grid_spacing, &
         i=0, nradius-1)], j=0, ntheta-1)], total_size)

    call ceq_privates%derm(f_input, df_result, 'E')

    @assertEqual(df_expected(:,:,1), df_result(:,:,1), tolerance=derivative_tolerance, message="Radial derivative")
    @assertEqual(df_expected(:,:,2), df_result(:,:,2), tolerance=derivative_tolerance, message="Theta derivative")
  end subroutine test_derm_even_function

  @test
  subroutine test_derm_odd_function()
    use constants, only : pi
    use ceq, only : ceq_testing_type
    type(ceq_testing_type) :: ceq_privates

    integer, parameter :: nradius = 3
    integer, parameter :: ntheta = 128
    integer, parameter :: total_size(2) = [nradius, ntheta]
    real, parameter :: theta_grid_spacing = 2 * pi / (ntheta - 1)
    real, dimension(nradius, ntheta) :: f_input
    real, dimension(nradius, ntheta, 2) :: df_result
    real, dimension(nradius, ntheta, 2) :: df_expected

    integer :: i, j

    call ceq_privates%set_ntnr(ntheta, nradius)

    f_input = reshape([([(i*i * sin(j * theta_grid_spacing), &
         i=0, nradius-1)], j=0, ntheta-1)], total_size)

    df_expected(:, :, 1) = reshape( &
         [([0., 2., 4.] * sin(j * theta_grid_spacing), &
         j=0, ntheta-1)], total_size)
    df_expected(:, :, 2) = reshape( &
         [([(i*i*cos(j * theta_grid_spacing) * theta_grid_spacing, &
         i=0, nradius-1)], j=0, ntheta-1)], total_size)

    call ceq_privates%derm(f_input, df_result, 'O')

    @assertEqual(df_expected(:, :, 1), df_result(:, :, 1), tolerance=derivative_tolerance, message="Radial derivative")
    @assertEqual(df_expected(:, :, 2), df_result(:, :, 2), tolerance=derivative_tolerance, message="Theta derivative")
  end subroutine test_derm_odd_function

  @test
  subroutine test_derm_T()
    use constants, only : pi
    use ceq, only : ceq_testing_type
    type(ceq_testing_type) :: ceq_privates

    integer, parameter :: nradius = 3
    integer, parameter :: ntheta = 4
    integer, parameter :: total_size(2) = [nradius, ntheta]
    real, parameter :: theta_grid_spacing = 2 * pi / (ntheta - 1)
    real, dimension(nradius, ntheta) :: f_input
    real, dimension(nradius, ntheta, 2) :: df_result
    real, dimension(nradius, ntheta, 2) :: df_expected

    integer :: i, j

    call ceq_privates%set_ntnr(ntheta, nradius)

    f_input = reshape([([(j*theta_grid_spacing, i=1, nradius)], j=0, ntheta-1)], total_size)

    df_expected(:, :, 1) = 0.
    df_expected(:, :, 2) = theta_grid_spacing

    call ceq_privates%derm(f_input, df_result, 'T')

    @assertEqual(df_expected(:, :, 1), df_result(:, :, 1), tolerance=1.e-14)
    @assertEqual(df_expected(:, :, 2), df_result(:, :, 2), tolerance=1.e-14)

  end subroutine test_derm_T

  @test
  subroutine test_mod2pi()
    use constants, only : pi
    use ceq, only : ceq_testing_type
    type(ceq_testing_type) :: ceq_privates

    @assertEqual(0.0, ceq_privates%mod2pi(0.0), tolerance=value_tolerance)
    @assertEqual(1.0, ceq_privates%mod2pi(1.0), tolerance=value_tolerance)
    @assertEqual(-1.0, ceq_privates%mod2pi(-1.0), tolerance=value_tolerance)
    @assertEqual(pi, ceq_privates%mod2pi(pi), tolerance=value_tolerance)
    @assertEqual(-pi, ceq_privates%mod2pi(-pi), tolerance=value_tolerance)
    @assertEqual(0.0, ceq_privates%mod2pi(2. * pi), tolerance=value_tolerance)
    @assertEqual(0.0, ceq_privates%mod2pi(-2. * pi), tolerance=value_tolerance)
    @assertEqual(pi / 2., ceq_privates%mod2pi(2. * pi + (pi/2.)), tolerance=value_tolerance)
    @assertEqual(-pi / 2., ceq_privates%mod2pi(pi + (pi/2.)), tolerance=value_tolerance)
  end subroutine test_mod2pi

