module test_asym_geo_miller_mod
  use PFUNIT_MOD
  implicit none
  
  integer, parameter :: grid_size = 33 !! Theta-grid size

contains

  !>  Calculates several geometric coefficients from the generalized
  !!  Miller flux surface specification to verify that they have not
  !!  changed.
  @test(npes=[1])
  subroutine test_asym_geo_miller(this)
    use theta_grid, only: bmag, grho, gbdrift, cvdrift, gds2, gds21
    use file_utils, only: init_file_utils, finish_file_utils
    use theta_grid, only : init_theta_grid, finish_theta_grid, theta
    use theta_grid_params, only: finish_theta_grid_params
    use mp, only : init_mp, proc0

    class(MPITestMethod), intent(inout) :: this

    logical :: dummy
    real, parameter :: previous_theta(grid_size) = [ &
         -3.14159265358979, -2.96909691483081, -2.79753624140583, &
         -2.62691063331481, -2.45995122460437, -2.29564390653795, &
         -2.13398867911553, -1.97902030603011, -1.82790760022706, &
         -1.54168052849789, -1.27627882252284, -1.03444601532502, &
         -0.809104557779855, -0.596535696876655, -0.393953292215471, &
         -0.19590929198706, -4.44089209850063e-16, 0.195909291987062, &
         0.393953292215472, 0.596535696876654, 0.809104557779858, &
         1.03444601532502, 1.27627882252284, 1.54168052849789, 1.82790760022705, &
         1.97902030603012, 2.13398867911553, 2.29564390653794, 2.45995122460437, &
         2.62691063331481, 2.79753624140584, 2.96909691483083, 3.14159265358979 ]
    real, parameter :: previous_Bmag(grid_size) = [ &
         1.3363855462515994, 1.3305905133924090, 1.3149552328017893, &
         1.2903530104889047, 1.2585918691453410, 1.2216981072695459, &
         1.1815536384189853, 1.1412328821860873, 1.1017312191758513, &
         1.0308504561328451, 0.97441204988588437, 0.93355975748748321, &
         0.90563263561226837, 0.88852008093079460, 0.88018425338686368, &
         0.87899413144364980, 0.88385391526266144, 0.89415685777925924, &
         0.90952368087242019, 0.93016685359686868, 0.95701950312476858, &
         0.99099774717755473, 1.0333196361445363, 1.0853527724079113, &
         1.1454634167247346, 1.1776656224347910, 1.2100998994243142, &
         1.2424010366093350, 1.2723594466300727, 1.2985918643077439, &
         1.3192351714041197, 1.3322571290282865, 1.3363855462515997 ]
    real, parameter :: previous_grho(grid_size) = [ &
         0.66725359521320138, 0.62033287766244405, 0.59706347573969698, &
         0.60547559263276840, 0.64394301333629644, 0.70151776348278827, &
         0.76827777985631185, 0.83375587198465295, 0.89435720734447510, &
         0.99132789182951997, 1.0538587620825233, 1.0874665750720440, &
         1.1041154736432834, 1.1123280304543215, 1.1134368776736012, &
         1.1032126157242925, 1.0770003872620468, 1.0331443346736038, &
         0.97498688765256669, 0.91010747391814506, 0.85233877908542954, &
         0.82097947354070944, 0.82858466201303305, 0.86536778948362680, &
         0.90104435465173105, 0.90906780345922411, 0.90713417467766011, &
         0.89385765771397552, 0.86810899164036814, 0.83057869721681976, &
         0.78119660019600490, 0.72479061849810100, 0.66725359521320338 ]
    real, parameter :: previous_gbdrift(grid_size) = [ &
         -1.2201835087619444, -0.89164970921361009, -0.64957518370132594, &
         -0.45956614186969502, -0.31436393432866616, -0.20429166562678994, &
         -0.11004222913613360, -1.9089561276193233E-002, 7.1327491138081275E-002, &
         0.23630842888712800, 0.36343263319888153, 0.44523526525871154, &
         0.49003868768859488, 0.50889794336429939, 0.51287283897340197, &
         0.50978921746540451, 0.50431360852846374, 0.49930324836543427, &
         0.49692582279186259, 0.49744021036803748, 0.49580910960788427, &
         0.47730998527225027, 0.42305049986464621, 0.31054347256654280, &
         0.12775842742258678, 1.2813382871565747E-002, -0.11414610892389887, &
         -0.25419699107390414, -0.40457092237735914, -0.57050653078688363, &
         -0.75089671942302649, -0.96857789984124698, -1.2747158657629831 ]
    real, parameter :: previous_cvdrift(grid_size) = [ &
         -1.1852549302255582, -0.85802685657072431, -0.61541493062383357, &
         -0.42399135720189635, -0.27691372941200687, -0.16444802788443294, &
         -6.7367743777164257E-002, 2.6710878071050388E-002, 0.12052441871185292, &
         0.29261581569331313, 0.42656647402846526, 0.51408672041651948, &
         0.56321039445981580, 0.58488370929931910, 0.59025417878134812, &
         0.58731732228275424, 0.58092603159484391, 0.57410436488037186, &
         0.56917019397007795, 0.56645870626182970, 0.56095703987698786, &
         0.53807327171279429, 0.47903448645021540, 0.36137454938833857, &
         0.17339777038243701, 5.5971403944079873E-002, -7.3287692214876576E-002, &
         -0.21546205607304317, -0.36767205449614049, -0.53505927766189110, &
         -0.71666584530504540, -0.93488478788687412, -1.2397872872265969 ]
    real, parameter :: previous_gds2(grid_size) = [ &
         14.712298374361261, 10.696709864422202, 7.7308395552055122, &
         5.5939278810858593, 4.0846928812478289, 3.0469392429694526, &
         2.3399045182335625, 1.8526645855894266, 1.5039943241147575, &
         1.0843477472412828, 0.87713904752310179, 0.76382573540725662, &
         0.69027661739529200, 0.64457070691463747, 0.62533065027520052, &
         0.63284787569633494, 0.67007302199354091, 0.74431473561235251, &
         0.86497920856616883, 1.0488749107391799, 1.3250216896291471, &
         1.7194336116660502, 2.2359824374536488, 2.8030194686803891, &
         3.2322005230309703, 3.3598163726774803, 3.4468651522488440, &
         3.5261344948089817, 3.6470118864323240, 3.8969661418975896, &
         4.3150092444450117, 5.1398550032030643, 6.7729511208595454 ]
    real, parameter :: previous_gds21(grid_size) = [ &
         2.4518057086456397, 1.7578614681031395, 1.1842379629778688, &
         0.74598256295769449, 0.42867856871987942, 0.20901396831290184, &
         7.8381143984352156E-002, 2.5466632701297155E-002, 2.6743570258879835E-002, &
         0.10702419312421525, 0.18553798250363593, 0.20285948611469484, &
         0.16523624915380178, 0.10400090035818105, 4.8897370061937909E-002, &
         1.4738727572320363E-002, 1.1674550681875788E-004, -1.1351683683832200E-002, &
         -4.4167924446137798E-002, -0.12327833459288885, -0.27050444875699980, &
         -0.49355036176582828, -0.78626920039168247, -1.0977768547364797, &
         -1.3092858521103370, -1.3481262753395749, -1.3399645932507214, &
         -1.2927402882273320, -1.2209435630854770, -1.1472645502532837, &
         -1.0955782717503635, -1.1008749504595277, -1.1882193483277836 ]

    real, dimension(grid_size) :: new_bmag, new_grho, new_gbdrift, new_cvdrift, new_gds2, new_gds21

    call init_mp(this%getMpiCommunicator())
    if (proc0) then
      ! This is very fragile! Assumes executable is called from top-level directory
      ! FIXME: initialise relevant modules with parameters directly
      call init_file_utils(dummy, .true., .true., .false., 'tests/pfunit_tests/asym_geo_miller/local')
    end if
    call init_theta_grid

    new_bmag = interpolate(bmag, previous_theta, theta)
    new_grho = interpolate(grho, previous_theta, theta)
    new_gbdrift = interpolate(gbdrift, previous_theta, theta)
    new_cvdrift = interpolate(cvdrift, previous_theta, theta)
    new_gds2 = interpolate(gds2, previous_theta, theta)
    new_gds21 = interpolate(gds21, previous_theta, theta)

    if (proc0) call finish_file_utils
    call finish_theta_grid

    ! Need to explicitly call finish_theta_grid_params here because
    ! finish_theta_grid _doesn't_ call it because "this is now handled
    ! separately by gs2_init"
    call finish_theta_grid_params

    @assertEqual(new_bmag, previous_Bmag, tolerance=1.e-8, message="Bmag")
    @assertEqual(new_grho, previous_grho, tolerance=1.e-8, message="grho")
    @assertEqual(new_gbdrift, previous_gbdrift, tolerance=1.e-8, message="gbdrift")
    @assertEqual(new_cvdrift, previous_cvdrift, tolerance=1.e-8, message="cvdrift")
    @assertEqual(new_gds2, previous_gds2, tolerance=1.e-8, message="gds2")
    @assertEqual(new_gds21, previous_gds21, tolerance=1.e-8, message="gds21")

  end subroutine test_asym_geo_miller

  !> Interpolate `var` from `new_theta` onto `old_theta`
  function interpolate(var, old_theta, new_theta)
    use splines, only : new_spline, splint, delete_spline, spline_type => spline
    real, dimension(grid_size), intent(in) :: var       !! The variable to spline
    real, dimension(grid_size), intent(in) :: old_theta !! The old theta grid
    real, dimension(grid_size), intent(in) :: new_theta !! The new theta grid
    real, dimension(grid_size) :: interpolate
    type(spline_type) :: spline
    integer :: i

    call new_spline(size(var), new_theta, var, spline)
    do i = 1, grid_size
      interpolate(i) = splint(old_theta(i), spline)
    end do
    call delete_spline(spline)
  end function interpolate

end module test_asym_geo_miller_mod
