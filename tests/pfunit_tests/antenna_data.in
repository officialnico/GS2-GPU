&driver
 nk_stir = 1
 restarting = .false.
 amplitude = 0.5
 ant_off = .false.
 write_antenna = .true.
/

&stir_1
 kx = 0
 ky = 1
 kz = 2
 travel = .true.
 a = (3.0, 4.0)
 b = (5.0, 6.0)
/

&optimisation_config
 nstep_measure = 5
 max_unused_procs = -1

/
!==============================
!GENERAL PARAMETERS  
!==============================
&parameters
 beta = 1.0 ! Ratio of particle to magnetic pressure (reference Beta, not total beta):  beta=n_0 T_0 /( B^2 / (8 pi))
 zeff = 1.0 ! Effective ionic charge.
/

&kt_grids_knobs
 grid_option = "box" ! The general layout of the perpendicular grid.
/

!==============================
!  
!==============================
&kt_grids_box_parameters
 y0 = 2
 ny = 4
 jtwist = 6
 nx = 4
/

!==============================
!  
!==============================
&theta_grid_parameters
 rhoc = 0.6
 rmaj = 3.1
 r_geo = 3.1
 eps = 0.4
 epsl = 0.4
 qinp = 1.6
 shat = 0.85
 pk = 0.4
 geoType = 1
 aSurf = 1.1
 shift = 1.0
 shiftVert = 1.0
 mMode = 3
 nMode = 4
 deltam = 1.1
 deltan = 1.1
 deltampri = 1.0
 deltanpri = 1.0
 thetam = 1.0
 thetan = 1.0
 btor_slab = 1.0
 ntheta = 6
 nperiod = 3
/

!==============================
!PITCH ANGLE/ENERGY GRID SETUP  
!==============================
&le_grids_knobs
 ngauss = 1 ! Number of untrapped pitch-angles moving in one direction along field line.
 negrid = 2 ! Total number of energy grid points
/

!==============================
!ALGORITHMIC CHOICES  
!==============================
&fields_knobs
 field_subgath = .true. ! Set to TRUE to use allgatherv to fetch part of the field update calculated on other procs. FALSE uses a sum_allreduce instead.
 do_smart_update = .true. ! 
 field_local_allreduce = .true. ! 
 field_local_allreduce_sub = .true. ! 
 field_option = "implicit" ! Controls which time-advance algorithm is used for the linear terms.
/

!==============================
!  
!==============================
&knobs
 wstar_units = .false. ! For linear runs only. Evolves each k_y with a different timestep.
 fphi = 1.0 ! Multiplies Phi (electrostatic potential).
 fapar = 1.0 ! Multiplies A_par. Use 1 for finite beta (electromagnetic), 0 otherwise (electrostatic)
 fbpar = 1.0 ! Multiplies A_par. Use 1 for finite beta (electromagnetic), 0 otherwise (electrostatic)
 delt = 0.05 ! Time step
 nstep = 10 ! Maximum number of timesteps
/

!==============================
!  
!==============================
&reinit_knobs
 delt_adj = 2.0 ! When the time step needs to be changed, it is adjusted 
 delt_minimum = 1.0e-06 ! The minimum time step is delt_minimum.
/

!==============================
!  
!==============================
&layouts_knobs
 layout = "lexys" ! 'yxles', 'lxyes', 'lyxes', 'lexys' Determines the way the grids are laid out in memory.
 intmom_sub=.true.
 intspec_sub=.true.
/

!==============================
!COLLISIONS  
!==============================
&collisions_knobs
 collision_model = "none" ! Collision model used in the simulation. Options: 'default', 'none', 'lorentz', 'ediffuse'
/

&species_knobs
 nspec = 1 ! Number of kinetic species evolved.
/

!==============================
!SPECIES PARAMETERS 1 
!==============================
&species_parameters_1
 z = 1.0 ! Charge
 mass = 1.0 ! Mass
 dens = 1.0 ! Density	
 temp = 1.0 ! Temperature
 tprim = 6.9 ! -1/T (dT/drho)
 fprim = 2.2 ! -1/n (dn/drho)
 uprim = 0.0 ! ?
 vnewk = 0.01 ! collisionality parameter
 type = "ion" ! Type of species, e.g. 'ion', 'electron', 'beam'
/

!==============================
! 1 
!==============================
&dist_fn_species_knobs_1
 fexpr = 0.45 ! Temporal implicitness parameter. Recommended value: 0.48
 bakdif = 0.05 ! Spatial implicitness parameter. Recommended value: 0.05
/
