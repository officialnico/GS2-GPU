module test_asym_geo_global_mod
  use PFUNIT_MOD
  implicit none

  integer, parameter :: grid_size = 33 !! Theta-grid size

contains

  !> Calculates several geometric coefficients from the global
  !! flux surface specification to verify that they have not changed
  @test(npes=[1])
  subroutine test_asym_geo_global(this)
    use theta_grid, only: bmag, grho, gbdrift, cvdrift, gds2, gds21
    use theta_grid_params, only: finish_theta_grid_params
    use file_utils, only: init_file_utils, finish_file_utils
    use theta_grid, only : init_theta_grid, finish_theta_grid, theta
    use mp, only : init_mp, proc0

    class(MPITestMethod), intent(inout) :: this

    logical :: dummy
    real, parameter :: previous_Bmag(grid_size) = [ &
         1.27666694973463, 1.27550692531511, 1.26449964489132, &
         1.23494648210597, 1.20279384602855, 1.15293014228766, 1.10321278579095, &
         1.0543333489346, 1.0040551108696, 0.963072317710879, 0.936669958081413, &
         0.916074725381391, 0.897152793473831, 0.877244603900077, &
         0.854380024490226, 0.830548368710061, 0.824442135364814, &
         0.830548368710061, 0.854380024490226, 0.877244603900077, &
         0.897152793473831, 0.916074725381391, 0.936669958081413, &
         0.963072317710879, 1.0040551108696, 1.0543333489346, 1.10321278579095, &
         1.15293014228766, 1.20279384602855, 1.23494648210597, 1.26449964489132, &
         1.27550692531511, 1.27666694973463]
    real, parameter :: previous_grho(grid_size) = [ &
         0.603135754429666, 0.604025827975812, 0.605441423617507, &
         0.599239786874565, 0.583081419296546, 0.551945400453713, &
         0.53639846173848, 0.572218570675698, 0.713418249085179, &
         0.941543739588857, 1.12223948580237, 1.24156122896741, 1.30372925663275, &
         1.30162723003027, 1.20138843161815, 0.940085060789627, 0.763627123522592, &
         0.690459991983252, 0.761186211964676, 0.854636829942572, &
         0.929675953774873, 0.987103880749867, 1.03251768641887, 1.0684539873723, &
         1.08102202210847, 1.0377322697694, 0.951870852923098, 0.840444007217525, &
         0.725991929735753, 0.661347372897694, 0.615379298062063, &
         0.603889197485332, 0.603135754429666]
    real, parameter :: previous_gbdrift(grid_size) = [ &
         -1.33304917759112, -1.17542533210474, -0.951424808825718, &
         -0.666621005227301, -0.452500669051304, -0.195879132671614, &
         0.0205118596665837, 0.211121851583925, 0.30345948112239, &
         0.279254102509424, 0.251379275159347, 0.243140145039051, &
         0.257942761105454, 0.305174196388497, 0.408311616126511, &
         0.58703727396149, 0.707277624241933, 0.824243232927535, &
         0.995937664901105, 1.11745256017359, 1.19214236863981, 1.2211431756734, &
         1.20901585542379, 1.15493189126963, 1.02638357167982, 0.827674972923401, &
         0.604474078421796, 0.334631508938451, -0.0188667103541611, &
         -0.333213705035359, -0.775320179226004, -1.10994114315583, &
         -1.20683227813116]
    real, parameter :: previous_cvdrift(grid_size) = [ &
         -1.29678457089501, -1.13877895690662, -0.913908828317634, &
         -0.627220292261546, -0.411157886018145, -0.151670922637983, &
         0.0677607667550454, 0.262831368162482, 0.362807088747796, &
         0.345778446712382, 0.321564990251858, 0.316052953750487, &
         0.333831955092946, 0.384872593919355, 0.492807379134535, &
         0.673450095231609, 0.789362542348078, 0.902211049556196, 1.0734495676225, &
         1.19385383743335, 1.26664724860456, 1.29335882696971, 1.27841592618589, &
         1.2206546632515, 1.08679098049729, 0.882384205260648, 0.654415380599573, &
         0.380163650209661, 0.0224393230674442, -0.294437378175149, &
         -0.738464688479765, -1.07362292444235, -1.17056767143505]
    real, parameter :: previous_gds2(grid_size) = [ &
         9.88543447078328, 9.04859994019211, 8.1417449575616, &
         7.37216518763141, 6.78219997991067, 5.6761834295041, 4.41751432891461, &
         3.18343731560922, 1.99498133901763, 1.22695690948499, 0.853362055149458, &
         0.64336659387846, 0.524659582319106, 0.480510398685703, &
         0.533837862668411, 0.7733496584377, 1.06399737178802, 1.42525322553234, &
         2.05161267572941, 2.6933046345703, 3.23722370957028, 3.65656651341538, &
         3.98216533496885, 4.21827967605783, 4.272728261723, 4.1041248258915, &
         4.00433379834845, 4.28789214398174, 5.29202408129118, 6.57292986681622, &
         8.77284404317691, 10.5894621397019, 11.128405344372]
    real, parameter :: previous_gds21(grid_size) = [ &
         1.85649434003572, 1.70239814451608, 1.54030652210021, &
         1.38283933462992, 1.21882729263561, 0.881099595273034, 0.512163621127848, &
         0.19054685313711, -0.144157066402628, -0.427754819577743, &
         -0.507657044502418, -0.451094735604917, -0.313699355104668, &
         -0.130479399623947, 0.0304544721232621, -0.0522913751709163, &
         -0.226783209921419, -0.464188098459784, -0.961944886460219, &
         -1.44767298886424, -1.84658561158589, -2.15265516391249, &
         -2.39168977869074, -2.5690879803687, -2.60129205588331, &
         -2.36814005141863, -2.0176081977269, -1.69347850501906, &
         -1.52190003543616, -1.54382974721387, -1.74443898091308, &
         -1.9779019667281, -2.05431929868661]
    real, parameter :: previous_theta(grid_size) = [ &
         -3.14159265358979, -3.01069295969022, -2.81434341884086, &
         -2.55254403104171, -2.3571813697969, -2.12230265477433, &
         -1.92554578747457, -1.73858626269976, -1.51332066458087, &
         -1.24354709204596, -0.98174770424681, -0.719948316447661, &
         -0.458148928648512, -0.196349540849362, 0.0654498469497874, &
         0.327249234748937, 0.478240157742181, 0.608622639517663, &
         0.763587593956699, 0.869542133133598, 0.953922485065267, 1.0337257106737, &
         1.12265894809225, 1.2416860567231, 1.43989663289532, 1.70169602069447, &
         1.96349540849362, 2.22529479629277, 2.48709418409192, 2.67327050764271, &
         2.90663167691089, 3.08771850459857, 3.14159265358979]
    real, dimension(grid_size) :: new_bmag, new_grho, new_gbdrift, new_cvdrift, new_gds2, new_gds21

    call init_mp(this%getMpiCommunicator())
    if (proc0) then
      ! This is very fragile! Assumes executable is called from top-level directory
      ! FIXME: initialise relevant modules with parameters directly
      call init_file_utils(dummy, .true., .true., .false., 'tests/pfunit_tests/asym_geo_global/local')
    end if
    call init_theta_grid

    new_bmag = interpolate(bmag, previous_theta, theta)
    new_grho = interpolate(grho, previous_theta, theta)
    new_gbdrift = interpolate(gbdrift, previous_theta, theta)
    new_cvdrift = interpolate(cvdrift, previous_theta, theta)
    new_gds2 = interpolate(gds2, previous_theta, theta)
    new_gds21 = interpolate(gds21, previous_theta, theta)

    if (proc0) call finish_file_utils
    call finish_theta_grid

    ! Need to explicitly call finish_theta_grid_params here because
    ! finish_theta_grid _doesn't_ call it because "this is now handled
    ! separately by gs2_init"
    call finish_theta_grid_params

    @assertEqual(previous_bmag, new_Bmag, tolerance=1.e-5, message="Bmag")
    @assertEqual(previous_grho, new_grho, tolerance=1.e-5, message="grho")
    @assertEqual(previous_gbdrift, new_gbdrift, tolerance=1.e-5, message="gbdrift")
    @assertEqual(previous_cvdrift, new_cvdrift, tolerance=1.e-5, message="cvdrift")
    @assertEqual(previous_gds2, new_gds2, tolerance=1.e-5, message="gds2")
    @assertEqual(previous_gds21, new_gds21, tolerance=1.e-5, message="gds21")

  end subroutine test_asym_geo_global

  !> Interpolate `var` from `new_theta` onto `old_theta`
  function interpolate(var, old_theta, new_theta)
    use splines, only : new_spline, splint, delete_spline, spline_type => spline
    real, dimension(grid_size), intent(in) :: var       !! The variable to spline
    real, dimension(grid_size), intent(in) :: old_theta !! The old theta grid
    real, dimension(grid_size), intent(in) :: new_theta !! The new theta grid
    real, dimension(grid_size) :: interpolate
    type(spline_type) :: spline
    integer :: i

    call new_spline(size(var), new_theta, var, spline)
    do i = 1, grid_size
      interpolate(i) = splint(old_theta(i), spline)
    end do
    call delete_spline(spline)
  end function interpolate

end module test_asym_geo_global_mod
