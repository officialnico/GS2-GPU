module test_asym_geo_global_mod
  use PFUNIT_MOD
  implicit none

  integer, parameter :: grid_size = 33 !! Theta-grid size

contains

  !> Calculates several geometric coefficients from the global
  !! flux surface specification to verify that they have not changed
  @test(npes=[1])
  subroutine test_asym_geo_global(this)
    use theta_grid, only: bmag, grho, gbdrift, cvdrift, gds2, gds21
    use theta_grid_params, only: finish_theta_grid_params
    use file_utils, only: init_file_utils, finish_file_utils
    use theta_grid, only : init_theta_grid, finish_theta_grid, theta
    use mp, only : init_mp, proc0

    class(MPITestMethod), intent(inout) :: this

    logical :: dummy
    real, parameter :: previous_Bmag(grid_size) = [ &
         1.27658976420608 , 1.27543059479085 , 1.26441546371943 , &
         1.23484406312188 , 1.20274088169899 , 1.15277539474225 , &
         1.10295957813011 , 1.05400330444693 , 1.0036264790282 , &
         0.962941772822837 , 0.936270189937017 , 0.915695687367451 , &
         0.896791850239388 , 0.876916936372997 , 0.854123317068131 , &
         0.830241304336681 , 0.824547154531564 , 0.830241304336681 , &
         0.854123317068131 , 0.876916936372997 , 0.896791850239388 , &
         0.915695687367451 , 0.936270189937017 , 0.962941772822837 , &
         1.0036264790282 , 1.05400330444693 , 1.10295957813011 , &
         1.15277539474225 , 1.20274088169899 , 1.23484406312188 , &
         1.26441546371943 , 1.27543059479085 , 1.27658976420608 ] 
    real, parameter :: previous_grho(grid_size) = [ &
         0.603210285160155 , 0.604167368310658 , 0.605276542816884 , &
         0.598354150102021 , 0.581904925126082 , 0.552593175300915 , &
         0.543574024554079 , 0.584932513598576 , 0.719266975872997 , &
         0.934669940497681 , 1.11723244811437 , 1.23817710683911 , &
         1.30120339156853 , 1.2996558473705 , 1.20006992294854 , &
         0.93361102625124 , 0.777606351264851 , 0.714410374678469 , &
         0.774901347005355 , 0.855788216629032 , 0.922016295737529 , &
         0.975600061346732 , 1.02145932194407 , 1.06025021454146 , &
         1.07547289175806 , 1.03444921848742 , 0.949804053844579 , &
         0.839999222507609 , 0.727556969093593 , 0.663397313431075 , &
         0.616284055544682 , 0.604094677638426 , 0.603210285160074 ] 
    real, parameter :: previous_gbdrift(grid_size) = [ &
         -1.33248976741345 , -1.17466611780719 , -0.951105668165607 , &
         -0.669013203442768 , -0.457563284404402 , -0.199374785082813 , &
         0.0222025931628693 , 0.206466938331983 , 0.290591333407503 , &
         0.278482033968678 , 0.255876030817078 , 0.24731164342606 , &
         0.261176996614344 , 0.30724271881571 , 0.410231017870196 , &
         0.578187819874322 , 0.688561114966926 , 0.800368391384352 , &
         0.960688088251269 , 1.06329388473032 , 1.12413978556924 , &
         1.14924238495048 , 1.14246305195681 , 1.09639686339545 , &
         0.975041752373722 , 0.782578171036883 , 0.56651010525637 , &
         0.30600226121939 , -0.0361750144811776 , -0.342701536283546 , &
         -0.779225759370871 , -1.11106749258069 , -1.20716155977844 ] 
    real, parameter :: previous_cvdrift(grid_size) = [ &
         -1.29626021760933 , -1.13802849989306 , -0.913577669182128 , &
         -0.629614033177262 , -0.416323336577055 , -0.155428799539355 , &
         0.0693482838337908 , 0.258219174656909 , 0.349446605094527 , &
         0.344625283637301 , 0.326336035338745 , 0.320658404210892 , &
         0.337422988043997 , 0.387114577049452 , 0.494712267885322 , &
         0.663110083750464 , 0.770112138072069 , 0.878926021664994 , &
         1.03793877375137 , 1.13871698215241 , 1.19738453210071 , &
         1.22033728871456 , 1.21122144741783 , 1.16199802694285 , &
         1.03568778563527 , 0.837579451792781 , 0.616624908416168 , &
         0.351555327492623 , 0.00509087063060037 , -0.303960353286136 , &
         -0.742415251132626 , -1.07478885422174 , -1.17093200997432 ] 
    real, parameter :: previous_gds2(grid_size) = [ &
         9.95826670726143 , 9.10988520281037 , 8.1812084791778 , &
         7.35798267146448 , 6.69849671738242 , 5.50952332809903 , &
         4.23833466121629 , 3.03613192674247 , 1.92732277361199 , &
         1.22427267152132 , 0.85998620104471 , 0.649796185682891 , &
         0.528974471427739 , 0.482634999599694 , 0.533734505850971 , &
         0.756873317718338 , 1.00873314166442 , 1.33362558717305 , &
         1.91896239735854 , 2.4717261338051 , 2.93557549300508 , &
         3.30577032400869 , 3.61251567204091 , 3.85741677826495 , &
         3.94955333727688 , 3.8378748387185 , 3.79255842997973 , &
         4.11501636486512 , 5.12791808193097 , 6.39307164290032 , &
         8.57153329728752 , 10.3825011098032 , 10.9209001886057 ] 
    real, parameter :: previous_gds21(grid_size) = [ &
         1.86286292894779 , 1.70779898732936 , 1.5407085980472 , &
         1.36959867163635 , 1.1924632000522 , 0.84728063889947 , &
         0.488789239039743 , 0.173939850582263 , -0.151154110178759 , &
         -0.413180908627265 , -0.495072036197634 , -0.441994089504594 , &
         -0.306937935985994 , -0.126123787569995 , 0.0271633660220536 , &
         -0.0554712546415856 , -0.220606329252638 , -0.449686953285259 , &
         -0.92939240544825 , -1.35979377716508 , -1.70813426774287 , &
         -1.98405171155839 , -2.21277493074252 , -2.39559846753779 , &
         -2.4452996716201 , -2.23900947275725 , -1.91674058823388 , &
         -1.622084869483 , -1.47485074145661 , -1.50505640192924 , &
         -1.70638867061648 , -1.93964477305629 , -2.01607080588923 ] 
    real, parameter :: previous_theta(grid_size) = [ &
         -3.14159265358979 , -3.01069295969022 , -2.81434341884086 , &
         -2.55254403104171 , -2.35745693226546 , -2.12182938216258 , &
         -1.92413941474038 , -1.73634131051826 , -1.51092689030096 , &
         -1.24526972838728 , -0.98174770424681 , -0.719948316447661 , &
         -0.458148928648511 , -0.196349540849362 , 0.0654498469497874 , &
         0.327249234748937 , 0.47197356555882 , 0.600493528375452 , &
         0.760504225052732 , 0.868382642268042 , 0.95406205918831 , &
         1.03451089886336 , 1.12348995983655 , 1.24354709204596 , &
         1.43989663289532 , 1.70169602069447 , 1.96349540849362 , &
         2.22529479629277 , 2.48709418409192 , 2.67280432895371 , &
         2.9063077603848 , 3.08766802498129 , 3.14159265358979 ] 
    real, dimension(grid_size) :: new_bmag, new_grho, new_gbdrift, new_cvdrift, new_gds2, new_gds21

    call init_mp(this%getMpiCommunicator())
    if (proc0) then
      ! This is very fragile! Assumes executable is called from top-level directory
      ! FIXME: initialise relevant modules with parameters directly
      call init_file_utils(dummy, .true., .true., .false., 'tests/pfunit_tests/asym_geo_global/local')
    end if
    call init_theta_grid

    new_bmag = interpolate(bmag, previous_theta, theta)
    new_grho = interpolate(grho, previous_theta, theta)
    new_gbdrift = interpolate(gbdrift, previous_theta, theta)
    new_cvdrift = interpolate(cvdrift, previous_theta, theta)
    new_gds2 = interpolate(gds2, previous_theta, theta)
    new_gds21 = interpolate(gds21, previous_theta, theta)

    if (proc0) call finish_file_utils
    call finish_theta_grid

    ! Need to explicitly call finish_theta_grid_params here because
    ! finish_theta_grid _doesn't_ call it because "this is now handled
    ! separately by gs2_init"
    call finish_theta_grid_params

    @assertEqual(new_bmag, previous_Bmag, tolerance=1.e-5, message="Bmag")
    @assertEqual(new_grho, previous_grho, tolerance=1.e-5, message="grho")
    @assertEqual(new_gbdrift, previous_gbdrift, tolerance=1.e-5, message="gbdrift")
    @assertEqual(new_cvdrift, previous_cvdrift, tolerance=1.e-5, message="cvdrift")
    @assertEqual(new_gds2, previous_gds2, tolerance=1.e-5, message="gds2")
    @assertEqual(new_gds21, previous_gds21, tolerance=1.e-5, message="gds21")

  end subroutine test_asym_geo_global

  !> Interpolate `var` from `new_theta` onto `old_theta`
  function interpolate(var, old_theta, new_theta)
    use splines, only : new_spline, splint, delete_spline, spline_type => spline
    real, dimension(grid_size), intent(in) :: var       !! The variable to spline
    real, dimension(grid_size), intent(in) :: old_theta !! The old theta grid
    real, dimension(grid_size), intent(in) :: new_theta !! The new theta grid
    real, dimension(grid_size) :: interpolate
    type(spline_type) :: spline
    integer :: i

    call new_spline(size(var), new_theta, var, spline)
    do i = 1, grid_size
      interpolate(i) = splint(old_theta(i), spline)
    end do
    call delete_spline(spline)
  end function interpolate

end module test_asym_geo_global_mod
