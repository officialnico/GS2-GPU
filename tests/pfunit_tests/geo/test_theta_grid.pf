         1.363764931146012, 1.294024409890287, 1.175775239501614, &
         1.036428374438951, 0.914053444179172, 0.818318453483020, &
         0.748724954761854, 0.716671788659014, 0.708757617469964, &
         0.717525946800493, 0.730224184879474, 0.745803410106093, &
         0.758905575168064, 0.769869618791196, 0.776087340043265 &
         ]
    real, parameter :: expected_gbdrift(grid_size) = [&
         -0.744600100381585, -0.701162866140241, -0.652259030239126, &
         -0.593441748558407, -0.534043635682425, -0.464528170809520, &
         -0.398872771904059, -0.315547956419445, -0.226458087770206, &
