    real, parameter :: expected_gds21(grid_size) = [&
         0.210788959110906, 0.204529464768334, 0.195110177921644, &
         0.180451563128312, 0.162041381764405, 0.136085866605405, &
         0.107493445405158, 0.065919223615346, 0.015471695283797, &
         -0.033002504810271, -0.085410432595921, -0.126863998042421, &
         -0.153553647165946, -0.159236110526696, -0.131637693396761, &
         -0.085446997486163, -0.029705661831761, 0.029846734551736, &
         0.085121081630317, 0.130494661920779, 0.160212024786882, &
         0.155702880343105, 0.124103373050254, 0.084251556683578, &
         0.033809647622596, -0.015189833488877, -0.066036523867599, &
         -0.107354898291219, -0.135984314560151, -0.161931533924051, &
         -0.180363768535810, -0.195023238052560, -0.204429420520659 &
         ]
    real, parameter :: expected_theta(grid_size) = [&
         -3.102294138481744, -2.915579967275093, -2.718658162245269, &
         -2.501270829885215, -2.302531543721245, -2.092180315795131, &
         -1.910145961564067, -1.695389685410694, -1.477454399647678, &
         -1.287775770994235, -1.084148727403374, -0.900885900295638, &
         -0.723052899788444, -0.533321898532876, -0.351410519240360, &
         -0.204978221025205, -0.068494652621225, 0.068846564089713, &
         0.205126922030324, 0.351120937103689, 0.532758867032720, &
         0.723039191300589, 0.901174164696676, 1.084315546580843, &
         1.287826840522917, 1.477456107606730, 1.695410353158795, &
         1.910153528352599, 2.092182036588957, 2.302530341475169, &
         2.501262674394712, 2.718641394191132, 2.915559514708378 &
         ]

    theta_grid_eik_config  = theta_grid_eik_config_type( &
         itor = 1, &
         iflux = 1, &
         irho = 2, &
         bishop = 1, &
         delrho = 0.001, &
         isym = 0, &
         local_eq = .false., &
         chs_eq = .true., &
         equal_arc = .true., &
         eqfile = "tests/common_geometry_files/ogyropsi.dat" &
         )
    call theta_grid_eik_config%setup("eik_knobs", requires_index=.false.)
    call set_theta_grid_eik_config(theta_grid_eik_config)

    call init_theta_grid

    ! Full theta grid is 201 points, which would make golden answers
    ! above very large, so just check a subarray
    @assertEqual(expected_theta, theta(-99:98:6), tolerance=tolerance, message="theta")
    @assertEqual(expected_bmag, bmag(-99:98:6), tolerance=tolerance, message="Bmag")
    @assertEqual(expected_grho, grho(-99:98:6), tolerance=tolerance, message="grho")
    @assertEqual(expected_gbdrift, gbdrift(-99:98:6), tolerance=tolerance, message="gbdrift")
    @assertEqual(expected_cvdrift, cvdrift(-99:98:6), tolerance=tolerance, message="cvdrift")
    @assertEqual(expected_gds2, gds2(-99:98:6), tolerance=tolerance, message="gds2")
    @assertEqual(expected_gds21, gds21(-99:98:6), tolerance=tolerance, message="gds21")
  end subroutine test_chease_eikcoefs

  @test(npes=[1])
  subroutine test_efit_eikcoefs(this)
    use theta_grid, only: bmag, grho, gbdrift, cvdrift, gds2, gds21, theta, init_theta_grid
    use theta_grid_eik, only : theta_grid_eik_config_type, set_theta_grid_eik_config

    class(MPITestMethod), intent(inout) :: this

    type(theta_grid_eik_config_type) :: theta_grid_eik_config

    real, parameter :: expected_bmag(grid_size) = [&
         0.984146810395845, 0.982565913854418, 0.980541731040016,&
         0.977477585796006, 0.973298930861496, 0.967887549616058,&
         0.960766850114192, 0.952111775297661, 0.941893408422968,&
         0.930323995610678, 0.912058158162682, 0.900402575088758,&
         0.881047342245647, 0.868008239651067, 0.860498160467290,&
         0.856277659856758, 0.853808868000034, 0.856277659856758,&
         0.860498160467290, 0.868008239651067, 0.881047342245647,&
         0.900402575088758, 0.912058158162682, 0.930323995610678,&
         0.941893408422968, 0.952111775297661, 0.960766850114192,&
         0.967887549616058, 0.973298930861496, 0.977477585796006,&
         0.980541731040016, 0.982565913854418, 0.984146810395845&
         ]
    real, parameter :: expected_grho(grid_size) = [&
         0.775095151119486, 0.771249480564796, 0.766221699183801,&
         0.758956784042327, 0.749909146444885, 0.739482282830879,&
         0.727696261301195, 0.716113697246759, 0.708965798589323,&
         0.715123261717907, 0.765972147590596, 0.831394367539609,&
         1.007676704044314, 1.176528044524683, 1.296344492034425,&
         1.367865960019302, 1.408769716148418, 1.367481607390986,&
         1.299058882953481, 1.178411030597240, 1.004489549469596,&
         0.831293823721511, 0.765606724889767, 0.715294029997905,&
