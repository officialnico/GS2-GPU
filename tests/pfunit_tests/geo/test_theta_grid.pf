    @assertEqual(cvdrift, expected_cvdrift, tolerance=tolerance, message="cvdrift")
    @assertEqual(cvdrift0, expected_cvdrift0, tolerance=tolerance, message="cvdrift0")
    @assertEqual(cvdrift_th, expected_cvdrift_th, tolerance=tolerance, message="cvdrift_th")
    @assertEqual(gds2, expected_gds2, tolerance=tolerance, message="gds2")
    @assertEqual(gds21, expected_gds21, tolerance=tolerance, message="gds21")
    @assertEqual(gds22, expected_gds22, tolerance=tolerance, message="gds22")
    @assertEqual(gds23, expected_gds23, tolerance=tolerance, message="gds23")
    @assertEqual(gds24, expected_gds24, tolerance=tolerance, message="gds24")
    @assertEqual(gds24_noq, expected_gds24_noq, tolerance=tolerance, message="gds24_noq")
    @assertEqual(jacob, expected_jacob, tolerance=tolerance, message="jacob")
    @assertEqual(rplot, expected_rplot, tolerance=tolerance, message="rplot")
    @assertEqual(zplot, expected_zplot, tolerance=tolerance, message="zplot")
    @assertEqual(aplot, expected_aplot, tolerance=tolerance, message="aplot")
    @assertEqual(rprime, expected_rprime, tolerance=tolerance, message="rprime")
    @assertEqual(zprime, expected_zprime, tolerance=tolerance, message="zprime")
    @assertEqual(aprime, expected_aprime, tolerance=tolerance, message="aprime")
    @assertEqual(bpol, expected_bpol, tolerance=tolerance, message="bpol")

  end subroutine test_miller_run_eikcoefs_and_resample

  !> Call to dump the current values from theta grid in a vaguely useful format.
  !> Helpful when we need to update the golden results as we've fixed a bug/changed
  !> behaviour etc.
  subroutine helper_to_update_results(name, raw_format_in)
    use theta_grid, only: bmag, grho, gbdrift, cvdrift, gds2, gds21, gds22, gds23
    use theta_grid, only: gds24, gds24_noq, jacob, rplot, zplot, aplot
    use theta_grid, only: rprime, zprime, aprime, bpol, gbdrift0, cvdrift0, theta
    use theta_grid, only: cdrift, cdrift0, cvdrift_th, gbdrift_th, gradpar
    implicit none
    character(len=*), intent(in) :: name
    logical, intent(in), optional :: raw_format_in
    logical :: raw_format
    integer :: lun
    open(file=name,newunit=lun)

    raw_format = .false.
    if (present(raw_format_in)) raw_format = raw_format_in

    call write_data( lun, "theta", theta, raw_format)
    call write_data( lun, "bmag", bmag, raw_format)    
    call write_data( lun, "grho", grho, raw_format)
    call write_data( lun, "gradpar", gradpar, raw_format)    
    call write_data( lun, "gbdrift", gbdrift, raw_format)        
    call write_data( lun, "gbdrift0", gbdrift0, raw_format)
    call write_data( lun, "gbdrift_th", gbdrift_th, raw_format)    
    call write_data( lun, "cvdrift", cvdrift, raw_format)    
    call write_data( lun, "cvdrift0", cvdrift0, raw_format)    
    call write_data( lun, "cvdrift_th", cvdrift_th, raw_format)
    call write_data( lun, "cdrift", cdrift, raw_format)
    call write_data( lun, "cdrift0", cdrift0, raw_format)        
    call write_data( lun, "gds2", gds2, raw_format)
    call write_data( lun, "gds21", gds21, raw_format)
    call write_data( lun, "gds22", gds22, raw_format)
    call write_data( lun, "gds23", gds23, raw_format)
    call write_data( lun, "gds24", gds24, raw_format)
    call write_data( lun, "gds24_noq", gds24_noq, raw_format)
    call write_data( lun, "jacob", jacob, raw_format)
    call write_data( lun, "rplot", rplot, raw_format)
    call write_data( lun, "zplot", zplot, raw_format)
    call write_data( lun, "aplot", aplot, raw_format)
    call write_data( lun, "rprime", rprime, raw_format)
    call write_data( lun, "zprime", zprime, raw_format)
    call write_data( lun, "aprime", aprime, raw_format)
    call write_data( lun, "bpol", bpol, raw_format)

    close(lun)

  contains
    subroutine write_data(unit, name, data, raw_format)
      implicit none
      integer, intent(in) :: unit
      character(len=*), intent(in) :: name
      real, dimension(:), intent(in) :: data
      logical, intent(in) :: raw_format

      if (raw_format) then
         write(unit, '(33(F25.15," "))') data
      else
         write(unit, '("real, parameter :: expected_",A,"(grid_size) = [ &")') name
         write(unit, '(10(" ", 3(F25.15, ", "), "&", /), " ", 2(F25.15, ", "), F25.15, "  &")') data
         write(unit, '("]")')
      end if

    end subroutine write_data
    
  end subroutine helper_to_update_results

