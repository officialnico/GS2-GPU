    theta_grid_eik_config  = theta_grid_eik_config_type( &
         itor = 1, &
         iflux = 1, &
         irho = 2, &
         bishop = 1, &
         delrho = 0.001, &
         isym = 0, &
         local_eq = .false., &
         efit_eq = .true., &
         equal_arc = .true., &
         eqfile = "tests/pfunit_tests/geo/EQDSK", &
         beta_prime_input = -7.3746392639128452E-002, &
         s_hat_input = 0.26742081952674540 &
         )
    call theta_grid_eik_config%setup("eik_knobs", requires_index=.false.)
    call set_theta_grid_eik_config(theta_grid_eik_config)

    call init_theta_grid

    @assertEqual(expected_theta, theta, tolerance=tolerance, message="theta")
    @assertEqual(expected_bmag, bmag, tolerance=tolerance, message="Bmag")
    @assertEqual(expected_grho, grho, tolerance=tolerance, message="grho")
    @assertEqual(expected_gbdrift, gbdrift, tolerance=tolerance, message="gbdrift")
    @assertEqual(expected_cvdrift, cvdrift, tolerance=tolerance, message="cvdrift")
    @assertEqual(expected_gds2, gds2, tolerance=tolerance, message="gds2")
    @assertEqual(expected_gds21, gds21, tolerance=tolerance, message="gds21")
  end subroutine test_efit_eikcoefs

end module test_theta_grid_mod
