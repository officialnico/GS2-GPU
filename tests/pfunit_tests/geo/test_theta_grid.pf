         0.877708835527272, 0.888886046442935, 0.901201899812074, &
         0.915076377400515, 0.927585340919578, 0.940909915448688, &
         0.952547276426520, 0.961065591850085, 0.969256717116923, &
         0.975324478978899, 0.980091133028256, 0.982723754410017 &
         ]
    real, parameter :: expected_grho(grid_size) = [&
         0.778517421275135, 0.776082814024202, 0.769859238425600, &
         0.758890623190320, 0.745780905805309, 0.730221933217436, &
         0.717525158981500, 0.708653341991982, 0.716688317046549, &
         0.748471029311490, 0.818456834185620, 0.915816538961469, &
         1.035172345298820, 1.174376690941389, 1.294739027732931, &
