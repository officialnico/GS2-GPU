         -0.151352258125505, -0.169330198130759, -0.185460874109636, &
         -0.199986955006287, -0.212584647183001, -0.223719396038409 &
         ]
    real, parameter :: expected_theta(grid_size) = [ &
         -3.14159265358979, -2.96909691483081, -2.79753624140583, &
         -2.62691063331481, -2.45995122460437, -2.29564390653795, &
         -2.13398867911553, -1.97902030603011, -1.82790760022706, &
         -1.54168052849789, -1.27627882252284, -1.03444601532502, &
         -0.809104557779855, -0.596535696876655, -0.393953292215471, &
         -0.19590929198706, -4.44089209850063e-16, 0.195909291987062, &
         0.393953292215472, 0.596535696876654, 0.809104557779858, &
         1.03444601532502, 1.27627882252284, 1.54168052849789, 1.82790760022705, &
         1.97902030603012, 2.13398867911553, 2.29564390653794, 2.45995122460437, &
         2.62691063331481, 2.79753624140584, 2.96909691483083, 3.14159265358979 &
         ]

    theta_grid_eik_config  = theta_grid_eik_config_type( &
         itor = 1, &
         iflux = 0, &
         irho = 2, &
         bishop = 4, &
         delrho = 0.001, &
         isym = 0, &
         local_eq = .true., &
         beta_prime_input = -7.3746392639128452E-002, &
         s_hat_input = 0.26742081952674540 &
         )
    call theta_grid_eik_config%setup("eik_knobs", requires_index=.false.)
    call set_theta_grid_eik_config(theta_grid_eik_config)

    call init_theta_grid

    @assertEqual(theta, expected_theta, tolerance=tolerance, message="theta")
    @assertEqual(bmag, expected_bmag, tolerance=tolerance, message="Bmag")
    @assertEqual(grho, expected_grho, tolerance=tolerance, message="grho")
    @assertEqual(gbdrift, expected_gbdrift, tolerance=tolerance, message="gbdrift")
    @assertEqual(cvdrift, expected_cvdrift, tolerance=tolerance, message="cvdrift")
    @assertEqual(gds2, expected_gds2, tolerance=tolerance, message="gds2")
    @assertEqual(gds21, expected_gds21, tolerance=tolerance, message="gds21")

  end subroutine test_miller_eikcoefs

  @test(npes=[1])
  subroutine test_chease_eikcoefs(this)
    use theta_grid, only: bmag, grho, gbdrift, cvdrift, gds2, gds21, theta, init_theta_grid
    use theta_grid_eik, only : theta_grid_eik_config_type, set_theta_grid_eik_config

    class(MPITestMethod), intent(inout) :: this
    type(theta_grid_eik_config_type) :: theta_grid_eik_config

    real, parameter :: expected_bmag(grid_size) = [&
         0.983743493637289, 0.982723754410017, 0.980091133028256, &
         0.975324478978899, 0.969256717116923, 0.961065591850085, &
         0.952547276426520, 0.940909915448688, 0.927585340919578, &
         0.915076377400515, 0.901201899812074, 0.888886046442935, &
         0.877708835527272, 0.867387931905505, 0.859794387540793, &
         0.855719991475865, 0.853785983588843, 0.853785983588843, &
         0.855719991475865, 0.859794387540793, 0.867387931905505, &
         0.877708835527272, 0.888886046442935, 0.901201899812074, &
         0.915076377400515, 0.927585340919578, 0.940909915448688, &
         0.952547276426520, 0.961065591850085, 0.969256717116923, &
         0.975324478978899, 0.980091133028256, 0.982723754410017 &
         ]
    real, parameter :: expected_grho(grid_size) = [&
         0.778517421275135, 0.776082814024202, 0.769859238425600, &
         0.758890623190320, 0.745780905805309, 0.730221933217436, &
         0.717525158981500, 0.708653341991982, 0.716688317046549, &
         0.748471029311490, 0.818456834185620, 0.915816538961469, &
         1.035172345298820, 1.174376690941389, 1.294739027732931, &
         1.364301457274078, 1.397652080255647, 1.397466541735304, &
         1.363764931146012, 1.294024409890287, 1.175775239501614, &
         1.036428374438951, 0.914053444179172, 0.818318453483020, &
         0.748724954761854, 0.716671788659014, 0.708757617469964, &
         0.717525946800493, 0.730224184879474, 0.745803410106093, &
         0.758905575168064, 0.769869618791196, 0.776087340043265 &
         ]
    real, parameter :: expected_gbdrift(grid_size) = [&
         -0.744600100381585, -0.701162866140241, -0.652259030239126, &
         -0.593441748558407, -0.534043635682425, -0.464528170809520, &
         -0.398872771904059, -0.315547956419445, -0.226458087770206, &
         -0.147267146433854, -0.062774862204447, 0.011332232793617, &
         0.079673845824623, 0.145591805913023, 0.196250565568162, &
         0.225251053364682, 0.239326935055635, 0.239397968910343, &
         0.225349355259961, 0.196607135748755, 0.144788987074709, &
         0.079533668856790, 0.014032218124622, -0.062408167048576, &
         -0.148278144297698, -0.226777493032501, -0.315551817667223, &
         -0.399055665728140, -0.464648643292417, -0.534126960921667, &
         -0.593526991104660, -0.652321926925138, -0.701191221011883 &
         ]
    real, parameter :: expected_cvdrift(grid_size) = [&
         -0.670704571141075, -0.627115004335447, -0.577816247924848, &
         -0.518279612425184, -0.457950790325134, -0.387140105317267, &
