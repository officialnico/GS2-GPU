         -0.589736714506848, -0.631588446606287, -0.673036466796932 &
         ]
    real, parameter :: expected_gds2(grid_size) = [ &
         2.29008065199946, 2.22942331101754, 2.17329759898412, &
         2.12243750433447, 2.07575083944781, 2.03066732241664, &
         1.98427619082273, 1.93382433897332, 1.87440433662686, &
         1.71594328315711, 1.49687624300548, 1.25252362054053, &
         1.0182051580772, 0.795171227114309, 0.590999602469358, &
         0.440107537273544, 0.383997407012626, 0.440107537273546, &
