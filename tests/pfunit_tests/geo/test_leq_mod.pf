  @test
  subroutine test_global_Rpos_elongation()
    use constants, only : pi
    use leq, only : leq_testing_type, Rpos
    type(leq_testing_type) :: leq_privates

    real, parameter :: major_radius = 10.0
    real, parameter :: minor_radius = 1.0

    integer, parameter :: ntheta = 128
    real, dimension(ntheta) :: R_answer, R_answer_interpolated

    real, parameter :: elongation = 2.0
    real, parameter :: triangularity = 1.0

    integer :: i
    real, dimension(ntheta), parameter :: theta = [(real(i)*2*pi/real(ntheta-1), i=0,ntheta-1)]
    real, dimension(ntheta), parameter :: R_expected = minor_radius * cos(theta) + major_radius
    real, dimension(ntheta), parameter :: Z_expected = minor_radius * sin(theta) * elongation
    real, dimension(ntheta), parameter :: theta_ellipse = &
         modulo(atan2(Z_expected, (R_expected - major_radius)), 2*pi)

    call leq_privates%set_surf(geoType=1, &
       Rmaj=major_radius, Rgeo=major_radius, &
       r=minor_radius, dr=0.1, aSurf=minor_radius, &
       sHorz=0.0, sVert=0.0, &
       delm=elongation, deln=triangularity, &
       delmp=0.0, delnp=0.0, &
       thm=0.0, thn=0.0, &
       q=0.0, shat=0.0, nt=16, &
       mMode=0, nMode=0, &
       thetaShift_in = 0., beta_0_in = 0. &
       )

    R_answer = [ (Rpos(minor_radius, theta(i)), i=1, ntheta) ]
    R_answer_interpolated = interpolate(R_answer, theta_ellipse, theta)

    @assertEqual(R_expected, R_answer_interpolated, tolerance=1.e-4)

  end subroutine test_global_Rpos_elongation

