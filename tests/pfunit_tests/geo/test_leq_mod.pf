module test_leq_mod
  use leq, only: leq_type
  use constants, only : pi
  use geo_utils, only: flux_surface_type
  use PFUNIT_MOD
  implicit none

  real, parameter :: derivative_tolerance = 5.e-3
  real, parameter :: value_tolerance = 5.e-12

  type(leq_type) :: geom
contains

  !> Interpolate `var` from `new_theta` onto `old_theta`
  function interpolate(var, old_theta, new_theta)
    use splines, only : new_spline, splint, delete_spline, spline_type => spline
    real, dimension(:), intent(in) :: var       !! The variable to spline
    real, dimension(:), intent(in) :: old_theta !! The old theta grid
    real, dimension(:), intent(in) :: new_theta !! The new theta grid
    real, dimension(ubound(var, 1)) :: interpolate
    type(spline_type) :: spline
    integer :: i

    spline = new_spline(new_theta, var)
    do i = 1, ubound(var, 1)
      interpolate(i) = splint(old_theta(i), spline)
    end do
    call delete_spline(spline)
  end function interpolate

  @test
  subroutine test_diameter()
    use constants, only : twopi
    @assertEqual(0.0, geom%diameter(0.0), tolerance=value_tolerance)
    @assertEqual(2.0, geom%diameter(1.0), tolerance=value_tolerance)
    @assertEqual(twopi, geom%diameter(pi), tolerance=value_tolerance)
  end subroutine test_diameter

  @test
  subroutine test_eqitem()
    use constants, only: twopi
    integer, parameter :: nradius = 3
    integer, parameter :: ntheta_half = 4, ntheta = 2 * ntheta_half + 1
    integer, parameter :: total_size(2) = [nradius, ntheta]
    real, dimension(nradius, ntheta) :: array
    real, parameter :: theta_zero = 0.0
    real, parameter :: expected_zero = theta_zero
    real, parameter :: theta_inside = 1.3
    real, parameter :: expected_inside = theta_inside
    real, parameter :: theta_inside_negative = -2.6
    real, parameter :: expected_inside_negative = theta_inside_negative
    real, parameter :: theta_outside = 1.3 + pi
    real, parameter :: expected_outside = modulo(theta_outside + pi, twopi) - pi
    real, parameter :: theta_outside_negative = -(2.6 + pi)
    real, parameter :: expected_outside_negative = modulo(theta_outside_negative + pi, twopi) - pi
    real :: actual
    integer :: i
    real, dimension(ntheta), parameter :: theta = [(real(i - 1)*twopi/real(ntheta-1) - pi, i=1,ntheta)]
    geom%nr = nradius ; geom%nt = ntheta
    call geom%alloc_arrays()
    geom%has_full_theta_range = .true.
    do i = 1, nradius
       geom%eqth(i, :) = theta
       array(i, :) = theta
    end do

    actual = geom%eqitem(1.0, theta_zero, array, 'A')
    @assertEqual(expected_zero, actual, tolerance=value_tolerance)

    actual = geom%eqitem(1.0, theta_inside, array, 'A')
    @assertEqual(expected_inside, actual, tolerance=value_tolerance)

    actual = geom%eqitem(1.0, theta_inside_negative, array, 'A')
    @assertEqual(expected_inside_negative, actual, tolerance=value_tolerance)

    actual = geom%eqitem(1.0, theta_outside, array, 'A')
    @assertEqual(expected_outside, actual, tolerance=value_tolerance)

    actual = geom%eqitem(1.0, theta_outside_negative, array, 'A')
    @assertEqual(expected_outside_negative, actual, tolerance=value_tolerance)
    call geom%dealloc_arrays()
  end subroutine test_eqitem

  @test
  subroutine test_gradient()
    use constants, only: twopi
    integer, parameter :: nradius = 3
    integer, parameter :: ntheta_half = 4, ntheta = 2 * ntheta_half + 1
    real, dimension(nradius, ntheta, 2) :: dpcart
    integer :: i
    real, dimension(ntheta), parameter :: theta = [(real(i - 1)*twopi/real(ntheta-1) - pi, i=1,ntheta)], radius = 1.0
    real, dimension(ntheta, 2) :: expected, grad_result

    dpcart(:,:,1) = 4.
    dpcart(:,:,2) = 8.

    expected = dpcart(2,:,:)

    geom%nr = nradius ; geom%nt = ntheta
    call geom%alloc_arrays()
    geom%has_full_theta_range = .true.
    do i = 1, nradius
       geom%eqth(i, :) = theta
    end do
    geom%dpcart = dpcart
    ! Note only need to test 'P' as other values for char don't make
    ! sense for leq
    call geom%gradient(radius, theta, grad_result, 'P', -1., ntheta_half, ntheta_half, .false.)
    @assertEqual(expected, grad_result, tolerance=value_tolerance)
    call geom%dealloc_arrays()
  end subroutine test_gradient

  @test
  subroutine test_bgradient()
    use constants, only: twopi
    integer, parameter :: nradius = 3
    integer, parameter :: ntheta_half = 4, ntheta = 2 * ntheta_half + 1
    real, dimension(nradius, ntheta, 2) :: dpbish, dtbish, dbtbish
    integer :: i
    real, dimension(ntheta), parameter :: theta = [(real(i - 1)*twopi/real(ntheta-1) - pi, i=1,ntheta)], radius = 1.0
    real, dimension(ntheta, 2) :: expected_P, expected_T
    real, dimension(ntheta, 2) :: grad_P_result, grad_T_result

    dpbish(:,:,1) = 4.
    dpbish(:,:,2) = 8.
    dtbish(:,:,1) = 16.
    dtbish(:,:,2) = 32.

    expected_T = dtbish(2,:,:)
    expected_P = dpbish(2,:,:)
    geom%nr = nradius ; geom%nt = ntheta
    call geom%alloc_arrays()
    geom%has_full_theta_range = .true.
    do i = 1, nradius
       geom%eqth(i, :) = theta
    end do
    geom%dpbish = dpbish ; geom%dtbish = dtbish

    ! Note only need to test 'P' and 'T' as other values for char
    ! don't make sense for leq
    call geom%gradient(radius, theta, grad_P_result, 'P', -1., ntheta_half, ntheta_half, .true.)
    call geom%gradient(radius, theta, grad_T_result, 'T', -1., ntheta_half, ntheta_half, .true.)

    @assertEqual(expected_P, grad_P_result, tolerance=value_tolerance)
    @assertEqual(expected_T, grad_T_result, tolerance=value_tolerance)
    call geom%dealloc_arrays()
  end subroutine test_bgradient

  @test
  subroutine test_generalised_Miller_Rpos_circle()
    real, parameter :: major_radius = 0.0
    real, parameter :: minor_radius = 1.0
    integer, parameter :: ntheta = 32
    real, dimension(ntheta) :: R_answer
    integer :: i
    real, dimension(ntheta), parameter :: theta = [(real(i)*2*pi/real(ntheta-1), i=0,ntheta-1)]
    real, dimension(ntheta), parameter :: R_expected = minor_radius * cos(theta) + major_radius

    geom%surf = flux_surface_type(geoType=0, &
       Rmaj=major_radius, R_geo=major_radius, &
       r=minor_radius, dr=0.1, aSurf=minor_radius, &
       sHorz=0.0, sVert=0.0, &
       delm=1.0, deln=0.0, &
       delmp=0.0, delnp=0.0, &
       thm=0.0, thn=0.0, &
       q=0.0, shat=0.0, nt=16, &
       mMode=0, nMode=0 &
       )
    geom%thetaShift = 0.
    R_answer = [ (geom%Rpos(minor_radius, theta(i)), i=1, ntheta) ]
    @assertEqual(R_expected, R_answer, tolerance=1.e-12)
  end subroutine test_generalised_Miller_Rpos_circle

