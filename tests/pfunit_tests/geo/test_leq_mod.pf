  @test
  subroutine test_generalised_Miller_Rpos_triangularity_rotate_pi()
    use constants, only : pi
    use leq, only : leq_testing_type, Rpos
    type(leq_testing_type) :: leq_privates

    real, parameter :: major_radius = 0.0
    real, parameter :: minor_radius = 1.0

    integer, parameter :: ntheta = 32
    real, dimension(ntheta) :: R_answer

    real, parameter :: elongation = 1.0
    real, parameter :: triangularity = 1.0
    real, parameter :: triangularity_rotation = pi

    integer :: i
    real, dimension(ntheta), parameter :: theta = [(real(i)*2*pi/real(ntheta-1), i=0,ntheta-1)]
    real, dimension(ntheta), parameter :: R_expected = minor_radius &
         * cos(theta + triangularity*sin(theta) - triangularity_rotation) &
         + major_radius

    call leq_privates%set_surf(geoType=0, &
       Rmaj=major_radius, Rgeo=major_radius, &
       r=minor_radius, dr=0.1, aSurf=minor_radius, &
       sHorz=0.0, sVert=0.0, &
       delm=elongation, deln=triangularity, &
       delmp=0.0, delnp=0.0, &
       thm=0.0, thn=triangularity_rotation, &
       q=0.0, shat=0.0, nt=16, &
       mMode=0, nMode=0, &
       thetaShift_in = 0., beta_0_in = 0. &
       )

    R_answer = [ (Rpos(minor_radius, theta(i)), i=1, ntheta) ]

    @assertEqual(R_expected, R_answer, tolerance=1.e-12)

  end subroutine test_generalised_Miller_Rpos_triangularity_rotate_pi

