  @test
  subroutine test_generalised_Miller_Rpos_triangularity_and_elongation()
    use constants, only : pi
    use leq, only : leq_testing_type, Rpos
    type(leq_testing_type) :: leq_privates

    real, parameter :: major_radius = 0.0
    real, parameter :: minor_radius = 1.0

    integer, parameter :: ntheta = 32
    real, dimension(ntheta) :: R_answer

    real, parameter :: elongation = 2.0
    real, parameter :: triangularity = 1.0

    integer :: i
    real, dimension(ntheta), parameter :: theta = [(real(i)*2*pi/real(ntheta-1), i=0,ntheta-1)]
    real, dimension(ntheta), parameter :: R_expected = minor_radius * cos(theta + triangularity*sin(theta)) &
         + major_radius

    call leq_privates%set_surf(geoType=0, &
