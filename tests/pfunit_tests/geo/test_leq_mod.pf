    real, dimension(ntheta), parameter :: Z_expected = minor_radius * sin(theta)

    call leq_privates%set_surf(geoType=0, &
       Rmaj=major_radius, Rgeo=major_radius, &
       r=minor_radius, dr=0.1, aSurf=minor_radius, &
       sHorz=0.0, sVert=0.0, &
       delm=1.0, deln=0.0, &
       delmp=0.0, delnp=0.0, &
       thm=0.0, thn=0.0, &
       q=0.0, shat=0.0, nt=16, &
       mMode=0, nMode=0, &
       thetaShift_in = 0., beta_0_in = 0. &
       )

    Z_answer = [ (Zpos(minor_radius, theta(i)), i=1, ntheta) ]

    @assertEqual(Z_expected, Z_answer, tolerance=1.e-12)

  end subroutine test_generalised_Miller_Zpos_circle

