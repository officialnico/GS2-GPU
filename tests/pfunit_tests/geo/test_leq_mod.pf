  ! As the generalised elongation just applies two separate modes
  ! indepdently, swapping the m and n parameters should be identical
  @test
  subroutine test_generalised_enlongation_two_modes_are_symmetric()
    use constants, only : pi
    use leq, only : leq_testing_type, Rpos, Zpos
    type(leq_testing_type) :: leq_privates

    real, parameter :: major_radius = 10.0
    real, parameter :: minor_radius = 1.0
    !> The radius at which to evaluate the equilibrium
    real, parameter :: minor_radius_evaluation = minor_radius + 0.5

    integer :: i
    integer, parameter :: ntheta = 32
    real, dimension(ntheta), parameter :: theta = [(real(i)*2*pi/real(ntheta-1), i=0,ntheta-1)]

    real, dimension(ntheta) :: R_first, R_second, Z_first, Z_second

    real, parameter :: m_value = 2.0
    real, parameter :: n_value = 3.0
    real, parameter :: m_rotation = 1.5
    real, parameter :: n_rotation = -0.7
    integer, parameter :: m_mode = 2
    integer, parameter :: n_mode = 3
    real, parameter :: m_derivative = 0.1
    real, parameter :: n_derivative = -0.2

    call leq_privates%set_surf(geoType=2, &
       Rmaj=major_radius, Rgeo=major_radius, &
       r=minor_radius, dr=0.1, aSurf=minor_radius, &
       sHorz=0.0, sVert=0.0, &
       delm=m_value, deln=n_value, &
       delmp=m_derivative, delnp=n_derivative, &
       thm=m_rotation, thn=n_rotation, &
       q=0.0, shat=0.0, nt=16, &
       mMode=m_mode, nMode=n_mode, &
       thetaShift_in = 0., beta_0_in = 0. &
       )

    R_first = [ (Rpos(minor_radius_evaluation, theta(i)), i=1, ntheta) ]
    Z_first = [ (Zpos(minor_radius_evaluation, theta(i)), i=1, ntheta) ]

    call leq_privates%set_surf(geoType=2, &
       Rmaj=major_radius, Rgeo=major_radius, &
       r=minor_radius, dr=0.1, aSurf=minor_radius, &
       sHorz=0.0, sVert=0.0, &
       delm=n_value, deln=m_value, &
       delmp=n_derivative, delnp=m_derivative, &
       thm=n_rotation, thn=m_rotation, &
       q=0.0, shat=0.0, nt=16, &
       mMode=n_mode, nMode=m_mode, &
       thetaShift_in = 0., beta_0_in = 0. &
       )

    R_second = [ (Rpos(minor_radius_evaluation, theta(i)), i=1, ntheta) ]
    Z_second = [ (Zpos(minor_radius_evaluation, theta(i)), i=1, ntheta) ]

    @assertEqual(R_first, R_second, tolerance=value_tolerance)
    @assertEqual(Z_first, Z_second, tolerance=value_tolerance)

  end subroutine test_generalised_enlongation_two_modes_are_symmetric

  ! As the Fourier version just applies two separate modes
  ! indepdently, swapping the m and n parameters should be identical
  @test
  subroutine test_fourier_two_modes_are_symmetric()
    use constants, only : pi
    use leq, only : leq_testing_type, Rpos, Zpos
    type(leq_testing_type) :: leq_privates

    real, parameter :: major_radius = 10.0
    real, parameter :: minor_radius = 1.0
    !> The radius at which to evaluate the equilibrium
    real, parameter :: minor_radius_evaluation = minor_radius + 0.5

    integer :: i
    integer, parameter :: ntheta = 32
    real, dimension(ntheta), parameter :: theta = [(real(i)*2*pi/real(ntheta-1), i=0,ntheta-1)]

    real, dimension(ntheta) :: R_first, R_second, Z_first, Z_second

    real, parameter :: m_value = 2.0
    real, parameter :: n_value = 3.0
    real, parameter :: m_rotation = 1.5
    real, parameter :: n_rotation = -0.7
    integer, parameter :: m_mode = 2
    integer, parameter :: n_mode = 3
    real, parameter :: m_derivative = 0.1
    real, parameter :: n_derivative = -0.2

    call leq_privates%set_surf(geoType=3, &
       Rmaj=major_radius, Rgeo=major_radius, &
       r=minor_radius, dr=0.1, aSurf=minor_radius, &
       sHorz=0.0, sVert=0.0, &
       delm=m_value, deln=n_value, &
       delmp=m_derivative, delnp=n_derivative, &
       thm=m_rotation, thn=n_rotation, &
       q=0.0, shat=0.0, nt=16, &
       mMode=m_mode, nMode=n_mode, &
       thetaShift_in = 0., beta_0_in = 0. &
       )

    R_first = [ (Rpos(minor_radius_evaluation, theta(i)), i=1, ntheta) ]
    Z_first = [ (Zpos(minor_radius_evaluation, theta(i)), i=1, ntheta) ]

    call leq_privates%set_surf(geoType=3, &
       Rmaj=major_radius, Rgeo=major_radius, &
       r=minor_radius, dr=0.1, aSurf=minor_radius, &
       sHorz=0.0, sVert=0.0, &
       delm=n_value, deln=m_value, &
       delmp=n_derivative, delnp=m_derivative, &
       thm=n_rotation, thn=m_rotation, &
       q=0.0, shat=0.0, nt=16, &
       mMode=n_mode, nMode=m_mode, &
       thetaShift_in = 0., beta_0_in = 0. &
       )

    R_second = [ (Rpos(minor_radius_evaluation, theta(i)), i=1, ntheta) ]
    Z_second = [ (Zpos(minor_radius_evaluation, theta(i)), i=1, ntheta) ]

    @assertEqual(R_first, R_second, tolerance=1.e-12)
    @assertEqual(Z_first, Z_second, tolerance=1.e-12)

  end subroutine test_fourier_two_modes_are_symmetric

  @test
  subroutine test_generalised_Miller_invR_circle()
    use constants, only : pi
    use leq, only : leq_testing_type, invR
    type(leq_testing_type) :: leq_privates

    real, parameter :: major_radius = 2.0
    real, parameter :: minor_radius = 1.0

    integer, parameter :: ntheta = 32
    real, dimension(ntheta) :: R_answer

    integer :: i
    real, dimension(ntheta), parameter :: theta = [(real(i)*2*pi/real(ntheta-1), i=0,ntheta-1)]
    real, dimension(ntheta), parameter :: R_expected = minor_radius * cos(theta) + major_radius

    call leq_privates%set_surf(geoType=0, &
       Rmaj=major_radius, Rgeo=major_radius, &
       r=minor_radius, dr=0.1, aSurf=minor_radius, &
       sHorz=0.0, sVert=0.0, &
       delm=1.0, deln=0.0, &
       delmp=0.0, delnp=0.0, &
       thm=0.0, thn=0.0, &
       q=0.0, shat=0.0, nt=16, &
       mMode=0, nMode=0, &
       thetaShift_in = 0., beta_0_in = 0. &
       )

    R_answer = [ (invR(minor_radius, theta(i)), i=1, ntheta) ]

    @assertEqual(1./R_expected, R_answer, tolerance=1.e-12)

  end subroutine test_generalised_Miller_invR_circle

  @test
  subroutine test_global_invR_circle()
    use constants, only : pi
    use leq, only : leq_testing_type, invR
    type(leq_testing_type) :: leq_privates

    real, parameter :: major_radius = 10.0
    real, parameter :: minor_radius = 1.0

    integer, parameter :: ntheta = 32
    real, dimension(ntheta) :: R_answer

    integer :: i
    real, dimension(ntheta), parameter :: theta = [(real(i)*2*pi/real(ntheta-1), i=0,ntheta-1)]
    real, dimension(ntheta), parameter :: R_expected = minor_radius * cos(theta) + major_radius

    call leq_privates%set_surf(geoType=1, &
       Rmaj=major_radius, Rgeo=major_radius, &
       r=minor_radius, dr=0.1, aSurf=minor_radius, &
       sHorz=0.0, sVert=0.0, &
       delm=1.0, deln=1.0, &
       delmp=0.0, delnp=0.0, &
       thm=0.0, thn=0.0, &
       q=0.0, shat=0.0, nt=16, &
       mMode=0, nMode=0, &
       thetaShift_in = 0., beta_0_in = 0. &
       )

    R_answer = [ (invR(minor_radius, theta(i)), i=1, ntheta) ]

    @assertEqual(1./R_expected, R_answer, tolerance=1.e-12)

  end subroutine test_global_invR_circle

end module test_leq_mod
