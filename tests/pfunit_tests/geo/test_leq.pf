module test_leq_mod
  use PFUNIT_MOD
  implicit none

  real, parameter :: derivative_tolerance = 5.e-3

contains

  @test
  subroutine test_mod2pi()
    use constants, only : pi
    use leq, only : leq_testing_type
    type(leq_testing_type) :: leq_privates

    @assertEqual(0.0, leq_privates%mod2pi(0.0))
    @assertEqual(1.0, leq_privates%mod2pi(1.0))
    @assertEqual(-1.0, leq_privates%mod2pi(-1.0))
    @assertEqual(pi, leq_privates%mod2pi(pi))
    @assertEqual(-pi, leq_privates%mod2pi(-pi))
    @assertEqual(0.0, leq_privates%mod2pi(2. * pi))
    @assertEqual(0.0, leq_privates%mod2pi(-2. * pi))
    @assertEqual(pi / 2., leq_privates%mod2pi(2. * pi + (pi/2.)))
    @assertEqual(-pi / 2., leq_privates%mod2pi(pi + (pi/2.)))
  end subroutine test_mod2pi

  @test
  subroutine test_diameter()
    use constants, only : pi
    use leq, only : diameter

    @assertEqual(0.0, diameter(0.0))
    @assertEqual(2.0, diameter(1.0))
    @assertEqual(2.0 * pi, diameter(pi))
  end subroutine test_diameter

  @test
  subroutine test_derm_even_function()
    use constants, only : pi
    use leq, only : leq_testing_type
    type(leq_testing_type) :: leq_privates

    integer, parameter :: nradius = 3
    integer, parameter :: ntheta = 128
    integer, parameter :: total_ntheta = 2*ntheta + 1
    integer, parameter :: total_size(2) = [nradius, total_ntheta]
    real, parameter :: theta_grid_spacing = 2 * pi / (total_ntheta - 1)
    real, dimension(nradius, -ntheta:ntheta) :: f_input
    real, dimension(nradius, -ntheta:ntheta, 2) :: df_result
    real, dimension(nradius, -ntheta:ntheta, 2) :: df_expected

    integer :: i, j

    call leq_privates%set_ntnr(ntheta, nradius)

    f_input = reshape([([(i*i*cos(j * theta_grid_spacing), &
         i=0, nradius-1)], j=-ntheta, ntheta)], total_size)

    df_expected(:, :, 1) = reshape( &
         [([0., 2., 4.]*cos(j * theta_grid_spacing), &
         j=-ntheta, ntheta)], total_size)
    df_expected(:, :, 2) = reshape( &
         [([(-i*i*sin(j * theta_grid_spacing) * theta_grid_spacing, &
         i=0, nradius-1)], j=-ntheta, ntheta)], total_size)

    call leq_privates%derm(f_input, df_result, 'E')

    @assertEqual(df_expected(:,:,1), df_result(:,:,1), tolerance=derivative_tolerance, message="Radial derivative")
    @assertEqual(df_expected(:,:,2), df_result(:,:,2), tolerance=derivative_tolerance, message="Theta derivative")
  end subroutine test_derm_even_function

  @test
  subroutine test_derm_odd_function()
    use constants, only : pi
    use leq, only : leq_testing_type
    type(leq_testing_type) :: leq_privates

    integer, parameter :: nradius = 3
    integer, parameter :: ntheta = 128
    integer, parameter :: total_ntheta = 2*ntheta + 1
    integer, parameter :: total_size(2) = [nradius, total_ntheta]
    real, parameter :: theta_grid_spacing = 2 * pi / (total_ntheta - 1)
    real, dimension(nradius, -ntheta:ntheta) :: f_input
    real, dimension(nradius, -ntheta:ntheta, 2) :: df_result
    real, dimension(nradius, -ntheta:ntheta, 2) :: df_expected

    integer :: i, j

    call leq_privates%set_ntnr(ntheta, nradius)

    f_input = reshape([([(i*i * sin(j * theta_grid_spacing), &
         i=0, nradius-1)], j=-ntheta, ntheta)], total_size)

    df_expected(:, :, 1) = reshape( &
         [([0., 2., 4.] * sin(j * theta_grid_spacing), &
         j=-ntheta, ntheta)], total_size)
    df_expected(:, :, 2) = reshape( &
         [([(i*i*cos(j * theta_grid_spacing) * theta_grid_spacing, &
         i=0, nradius-1)], j=-ntheta, ntheta)], total_size)

    call leq_privates%derm(f_input, df_result, 'O')

    @assertEqual(df_expected(:, :, 1), df_result(:, :, 1), tolerance=derivative_tolerance, message="Radial derivative")
    @assertEqual(df_expected(:, :, 2), df_result(:, :, 2), tolerance=derivative_tolerance, message="Theta derivative")
  end subroutine test_derm_odd_function

  @test
  subroutine test_derm_T()
    use constants, only : pi
    use leq, only : leq_testing_type
    type(leq_testing_type) :: leq_privates

    integer, parameter :: nradius = 3
    integer, parameter :: ntheta = 4
    integer, parameter :: total_ntheta = 2*ntheta + 1
    integer, parameter :: total_size(2) = [nradius, total_ntheta]
    real, parameter :: theta_grid_spacing = 2 * pi / (total_ntheta - 1)
    real, dimension(nradius, -ntheta:ntheta) :: f_input
    real, dimension(nradius, -ntheta:ntheta, 2) :: df_result
    real, dimension(nradius, -ntheta:ntheta, 2) :: df_expected

    integer :: i, j

    call leq_privates%set_ntnr(ntheta, nradius)

    f_input = reshape([([(j*theta_grid_spacing, i=1, nradius)], j=-ntheta, ntheta)], total_size)

    df_expected(:, :, 1) = 0.
    df_expected(:, :, 2) = theta_grid_spacing

    call leq_privates%derm(f_input, df_result, 'T')

    @assertEqual(df_expected(:, :, 1), df_result(:, :, 1), tolerance=1.e-14)
    @assertEqual(df_expected(:, :, 2), df_result(:, :, 2), tolerance=1.e-14)

  end subroutine test_derm_T

  ! This basically converts derivatives of R, Z from polar coordinates
  ! to cylindrical coordinates. R, Z are for a circle with radius 1
  @test
  subroutine test_eqdcart()
    use constants, only : pi
    use leq, only : leq_testing_type
    type(leq_testing_type) :: leq_privates

    integer, parameter :: nradius = 3
    integer, parameter :: ntheta = 4
    integer, parameter :: total_ntheta = 2*ntheta + 1
    integer, parameter :: total_size(2) = [nradius, total_ntheta]
    real, parameter :: theta_grid_spacing = 2 * pi / (total_ntheta - 1)
    real, dimension(nradius, -ntheta:ntheta, 2) :: drm, dzm
    real, dimension(nradius, -ntheta:ntheta, 2) :: R_cylindrical, Z_cylindrical
    real, dimension(nradius, -ntheta:ntheta, 2) :: R_cylindrical_expected, Z_cylindrical_expected

    integer :: i, j

    ! Index-space derivatives of R
    drm(:, :, 1) = reshape( &
         [([(cos(j * theta_grid_spacing), &
         i=1, nradius)], j=-ntheta, ntheta)], total_size)
    drm(:, :, 2) = reshape( &
         [([(-sin(j * theta_grid_spacing) * theta_grid_spacing, &
         i=1, nradius)], j=-ntheta, ntheta)], total_size)

    ! Index-space derivatives of Z
    dzm(:, :, 1) = reshape( &
         [([(sin(j * theta_grid_spacing), &
         i=1, nradius)], j=-ntheta, ntheta)], total_size)
    dzm(:, :, 2) = reshape( &
         [([(cos(j * theta_grid_spacing) * theta_grid_spacing, &
         i=1, nradius)], j=-ntheta, ntheta)], total_size)

    call leq_privates%set_ntnr(ntheta, nradius)
    call leq_privates%alloc_arrays(nradius, ntheta)
    call leq_privates%set_drm(drm)
    call leq_privates%set_dzm(dzm)

    call leq_privates%eqdcart(drm, R_cylindrical)
    call leq_privates%eqdcart(dzm, Z_cylindrical)

    call leq_privates%dealloc_arrays()

    R_cylindrical_expected(:,:,1) = 1.
    R_cylindrical_expected(:,:,2) = 0.
    Z_cylindrical_expected(:,:,1) = 0.
    Z_cylindrical_expected(:,:,2) = 1.

    ! why is the output only divided by the denominator on the r-range 2,nr?
    @assertEqual(R_cylindrical_expected(2:,:,1), R_cylindrical(2:,:,1), tolerance=1.e-8)
    @assertEqual(R_cylindrical_expected(2:,:,2), R_cylindrical(2:,:,2), tolerance=1.e-8)
    @assertEqual(Z_cylindrical_expected(2:,:,1), Z_cylindrical(2:,:,1), tolerance=1.e-8)
    @assertEqual(Z_cylindrical_expected(2:,:,2), Z_cylindrical(2:,:,2), tolerance=1.e-8)

  end subroutine test_eqdcart

  ! This basically converts derivatives of R, Z from cylindrical
  ! coordinates to Bishop coordinates. R, Z are for a circle with
  ! radius 1
  @test
  subroutine test_eqdbish()
    use leq, only : leq_testing_type
    type(leq_testing_type) :: leq_privates

    integer, parameter :: nradius = 3
    integer, parameter :: ntheta = 4

    real, dimension(nradius, -ntheta:ntheta, 2) :: dpcart
    real, dimension(nradius, -ntheta:ntheta, 2) :: R_cylindrical, Z_cylindrical
    real, dimension(nradius, -ntheta:ntheta, 2) :: R_cylindrical_in, Z_cylindrical_in
    real, dimension(nradius, -ntheta:ntheta, 2) :: R_cylindrical_expected, Z_cylindrical_expected

    call leq_privates%set_ntnr(ntheta, nradius)
    call leq_privates%alloc_arrays(nradius, ntheta)

    dpcart(:,:,1) = 1.
    dpcart(:,:,2) = 0.

    R_cylindrical_in(:,:,1) = 1.
    R_cylindrical_in(:,:,2) = 0.
    Z_cylindrical_in(:,:,1) = 0.
    Z_cylindrical_in(:,:,2) = 1.

    R_cylindrical_expected(:,:,1) = 1.
    R_cylindrical_expected(:,:,2) = 0.
    Z_cylindrical_expected(:,:,1) = 0.
    Z_cylindrical_expected(:,:,2) = 1.

    call leq_privates%set_dpcart(dpcart)

    call leq_privates%eqdbish(R_cylindrical_in, R_cylindrical)
    call leq_privates%eqdbish(Z_cylindrical_in, Z_cylindrical)

    call leq_privates%dealloc_arrays()

    ! why is the output only divided by the denominator on the r-range 2,nr?
    @assertEqual(R_cylindrical_expected(2:,:,1), R_cylindrical(2:,:,1), tolerance=1.e-8)
    @assertEqual(R_cylindrical_expected(2:,:,2), R_cylindrical(2:,:,2), tolerance=1.e-8)
    @assertEqual(Z_cylindrical_expected(2:,:,1), Z_cylindrical(2:,:,1), tolerance=1.e-8)
    @assertEqual(Z_cylindrical_expected(2:,:,2), Z_cylindrical(2:,:,2), tolerance=1.e-8)

  end subroutine test_eqdbish

  @test
  subroutine test_eqitem()
    use constants, only : pi
    use leq, only : leq_testing_type, eqitem
    type(leq_testing_type) :: leq_privates

    integer, parameter :: nradius = 3
    integer, parameter :: ntheta = 4
    integer, parameter :: total_ntheta = 2*ntheta + 1
    integer, parameter :: total_size(2) = [nradius, total_ntheta]

    real, dimension(nradius, -ntheta:ntheta) :: array

    real, parameter :: theta_zero = 0.0
    real, parameter :: expected_zero = theta_zero
    real, parameter :: theta_inside = 1.3
    real, parameter :: expected_inside = theta_inside
    real, parameter :: theta_inside_negative = -2.6
    real, parameter :: expected_inside_negative = theta_inside_negative
    real, parameter :: theta_outside = 1.3 + pi
    real, parameter :: expected_outside = modulo(theta_outside + pi, 2.*pi) - pi
    real, parameter :: theta_outside_negative = -(2.6 + pi)
    real, parameter :: expected_outside_negative = modulo(theta_outside_negative + pi, 2.*pi) - pi

    real :: actual

    integer :: i, j

    call leq_privates%set_ntnr(ntheta, nradius)

    ! NOTE: actual theta grid used in leq includes one extra point
    ! outside [-pi, pi]!
    array = reshape([([(real(j) * pi / real(ntheta - 1), &
         i=1, nradius)], j=-ntheta, ntheta)], total_size)

    call eqitem(theta_zero, array, actual, 'A')
    @assertEqual(expected_zero, actual, tolerance=1.e-8)

    call eqitem(theta_inside, array, actual, 'A')
    @assertEqual(expected_inside, actual, tolerance=1.e-8)

    call eqitem(theta_inside_negative, array, actual, 'A')
    @assertEqual(expected_inside_negative, actual, tolerance=1.e-8)

    call eqitem(theta_outside, array, actual, 'A')
    @assertEqual(expected_outside, actual, tolerance=1.e-8)

    call eqitem(theta_outside_negative, array, actual, 'A')
    @assertEqual(expected_outside_negative, actual, tolerance=1.e-8)

    call leq_privates%dealloc_arrays()

  end subroutine test_eqitem

  @test
  subroutine test_gradient()
    use constants, only : pi
    use leq, only : leq_testing_type, gradient
    type(leq_testing_type) :: leq_privates

    integer, parameter :: nradius = 3
    integer, parameter :: ntheta = 4

    real, dimension(nradius, -ntheta:ntheta, 2) :: dpcart
    integer :: i
    real, dimension(-ntheta:ntheta), parameter :: theta = [(real(i)*pi/real(ntheta-1), i=-ntheta,ntheta)]
    real, dimension(-ntheta:ntheta, 2) :: expected, grad_result

    call leq_privates%set_ntnr(ntheta, nradius)
    call leq_privates%alloc_arrays(nradius, ntheta)

    dpcart(:,:,1) = 4.
    dpcart(:,:,2) = 8.

    expected = dpcart(2,:,:)

    call leq_privates%set_dpcart(dpcart)

    ! Note only need to test 'P' as other values for char don't make
    ! sense for leq
    call gradient(theta, grad_result, 'P', -1., ntheta, ntheta)

    call leq_privates%dealloc_arrays()

    @assertEqual(expected, grad_result, tolerance=1.e-8)

  end subroutine test_gradient

  @test
  subroutine test_bgradient()
    use constants, only : pi
    use leq, only : leq_testing_type, bgradient
    type(leq_testing_type) :: leq_privates

    integer, parameter :: nradius = 3
    integer, parameter :: ntheta = 4

    real, dimension(nradius, -ntheta:ntheta, 2) :: dpbish, dtbish, dbtbish
    integer :: i
    real, dimension(-ntheta:ntheta), parameter :: theta = [(real(i)*pi/real(ntheta-1), i=-ntheta,ntheta)]
    real, dimension(-ntheta:ntheta, 2) :: expected_P, expected_T
    real, dimension(-ntheta:ntheta, 2) :: grad_P_result, grad_T_result

    call leq_privates%set_ntnr(ntheta, nradius)
    call leq_privates%alloc_arrays(nradius, ntheta)

    dpbish(:,:,1) = 4.
    dpbish(:,:,2) = 8.
    dtbish(:,:,1) = 16.
    dtbish(:,:,2) = 32.
    dbtbish = 0.

    expected_T = dtbish(2,:,:)
    expected_P = dpbish(2,:,:)

    call leq_privates%set_bish_arrays(dpbish, dbtbish, dtbish)

    ! Note only need to test 'P' and 'T' as other values for char
    ! don't make sense for leq
    call bgradient(theta, grad_P_result, 'P', -1., ntheta, ntheta)
    call bgradient(theta, grad_T_result, 'T', -1., ntheta, ntheta)

    call leq_privates%dealloc_arrays()

    @assertEqual(expected_P, grad_P_result, tolerance=1.e-8)
    @assertEqual(expected_T, grad_T_result, tolerance=1.e-8)

  end subroutine test_bgradient

  @test
  subroutine test_generalised_Miller_Rpos_circle()
    use constants, only : pi
    use leq, only : leq_testing_type, Rpos, Zpos
    type(leq_testing_type) :: leq_privates

    real, parameter :: major_radius = 0.0
    real, parameter :: minor_radius = 1.0

    integer, parameter :: ntheta = 32
    real, dimension(ntheta) :: R_answer

    integer :: i
    real, dimension(ntheta), parameter :: theta = [(real(i)*2*pi/real(ntheta-1), i=0,ntheta-1)]
    real, dimension(ntheta), parameter :: R_expected = minor_radius * cos(theta) + major_radius
    real, dimension(ntheta), parameter :: Z_expected = minor_radius * sin(theta)

    call leq_privates%set_surf(geoType=0, &
       Rmaj=major_radius, &
       Rgeo=major_radius, &
       r=minor_radius, &
       dr=0.1, &
       aSurf=minor_radius, &
       sHorz=0.0, &
       sVert=0.0, &
       delm=1.0, &
       deln=0.0, &
       delmp=0.0, &
       delnp=0.0, &
       thm=0.0, &
       thn=0.0, &
       q=0.0, &
       shat=0.0, &
       nt=16, &
       mMode=0, &
       nMode=0)

    R_answer = [ (Rpos(minor_radius, theta(i)), i=1, ntheta) ]

    @assertEqual(R_expected, R_answer, tolerance=1.e-12)

  end subroutine test_generalised_Miller_Rpos_circle

