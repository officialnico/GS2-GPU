  @test
  subroutine test_generalised_Miller_Rpos_elongation_rotate_half_pi()
    use constants, only : pi
    use leq, only : leq_testing_type, Rpos, Zpos
    type(leq_testing_type) :: leq_privates

    real, parameter :: major_radius = 0.0
    real, parameter :: minor_radius = 1.0

    integer, parameter :: ntheta = 32
    real, dimension(ntheta) :: R_answer

    real, parameter :: elongation = 2.0
    real, parameter :: triangularity = 0.0
    real, parameter :: elongation_rotation = pi / 2.

    integer :: i
    real, dimension(ntheta), parameter :: theta = [(real(i)*2*pi/real(ntheta-1), i=0,ntheta-1)]
    real, dimension(ntheta), parameter :: R_expected = minor_radius * cos(theta + triangularity*sin(theta)) &
         * elongation &
         + major_radius
    real, dimension(ntheta), parameter :: Z_expected = minor_radius * sin(theta)

    call leq_privates%set_surf(geoType=0, &
       Rmaj=major_radius, &
       Rgeo=major_radius, &
       r=minor_radius, &
       dr=0.1, &
       aSurf=minor_radius, &
       sHorz=0.0, &
       sVert=0.0, &
       delm=elongation, &
       deln=triangularity, &
       delmp=0.0, &
       delnp=0.0, &
       thm=elongation_rotation, &
       thn=0.0, &
       q=0.0, &
       shat=0.0, &
       nt=16, &
       mMode=0, &
       nMode=0)

    R_answer = [ (Rpos(minor_radius, theta(i)), i=1, ntheta) ]

    @assertEqual(R_expected, R_answer, tolerance=1.e-12)

  end subroutine test_generalised_Miller_Rpos_elongation_rotate_half_pi

