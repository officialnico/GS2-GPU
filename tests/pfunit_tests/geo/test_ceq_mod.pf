!            0., 0., 0., &
!            0., 2., 1., &
!            0., 0., 0.], shape=[npsi_test, ntheta_test])
!     dbtcart_expected(:, :, 1) = reshape([&
!            0.,  0.53333,  0.40000,&
!            0.,  0.00000,  0.09524,&
!            0., -0.34286, -0.11429,&
!            0., -0.00000,  0.09524,&
!            0.,  0.53333,  0.40000], shape=[npsi_test, ntheta_test])
!     dbtcart_expected(:, :, 2) = reshape([&
