module test_ceq_mod
  use ceq, only: ceq_type
  use constants, only: twopi, pi
  use PFUNIT_MOD
  implicit none

  real, parameter :: derivative_tolerance = 5.e-3
  real, parameter :: value_tolerance = 5.e-12
  real, parameter :: spline_tolerance = 5.e-2

  integer, parameter :: npsi_test = 3
  integer, parameter :: nchi_test = 4
  integer, parameter :: ntheta_test = nchi_test + 1

  integer :: i
  real, dimension(ntheta_test), parameter :: theta = [(real(i - 1)*twopi/real(ntheta_test-1) - pi, i=1,ntheta_test)], psi = 2.5

  type(ceq_type) :: geom
contains

  subroutine setup
    use ceq, only: chease_chi_index
    integer :: i, j
    real, dimension(:, :), allocatable :: r_chease, z_chease
    real, parameter :: theta_grid_spacing = 2 * pi / nchi_test
    real :: R_geo, f_N, psi_N
    geom%nr = npsi_test ; geom%nt = ntheta_test
    call geom%alloc_arrays()
    geom%has_full_theta_range = .true.
    do i = 1, npsi_test
       geom%eqth(i, :) = theta
    end do
    geom%eqpsi = [1, 2, 3]
    geom%psi_bar = (geom%eqpsi - geom%eqpsi(1)) / (geom%eqpsi(npsi_test) - geom%eqpsi(1))
    geom%pressure = [3., 6., 9.]
    geom%beta = geom%pressure ; geom%beta_0 = geom%beta(1)
    geom%pressure = geom%pressure / geom%pressure(1)
    geom%fp = [0.5, 0., -0.5] ; geom%qsf = [4, 9, 16]
    geom%psi_0 = geom%eqpsi(1) ; geom%psi_a = geom%eqpsi(npsi_test)
    allocate(r_chease(npsi_test, nchi_test))
    allocate(z_chease(npsi_test, nchi_test))
    r_chease = reshape([([(i*i*cos(j * theta_grid_spacing) + 10, &
                       i=0, npsi_test-1)], j=0, nchi_test-1)], &
                        shape=shape(r_chease))
    z_chease = reshape([([(i*i*sin(j * theta_grid_spacing) - 1e-3, &
                       i=0, npsi_test-1)], j=0, nchi_test-1)], &
                            shape=shape(z_chease))

    do j = 1, geom%nt
      do i = 1, geom%nr
        geom%R_psi(i, j) = r_chease(i, chease_chi_index(nchi_test, j))
      end do
    end do

    do j = 1, geom%nt
      do i = 1, geom%nr
        geom%Z_psi(i,j) = z_chease(i, chease_chi_index(nchi_test, j))
      end do
    end do
    R_geo = (geom%R_psi(geom%nr, geom%nt/2+1) + geom%R_psi(geom%nr, 1))/2.
    geom%aminor = (geom%R_psi(geom%nr, geom%nt/2+1) - geom%R_psi(geom%nr, 1))/2.
    geom%B_T = geom%fp(geom%nr)/R_geo
    geom%R_psi = geom%R_psi / geom%aminor
    geom%Z_psi = geom%Z_psi / geom%aminor

    psi_N = abs(geom%B_T) * geom%aminor**2
    geom%psi_a = geom%psi_a / psi_N
    geom%psi_0 = geom%psi_0 / psi_N
    geom%eqpsi = geom%eqpsi / psi_N
    f_N = abs(geom%B_T) * geom%aminor
    geom%fp = geom%fp / f_N

    geom%diam = abs(geom%R_psi(:, geom%nt/2 + 1) - geom%R_psi(:, 1))
    geom%rc = 0.5*(geom%R_psi(:, 1) + geom%R_psi(:, geom%nt/2 + 1))
    do j = 1, geom%nt
       geom%eqpsi_2d(:, j) = geom%eqpsi
    end do
    call geom%setup_splines
  end subroutine setup

  subroutine teardown
    call geom%dealloc_arrays
  end subroutine teardown

  @test
  subroutine test_chease_chi_index
    use ceq, only : chease_chi_index
    integer, parameter :: nchi = 8
    @assertEqual(5, chease_chi_index(nchi, 1))
    @assertEqual(6, chease_chi_index(nchi, 2))
    @assertEqual(7, chease_chi_index(nchi, 3))
    @assertEqual(8, chease_chi_index(nchi, 4))
    @assertEqual(1, chease_chi_index(nchi, 5))
    @assertEqual(2, chease_chi_index(nchi, 6))
    @assertEqual(3, chease_chi_index(nchi, 7))
    @assertEqual(4, chease_chi_index(nchi, 8))
    @assertEqual(5, chease_chi_index(nchi, 9))
  end subroutine test_chease_chi_index

  ! Currently only checks interpolation in theta
  ! Also, how to check failures? Robust runner?
  @test
  subroutine test_eqitem()
    integer, parameter :: nradius = npsi_test, ntheta = ntheta_test
    integer, parameter :: total_size(2) = [nradius, ntheta]
    real, dimension(nradius, ntheta) :: array
    real, parameter :: theta_zero = 0.0
    real, parameter :: expected_zero = theta_zero
    real, parameter :: theta_inside = 1.3
    real, parameter :: expected_inside = theta_inside
    real, parameter :: theta_inside_negative = -2.6
    real, parameter :: expected_inside_negative = theta_inside_negative
    real, parameter :: theta_outside = 1.3 + pi
    real, parameter :: expected_outside = modulo(theta_outside + pi, 2.*pi) - pi
    real, parameter :: theta_outside_negative = -(2.6 + pi)
    real, parameter :: expected_outside_negative = modulo(theta_outside_negative + pi, 2.*pi) - pi
    real, parameter :: psi = 2.5
    real :: actual
    integer :: i, j
    call setup

    array = geom%eqth
    actual = geom%eqitem(psi, theta_zero, array, '?')
    @assertEqual(expected_zero, actual, tolerance=value_tolerance)

    actual = geom%eqitem(psi, theta_inside, array, '?')
    @assertEqual(expected_inside, actual, tolerance=value_tolerance)

    actual = geom%eqitem(psi, theta_inside_negative, array, '?')
    @assertEqual(expected_inside_negative, actual, tolerance=value_tolerance)

    actual = geom%eqitem(psi, theta_outside, array, '?')
    @assertEqual(expected_outside, actual, tolerance=value_tolerance)

    actual = geom%eqitem(psi, theta_outside_negative, array, '?')
    @assertEqual(expected_outside_negative, actual, tolerance=value_tolerance)
    call teardown
  end subroutine test_eqitem

  @test
  subroutine test_ceq_init
    real, dimension(npsi_test, ntheta_test, 2) :: dpcart
    real, dimension(npsi_test, ntheta_test, 2) :: dtcart
    real, dimension(npsi_test, ntheta_test, 2) :: dpcart_expected
    real, dimension(npsi_test, ntheta_test, 2) :: dtcart_expected
    dpcart_expected(:, :, 1) = reshape([&
           0., -2., -1.,&
           0., 0., 0., &
           0., 2., 1., &
           0., 0., 0., &
           0., -2., -1.], shape=[npsi_test, ntheta_test])
    dpcart_expected(:, :, 2) = reshape([&
           0., 0., 0.,&
           0., -2., -1., &
           0., 0., 0., &
           0., 2., 1., &
           0., 0., 0.], shape=[npsi_test, ntheta_test])
    dtcart_expected(:, :, 1) = reshape([&
           0.,  0.00000, -0.00000,&
           0.,  6.28319,  1.57080,&
           0.,  0.00000,  0.00000,&
           0., -6.28319, -1.57080,&
           0., -0.00000, -0.00000], shape=[npsi_test, ntheta_test])
    dtcart_expected(:, :, 2) = reshape([&
           0., -6.28319, -1.57080,&
           0.,  0.00000,  0.00000,&
           0.,  6.28319,  1.57080,&
           0.,  0.00000,  0.00000,&
           0., -6.28319, -1.57080], shape=[npsi_test, ntheta_test])
    call setup
    call geom%finish_setup
    ! Scale dpcart_expected to account for eqpsi normalisation
    dpcart_expected = dpcart_expected / (abs(geom%B_T) * geom%aminor**2)
    @assertEqual(dpcart_expected(2:, :, :), geom%dpcart(2:, :, :), tolerance=derivative_tolerance, message="dpcart")
    @assertEqual(dtcart_expected(2:, :, :), geom%dtcart(2:, :, :), tolerance=derivative_tolerance, message="dtcart")
    call teardown
  end subroutine test_ceq_init

  @test
  subroutine test_gradient()
    integer, parameter :: nradius = npsi_test, ntheta = ntheta_test
    integer, parameter :: ntheta_half = (ntheta -1 )/ 2
    real, dimension(npsi_test, ntheta_test, 2) :: dpcart, dtcart
    real, dimension(ntheta, 2) :: expected, grad_result

    dpcart(:, :, 1) = reshape([&
           0., -2., -1.,&
           0., 0., 0., &
           0., 2., 1., &
           0., 0., 0., &
           0., -2., -1.], shape=[npsi_test, ntheta_test])
    dpcart(:, :, 2) = reshape([&
           0., 0., 0.,&
           0., -2., -1., &
           0., 0., 0., &
           0., 2., 1., &
           0., 0., 0.], shape=[npsi_test, ntheta_test])
    dtcart = 0.

    call setup
    geom%dpcart = dpcart ; geom%dtcart = dtcart
    expected(:, 1) = [-2., 0., 2., 0., -2.]
    expected(:, 2) = [0., -2., 0., 2., 0.]
    call geom%gradient(psi, theta, grad_result, 'P', 0.5, ntheta_half, ntheta_half, .false.)
    @assertEqual(expected, grad_result, tolerance=value_tolerance)

    expected(:, 1) = [-3., 0., 3., 0., -3.]
    expected(:, 2) = [0., -3., 0., 3., 0.]
    expected = expected * abs(geom%B_T) * geom%aminor**2 ! Scale by psi_N
    call geom%gradient(psi, theta, grad_result, 'R', 0.5, ntheta_half, ntheta_half, .false.)
    ! 'R' is derivative of pressure, and involves a separate
    ! interpolation, hence reduced tolerance
    @assertEqual(expected, grad_result, tolerance=derivative_tolerance)
    call teardown
  end subroutine test_gradient
  @test
  subroutine test_bgradient()
    integer, parameter :: nradius = npsi_test, ntheta = ntheta_test
    integer, parameter :: ntheta_half = (ntheta -1 )/ 2
    real, dimension(npsi_test, ntheta_test, 2) :: dpbish, dbtbish, dtbish
    integer :: i
    real, dimension(ntheta, 2) :: expected, grad_result
    dpbish(:, :, 1) = reshape([&
           0., -2., -1.,&
           0., 0., 0., &
           0., 2., 1., &
           0., 0., 0., &
           0., -2., -1.], shape=[npsi_test, ntheta_test])
    dpbish(:, :, 2) = reshape([&
           0., 0., 0.,&
           0., -2., -1., &
           0., 0., 0., &
           0., 2., 1., &
           0., 0., 0.], shape=[npsi_test, ntheta_test])
    dtbish = 0.

    call setup
    geom%dpbish = dpbish ; geom%dtbish = dtbish
    expected(:, 1) = [-2., 0., 2., 0., -2.]
    expected(:, 2) = [0., -2., 0., 2., 0.]
    call geom%gradient(psi, theta, grad_result, 'P', 0.5, ntheta_half, ntheta_half, .true.)
    @assertEqual(expected, grad_result, tolerance=value_tolerance)

    expected(:, 1) = [-3., 0., 3., 0., -3.]
    expected(:, 2) = [0., -3., 0., 3., 0.]
    expected = expected * abs(geom%B_T) * geom%aminor**2 ! Scale by psi_N
    call geom%gradient(psi, theta, grad_result, 'R', 0.5, ntheta_half, ntheta_half, .true.)
    ! 'R' is derivative of pressure, and involves a separate
    ! interpolation, hence reduced tolerance
    @assertEqual(expected, grad_result, tolerance=derivative_tolerance)
    call teardown
  end subroutine test_bgradient

  @test
  subroutine test_invR
    call setup
    @assertEqual(geom%aminor/11.0, geom%invR(geom%eqpsi(2), 0.), tolerance=value_tolerance)
    @assertEqual(geom%aminor/9.0, geom%invR(geom%eqpsi(2), pi), tolerance=value_tolerance)
    call teardown
  end subroutine test_invR

  @test
  subroutine test_Rpos
    call setup
    @assertEqual(11.0/geom%aminor, geom%Rpos(geom%eqpsi(2), 0.), tolerance=value_tolerance)
    @assertEqual(9.0/geom%aminor, geom%Rpos(geom%eqpsi(2), pi), tolerance=value_tolerance)
    @assertEqual(11.0/geom%aminor, geom%Rpos(geom%eqpsi(2), twopi), tolerance=value_tolerance)
    @assertEqual(10.0/geom%aminor, geom%Rpos(geom%eqpsi(2), pi/2), tolerance=value_tolerance)
    @assertEqual(10.0/geom%aminor, geom%Rpos(geom%eqpsi(2), -pi/2), tolerance=value_tolerance)
    call teardown
  end subroutine test_Rpos

  @test
  subroutine test_Zpos
    call setup
    @assertEqual(-1e-3/geom%aminor, geom%Zpos(geom%eqpsi(2), 0.), tolerance=value_tolerance)
    @assertEqual(-1e-3/geom%aminor, geom%Zpos(geom%eqpsi(2), pi), tolerance=value_tolerance)
    @assertEqual(-1e-3/geom%aminor, geom%Zpos(geom%eqpsi(2), twopi), tolerance=value_tolerance)
    @assertEqual((1.0-1e-3)/geom%aminor, geom%Zpos(geom%eqpsi(2), pi/2), tolerance=value_tolerance)
    @assertEqual((-1.0-1e-3)/geom%aminor, geom%Zpos(geom%eqpsi(2), -pi/2), tolerance=value_tolerance)
    call teardown
  end subroutine test_Zpos

  @test
  subroutine test_rcenter
    call setup
    @assertEqual(10./geom%aminor, geom%rcenter(geom%eqpsi(1)))
    @assertEqual(10./geom%aminor, geom%rcenter(geom%eqpsi(2)))
    call teardown
  end subroutine test_rcenter

  @test
  subroutine test_diameter
    call setup
    @assertEqual(0., geom%diameter(geom%eqpsi(1)))
    @assertEqual(2/geom%aminor, geom%diameter(geom%eqpsi(2)))
    @assertEqual(8/geom%aminor, geom%diameter(geom%eqpsi(3)))
    call teardown
  end subroutine test_diameter

  @test
  subroutine test_btori
    call setup
    @assertEqual(1.25, geom%btori(0.25))
    @assertEqual(-1.25, geom%btori(0.75))
    call teardown
  end subroutine test_btori

  @test
  subroutine test_dbtori
    call setup
    @assertEqual(-2., geom%dbtori(0.25))
    @assertEqual(-2., geom%dbtori(0.75))
    call teardown
  end subroutine test_dbtori

  @test
  subroutine test_qfun
    call setup
    @assertEqual(6.25, geom%qfun(0.25), tolerance=spline_tolerance)
    @assertEqual(12.25, geom%qfun(0.75), tolerance=spline_tolerance)
    call teardown
  end subroutine test_qfun

  @test
  subroutine test_pfun
    call setup
    @assertEqual(2.25, geom%pfun(0.25), tolerance=spline_tolerance)
    @assertEqual(3.75, geom%pfun(0.75), tolerance=spline_tolerance)
    call teardown
  end subroutine test_pfun

  @test
  subroutine test_dpfun
    call setup
    @assertEqual(1.2, geom%dpfun(0.25), tolerance=spline_tolerance)
    @assertEqual(1.2, geom%dpfun(0.75), tolerance=spline_tolerance)
    call teardown
  end subroutine test_dpfun

  @test
  subroutine test_betafun
    call setup
    @assertEqual(4.5, geom%betafun(0.25), tolerance=spline_tolerance)
    @assertEqual(7.5, geom%betafun(0.75), tolerance=spline_tolerance)
    call teardown
  end subroutine test_betafun

  @test
  subroutine test_psi
    @assertEqual(-1., geom%psi(-1., 0.))
    @assertEqual(geom%psi_0, geom%psi(0., 0.))
    @assertEqual(1.5, geom%psi(1.5, 0.))
  end subroutine test_psi

end module test_ceq_mod
