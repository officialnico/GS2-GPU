    call set_theta_grid_eik_config(theta_grid_eik_config)

    call init_theta_grid

    @assertEqual(theta, expected_theta, tolerance=tolerance, message="theta")
    @assertEqual(bmag, expected_bmag, tolerance=tolerance, message="Bmag")
    @assertEqual(gradpar, expected_gradpar, tolerance=tolerance, message="gradpar")
