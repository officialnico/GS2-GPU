    @assertEqual(jacob, expected_jacob, tolerance=tolerance, message="jacob")
    @assertEqual(rplot, expected_rplot, tolerance=tolerance, message="rplot")
    @assertEqual(zplot, expected_zplot, tolerance=tolerance, message="zplot")
    @assertEqual(aplot, expected_aplot, tolerance=tolerance, message="aplot")
    @assertEqual(rprime, expected_rprime, tolerance=tolerance, message="rprime")
    @assertEqual(zprime, expected_zprime, tolerance=tolerance, message="zprime")
    @assertEqual(aprime, expected_aprime, tolerance=tolerance, message="aprime")
    @assertEqual(bpol, expected_bpol, tolerance=tolerance, message="bpol")

  end subroutine test_miller_eikcoefs

