    theta_grid_params_local_config%ntheta = 200
    call theta_grid_params_config%setup("theta_grid_params", requires_index=.false.)
    call set_theta_grid_params_config(theta_grid_params_local_config)
    theta_grid_eik_config  = theta_grid_eik_config_type( &
         itor = 1, &
         iflux = 1, &
         irho = 2, &
         bishop = 1, &
         delrho = 0.001, &
         isym = -1, &
         force_sym = .false., &
         local_eq = .false., &
         chs_eq = .true., &
         equal_arc = .true., &
         eqfile = "tests/common_geometry_files/ogyropsi.dat" &
         )
    call theta_grid_eik_config%setup("eik_knobs", requires_index=.false.)
    call set_theta_grid_eik_config(theta_grid_eik_config)

    call init_theta_grid

    ! Full theta grid is 201 points, which would make golden answers
    ! above very large, so just check a subarray
    @assertEqual(expected_theta, theta(-100:97:6), tolerance=tolerance, message="theta")
    @assertEqual(expected_bmag, bmag(-100:97:6), tolerance=tolerance, message="Bmag")
    @assertEqual(expected_grho, grho(-100:97:6), tolerance=tolerance, message="grho")
    @assertEqual(expected_gbdrift, gbdrift(-100:97:6), tolerance=tolerance, message="gbdrift")
    @assertEqual(expected_cvdrift, cvdrift(-100:97:6), tolerance=tolerance, message="cvdrift")
    @assertEqual(expected_gds2, gds2(-100:97:6), tolerance=tolerance, message="gds2")
    @assertEqual(expected_gds21, gds21(-100:97:6), tolerance=tolerance, message="gds21")
  end subroutine test_chease_eikcoefs

  @test(npes=[1])
