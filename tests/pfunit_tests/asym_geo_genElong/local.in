&theta_grid_knobs
 equilibrium_option = "eik" ! Controls which geometric assumptions are used in the run.
/

&theta_grid_parameters
  geoType = 2

  shift = -0.2
  shiftVert = -0.1

  mMode = 2
  deltam = 1.3
  deltampri = 0.1
  thetam = 0.7854

  nMode = 3
  deltan = 1.1
  deltanpri = 0.2076
  thetan = 0.5236

  Rmaj = 3.0
  R_geo = 3.1
  rhoc = 0.54
  qinp = 1.4
  shat = 0.8

  nperiod = 1
  ntheta = 32
/

&theta_grid_eik_knobs
 itor = 1
 iflux = 0
 irho = 2 ! Chooses definition of flux surface coordinate.
 local_eq = T
 eqfile = "dskeq.cdf"
 bishop = 4
 delrho = 0.001
 isym = 0
 ppl_eq = F
 gen_eq = F
 efit_eq = F
 equal_arc = F
 writelots = F
 beta_prime_input = -0.06
 s_hat_input = 0.8
/
&kt_grids_knobs
 grid_option="single"
/
