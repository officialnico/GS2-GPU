module test_asym_geo_genElong_mod
  use PFUNIT_MOD
  implicit none

  integer, parameter :: grid_size = 33 !! Theta-grid size

contains

  !>  Calculates several geometric coefficients from the generalized
  !!  elongation flux surface specification to verify that they have
  !!  not changed.
  @test(npes=[1])
  subroutine test_asym_geo_genElong(this)
    use theta_grid, only: bmag, grho, gbdrift, cvdrift, gds2, gds21
    use file_utils, only: init_file_utils, finish_file_utils
    use theta_grid, only : init_theta_grid, finish_theta_grid, theta
    use theta_grid_params, only: finish_theta_grid_params
    use mp, only : init_mp, proc0

    class(MPITestMethod), intent(inout) :: this

    logical :: dummy
    real, parameter :: previous_Bmag(grid_size) = [ &
         1.32374054827664, 1.31804392669621, 1.30829002891367, &
         1.27530782709033, 1.22778077483077, 1.17404736696701, 1.12001595485753, &
         1.0930185783729, 1.04425645396722, 1.01769352943759, 0.976638334654061, &
         0.947970456742778, 0.924748817827418, 0.902550400544131, &
         0.880526695579318, 0.862428731484493, 0.856453410115731, &
         0.862428731484493, 0.880526695579318, 0.902550400544131, &
         0.924748817827418, 0.947970456742778, 0.976638334654061, &
         1.01769352943759, 1.04425645396722, 1.0930185783729, 1.12001595485753, &
         1.17404736696701, 1.22778077483077, 1.27530782709033, 1.30829002891367, &
         1.31804392669621, 1.32374054827664]
    real, parameter :: previous_grho(grid_size) = [ &
         0.695871014735811, 0.680148295321068, 0.665606511658158, &
         0.63754659566276, 0.62426273193157, 0.629728594219147, 0.652322634884079, &
         0.671628982566618, 0.730385830393325, 0.784079451759367, 0.9158755893869, &
         1.0338177883991, 1.09451346538351, 1.0975847994202, 1.04278131668068, &
         0.93365193650451, 0.833570796651626, 0.770980050591282, 0.75417738614447, &
         0.772948702355494, 0.80358429542286, 0.838800394812921, &
         0.880037878358477, 0.926062292326912, 0.943897690886262, &
         0.948218281336096, 0.934885566280391, 0.878807481182261, &
         0.801320842783737, 0.741939388264678, 0.717042615811293, &
         0.711558228982654, 0.695871014735811]
    real, parameter :: previous_gbdrift(grid_size) = [ &
         -1.04412370389027, -0.85540113371871, -0.705671879860376, &
         -0.438865267415045, -0.235085743124304, -0.0760138579601791, &
         0.0575723187214014, 0.119299180830612, 0.218626975530225, &
         0.260570081426969, 0.29732406407174, 0.296625682728029, 0.30953319726058, &
         0.379759795111242, 0.486750055191012, 0.593625511803165, &
         0.675952410602811, 0.738608236536429, 0.782170206230574, &
         0.807469444407806, 0.823742842632602, 0.832107540207915, &
         0.825132975301371, 0.773876019874944, 0.714472603376343, &
         0.570663978113812, 0.48387447019319, 0.299724375996642, &
         0.0574829676323018, -0.275872594562098, -0.65818827524859, &
         -0.849774385174079, -1.2169038170377]
    real, parameter :: previous_cvdrift(grid_size) = [ &
         -1.01051829588691, -0.821150252122333, -0.670926828215223, &
         -0.402666742533404, -0.196098902828749, -0.0332641178254181, &
         0.104691267772953, 0.16884425662749, 0.273166165364633, 0.31831457699636, &
         0.360894111025923, 0.364659305700954, 0.381032061886161, &
         0.454567181648174, 0.56486598760673, 0.67406029927739, 0.756360766189493, &
         0.817068511550979, 0.857245124044998, 0.879233002874248, &
         0.892527237234408, 0.897998633954368, 0.887676061255139, &
         0.831980929955091, 0.769902874390818, 0.621525198763222, &
         0.532355237362153, 0.343620540304815, 0.0971068286700031, &
         -0.239409920991463, -0.623349770199332, -0.815273955779336, &
         -1.18329840903434]
    real, parameter :: previous_gds2(grid_size) = [ &
         11.6465956610205, 10.208354131051, 8.97630292149775, &
         6.63065248629725, 4.91535899297543, 3.77420211283261, 2.96142187347632, &
         2.60909567860474, 2.01085222082463, 1.70143843080877, 1.25760966061007, &
         0.974256341040873, 0.784065194582681, 0.701162974518607, &
         0.727387485517056, 0.84873281822617, 1.02657540069498, 1.24366346975735, &
         1.50458399789536, 1.75465524919969, 2.00029126198714, 2.26241212387409, &
         2.5765380300866, 2.95671754343202, 3.12492603301239, 3.26791213317382, &
         3.31342264863166, 3.60838956827885, 4.52222489830681, 6.20414865404807, &
         8.30802976735798, 9.32822099315504, 11.072586063513]
    real, parameter :: previous_gds21(grid_size) = [ &
         2.55121197222432, 2.22830997208926, 1.94385350899162, &
         1.36328248064536, 0.878630399944676, 0.52487213197635, 0.265424189304571, &
         0.153166399534643, -0.0462547272938092, -0.165338100468642, &
         -0.364822810387027, -0.422189116677404, -0.28993912509422, &
         -0.0852550928082375, 0.0414845427466094, 0.0250959032136366, &
         -0.084784898644847, -0.241537844256673, -0.455659266719451, &
         -0.67261341049816, -0.879618038904227, -1.08624511009312, &
         -1.31673321218206, -1.56854499813911, -1.66217666577971, &
         -1.6796493090879, -1.62693933650554, -1.51034762159647, &
         -1.52342546522093, -1.73394167478657, -2.06176059579044, &
         -2.21885261943117, -2.45985550739881]
    real, parameter :: previous_theta(grid_size) = [ &
         -3.14159265358979, -2.99841520228469, -2.88534520874469, &
         -2.66852528414391, -2.46114306754236, -2.26422199633474, &
         -2.07114385341194, -1.97006629112589, -1.76714586764426, &
         -1.63624617374468, -1.37444678594553, -1.11264739814639, &
         -0.850848010347236, -0.589048622548086, -0.327249234748937, &
         -0.0654498469497874, 0.150620464164052, 0.34225026806538, &
         0.53006700358781, 0.675804083601577, 0.795092294397007, &
         0.906677999150311, 1.03660806264643, 1.21949324463564, 1.34032775459366, &
         1.5707963267949, 1.70169602069447, 1.96349540849362, 2.22529479629277, &
         2.48709418409192, 2.74889357189107, 2.87979326579064, 3.14159265358979]

    real, dimension(grid_size) :: new_bmag, new_grho, new_gbdrift, new_cvdrift, new_gds2, new_gds21

    call init_mp(this%getMpiCommunicator())
    if (proc0) then
      ! This is very fragile! Assumes executable is called from top-level directory
      ! FIXME: initialise relevant modules with parameters directly
      call init_file_utils(dummy, .true., .true., .false., 'tests/pfunit_tests/asym_geo_genElong/local')
    end if
    call init_theta_grid

    new_bmag = interpolate(bmag, previous_theta, theta)
    new_grho = interpolate(grho, previous_theta, theta)
    new_gbdrift = interpolate(gbdrift, previous_theta, theta)
    new_cvdrift = interpolate(cvdrift, previous_theta, theta)
    new_gds2 = interpolate(gds2, previous_theta, theta)
    new_gds21 = interpolate(gds21, previous_theta, theta)

    if (proc0) call finish_file_utils
    call finish_theta_grid

    ! Need to explicitly call finish_theta_grid_params here because
    ! finish_theta_grid _doesn't_ call it because "this is now handled
    ! separately by gs2_init"
    call finish_theta_grid_params

    @assertEqual(new_bmag, previous_Bmag, tolerance=1.e-8, message="Bmag")
    @assertEqual(new_grho, previous_grho, tolerance=1.e-8, message="grho")
    @assertEqual(new_gbdrift, previous_gbdrift, tolerance=1.e-8, message="gbdrift")
    @assertEqual(new_cvdrift, previous_cvdrift, tolerance=1.e-8, message="cvdrift")
    @assertEqual(new_gds2, previous_gds2, tolerance=1.e-8, message="gds2")
    @assertEqual(new_gds21, previous_gds21, tolerance=1.e-8, message="gds21")

  end subroutine test_asym_geo_genElong

  !> Interpolate `var` from `new_theta` onto `old_theta`
  function interpolate(var, old_theta, new_theta)
    use splines, only : new_spline, splint, delete_spline, spline_type => spline
    real, dimension(grid_size), intent(in) :: var       !! The variable to spline
    real, dimension(grid_size), intent(in) :: old_theta !! The old theta grid
    real, dimension(grid_size), intent(in) :: new_theta !! The new theta grid
    real, dimension(grid_size) :: interpolate
    type(spline_type) :: spline
    integer :: i

    call new_spline(size(var), new_theta, var, spline)
    do i = 1, grid_size
      interpolate(i) = splint(old_theta(i), spline)
    end do
    call delete_spline(spline)
  end function interpolate

end module test_asym_geo_genElong_mod
