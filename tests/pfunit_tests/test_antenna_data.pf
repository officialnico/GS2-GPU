module test_antenna_data_mod

  use pfunit_mod
  implicit none

  @testParameter(contsructor = new_test)
  type, extends(MpiTestParameter) :: case
     integer :: nk_stir_in
  end type case

@TestCase(constructor = new_test)
  type, extends(MpiTestCase) :: test_parameters
    integer :: nk_stir_in
  end type test_parameters

contains

  ! Constructor
  function new_test(test_parameter) result (test)
    type (test_parameters) :: test
    type (case), intent(in) :: test_parameter

    test%nk_stir_in = test_parameter%nk_stir_in

  end function new_test

  function new_case(nk_stir_in)
     type (case) :: new_case
     integer, intent(in) :: nk_stir_in
     new_case%nk_stir_in = nk_stir_in
  end function new_case

  ! Define the parameters scan
  function get_parameters() result(params)
    type(case), allocatable :: params(:)

    params = [ &
         & new_case(nk_stir_in=-1), &
         & new_case(nk_stir_in=3) &
         & ]

  end function get_parameters

@test(npes=[1,2,4],testParameters={get_parameters()})
  !> Test for initialization with no antenna
  subroutine test_init_antenna_data(this)

    use antenna_data

    implicit none
    class (test_parameters), intent(inout) :: this

    integer :: nk_stir_in
    associate( nk_stir_in => this%nk_stir_in )

      call init_antenna_data(nk_stir_in)

      if( nk_stir_in .lt. 0 ) then ! Antenna off
	@mpiAssertFalse(ant_on)
	@mpiAssertSameShape ( shape(nk_stir_in) , shape(a_ant) )
	@mpiAssertSameShape ( shape(nk_stir_in) , shape(b_ant) )
      else ! Antenna on
        @mpiAssertTrue(ant_on)
        @mpiAssertEqual(nk_stir_in , nk_stir )
        @mpiAssertSameShape ( shape(nk_stir_in) , shape(a_ant) )
        @mpiAssertSameShape ( shape(nk_stir_in) , shape(b_ant) )
      end if

      ! Reset module
      call finish_antenna_data

      @mpiAssertFalse(ant_on)
      @mpiAssertFalse(allocated(a_ant))
      @mpiAssertFalse(allocated(b_ant))

    end associate

  end subroutine test_init_antenna_data

end module test_antenna_data_mod
