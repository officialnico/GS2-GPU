module test_antenna_data_mod

  use gs2_init
  use pfunit_mod
  use gs2_main, only: gs2_program_state_type
  implicit none

  public :: test_antenna_data

@TestCase(npes=[1,2,4])
  type, extends(MpiTestCase) :: test_antenna_data
    type(gs2_program_state_type) :: gs2_state
  contains
    procedure :: setUp     ! overides generic
    procedure :: tearDown  ! overrides generic
    procedure :: setUpInputFile
  end type test_antenna_data

contains

  ! No need to annotate setUp() when _extending_ TestCase
  subroutine setUp(this)

    use gs2_main, only: initialize_gs2, gs2_program_state_type

    implicit none

    class (test_antenna_data), intent(inout) :: this

    call setUpInputFile( this, "antenna_data.in" )
     
  end subroutine setUp

  ! Do a setup specifying a different input file, allowing us to test different
  ! input parameters.  Could do this in pfunit, using input filename as a 
  ! parameter to scan, but most tests don't need to be repeated with different
  ! input files, so this is simpler.  
  subroutine setUpInputFile( this, input_filename )

    use gs2_main, only: initialize_gs2, gs2_program_state_type

    implicit none

    class (test_antenna_data), intent(inout) :: this
    integer :: comm
    character(*), intent(in) :: input_filename

    comm = this%getMpiCommunicator()

    ! Set up depenencies
    this%gs2_state%mp_comm_external = .true.
    this%gs2_state%mp_comm = comm
    this%gs2_state%run_name_external = .true.
    this%gs2_state%run_name = trim(input_filename)
    call initialize_gs2(this%gs2_state)
    call init(this%gs2_state%init, init_level_list%basic)

  end subroutine setUpInputFile

  ! No need to annotate tearDown() _extending_ TestCase
  subroutine tearDown(this)

    use gs2_init, only:  init
    use gs2_main, only:  finalize_gs2
    use file_utils, only: finish_file_utils

    implicit none
    class (test_antenna_data), intent(inout) :: this

    call init(this%gs2_state%init, 0)
    call finalize_gs2(this%gs2_state)

  end subroutine tearDown

@test
  !> Test for initialization with no antenna
  subroutine test_init_antenna_data_no_antenna(this)

    use pFUnit_mod
    use antenna_data

    implicit none
    class (test_antenna_data), intent(inout) :: this

    integer :: nk_stir_in = -1

    call init_antenna_data(nk_stir_in)

    @mpiAssertFalse(ant_on)
    @mpiAssertSameShape ( shape(nk_stir_in) , shape(a_ant) )
    @mpiAssertSameShape ( shape(nk_stir_in) , shape(b_ant) )

    ! Reset module
    call finish_antenna_data

    @mpiAssertFalse(ant_on)
    @mpiAssertFalse(allocated(a_ant))
    @mpiAssertFalse(allocated(b_ant))

  end subroutine test_init_antenna_data_no_antenna

@test
  !> Test for initialization with antenna on
  subroutine test_init_antenna_data(this)

    use pFUnit_mod
    use antenna_data

    implicit none
    class (test_antenna_data), intent(inout) :: this

    integer :: nk_stir_in = 3

    call init_antenna_data(nk_stir_in)

    @mpiAssertTrue(ant_on)
    @mpiAssertEqual(nk_stir_in , nk_stir )
    @mpiAssertSameShape ( shape(nk_stir_in) , shape(a_ant) )
    @mpiAssertSameShape ( shape(nk_stir_in) , shape(b_ant) )

    ! Reset module
    call finish_antenna_data

    @mpiAssertFalse(ant_on)
    @mpiAssertFalse(allocated(a_ant))
    @mpiAssertFalse(allocated(b_ant))

  end subroutine test_init_antenna_data

end module test_antenna_data_mod
