    real, parameter :: previous_gds21(grid_size) = [ &
         2.492826817560355,         1.981710576724922,         1.713167424188002, &
         1.461781806040429,         1.021589650312019,         0.671201458202283, &
         0.384849911828547,         0.251709843723093,         0.008181962186078, &
         -0.137925348697148,        -0.378620178747356,        -0.422100389034841, &
         -0.199677854672952,         0.067199037222584,         0.146307290631468, &
         0.041068137824465,        -0.076507205927855,        -0.204285696511397, &
         -0.404270059411235,        -0.606999009630020,        -0.793734660038755, &
         -0.971002365852913,        -1.175136496213404,        -1.438374192107369, &
