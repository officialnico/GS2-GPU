         -1.796092466023628,        -1.956758581025935,        -2.504001569261333  &
         ]

    real, dimension(grid_size) :: new_bmag, new_grho, new_gbdrift, new_cvdrift, new_gds2, new_gds21

    type(theta_grid_parameters_config_type) :: theta_grid_parameters_config

    theta_grid_parameters_config = theta_grid_parameters_config_type( &
        geoType = 3, &
        shift = -0.2, &
        shiftVert = -0.1, &
        mMode = 2, &
        deltam = 1.3, &
        deltampri = 0.1, &
        thetam = 0.7854, &
        nMode = 3, &
        deltan = 1.1, &
        deltanpri = 0.2076, &
        thetan = 0.5236, &
        Rmaj = 3.0, &
        R_geo = 3.1, &
        rhoc = 0.54, &
        qinp = 1.4, &
        shat = 0.8, &
        nperiod = 1, &
        ntheta = 32 &
    )
