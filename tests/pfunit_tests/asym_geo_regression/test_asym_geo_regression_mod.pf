         ]
    real, parameter :: previous_cvdrift(grid_size) = [ &
         -1.130563173614071,        -0.854265099525666,        -0.617664882452730, &
         -0.423226637369604,        -0.276961195692974,        -0.164483155840324, &
         -0.067364306138229,         0.026714330524841,         0.120523764372043, &
         0.292616019623917,         0.426566416676823,         0.514086724223568, &
