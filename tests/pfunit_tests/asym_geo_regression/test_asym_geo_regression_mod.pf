         0.538073247427772,         0.479033927986629,         0.361377542724584, &
         0.173377678404462,         0.055929778707044,        -0.073167771354045, &
         -0.215407892035587,        -0.368151494739671,        -0.534061864282272, &
         -0.718895575697009,        -0.931278077876110,        -1.182544254780623  &
         ]
    real, parameter :: previous_gds2(grid_size) = [ &
         14.321149742066044,        10.669806193450682,         7.746931048498337, &
         5.588458714902170,         4.085032374846110,         3.047190486082355, &
