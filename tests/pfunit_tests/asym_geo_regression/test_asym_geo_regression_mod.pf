module test_asym_geo_regression_mod
  use PFUNIT_MOD
  implicit none

  integer, parameter :: grid_size = 33 !! Theta-grid size
  real, parameter :: tolerance = 1.0e-11
contains

  @before
  subroutine setup(this)
    use theta_grid_eik, only : theta_grid_eik_config_type, set_theta_grid_eik_config
    use theta_grid, only : theta_grid_config_type, set_theta_grid_config
    use mp, only : init_mp

    class (MpiTestMethod), intent(inout) :: this
    type(theta_grid_config_type) :: theta_grid_config
    type(theta_grid_eik_config_type) :: theta_grid_eik_config
    integer :: mp_comm
    mp_comm = this%getMpiCommunicator()
    call init_mp(mp_comm)

    theta_grid_config = theta_grid_config_type(equilibrium_option = "eik")
    call theta_grid_config%setup("theta_grid", requires_index=.false.)
    call set_theta_grid_config(theta_grid_config)

    theta_grid_eik_config  = theta_grid_eik_config_type( &
        itor = 1, &
        iflux = 0, &
        irho = 2, &
        local_eq = .true., &
        bishop = 4, &
        delrho = 0.001, &
        isym = -1, &
        force_sym = .false., &
        ppl_eq = .false., &
        gen_eq = .false., &
        efit_eq = .false., &
        equal_arc = .false., &
        writelots = .false., &
        beta_prime_input = -0.06, &
        s_hat_input = 0.8 &
    )
    call theta_grid_eik_config%setup("eik_knobs", requires_index=.false.)
    call set_theta_grid_eik_config(theta_grid_eik_config)
  end subroutine setup

  @after
  subroutine teardown(this)
    use theta_grid, only : finish_theta_grid
    use theta_grid_params, only : finish_theta_grid_params

    class (MpiTestMethod), intent(inout) :: this

    call finish_theta_grid
    ! Need to explicitly call finish_theta_grid_params here because
    ! finish_theta_grid _doesn't_ call it because "this is now handled
    ! separately by gs2_init"
    call finish_theta_grid_params
  end subroutine teardown

  !>  Calculates several geometric coefficients from the generalized
  !!  Miller flux surface specification to verify that they have not
  !!  changed.
  @test(npes=[1])
  subroutine test_asym_geo_miller(this)
    use theta_grid, only: bmag, grho, gbdrift, cvdrift, gds2, gds21, set_theta_grid_config
    use theta_grid, only : init_theta_grid, theta
    use theta_grid_params, only: init_theta_grid_params, set_theta_grid_params_config, &
         theta_grid_parameters_config_type

    class(MPITestMethod), intent(inout) :: this
    real, parameter :: previous_theta(grid_size) = [ &
         -3.14159265358979, -2.96909691483081, -2.79753624140583, &
         -2.62691063331481, -2.45995122460437, -2.29564390653795, &
         -2.13398867911553, -1.97902030603011, -1.82790760022706, &
         -1.54168052849789, -1.27627882252284, -1.03444601532502, &
         -0.809104557779855, -0.596535696876655, -0.393953292215471, &
         -0.19590929198706, -4.44089209850063e-16, 0.195909291987062, &
         0.393953292215472, 0.596535696876654, 0.809104557779858, &
         1.03444601532502, 1.27627882252284, 1.54168052849789, 1.82790760022705, &
         1.97902030603012, 2.13398867911553, 2.29564390653794, 2.45995122460437, &
         2.62691063331481, 2.79753624140584, 2.96909691483083, 3.14159265358979 ]
    real, parameter :: previous_bmag(grid_size) = [ &
         1.336385546251599,         1.330590513392409,         1.314955232801789, &
         1.290353010488905,         1.258591869145341,         1.221698107269546, &
         1.181553638418985,         1.141232882186087,         1.101731219175851, &
         1.030850456132845,         0.974412049885884,         0.933559757487483, &
         0.905632635612268,         0.888520080930795,         0.880184253386864, &
         0.878994131443650,         0.883853915262661,         0.894156857779259, &
         0.909523680872420,         0.930166853596869,         0.957019503124769, &
         0.990997747177555,         1.033319636144536,         1.085352772407911, &
         1.145463416724735,         1.177665622434791,         1.210099899424314, &
         1.242401036609335,         1.272359446630073,         1.298591864307744, &
         1.319235171404120,         1.332257129028287,         1.336385546251600  &
         ]
    real, parameter :: previous_grho(grid_size) = [ &
         0.667253595213201,         0.620332877662444,         0.597063475739697, &
         0.605475592632768,         0.643943013336296,         0.701517763482788, &
         0.768277779856312,         0.833755871984653,         0.894357207344475, &
         0.991327891829520,         1.053858762082523,         1.087466575072044, &
         1.104115473643283,         1.112328030454321,         1.113436877673601, &
         1.103212615724293,         1.077000387262047,         1.033144334673604, &
         0.974986887652566,         0.910107473918145,         0.852338779085430, &
