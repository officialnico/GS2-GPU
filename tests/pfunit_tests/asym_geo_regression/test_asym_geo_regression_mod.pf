         ]
    real, parameter :: previous_gds21(grid_size) = [ &
         2.492826817560353,         1.981710598268763,         1.713167439951892, &
         1.461781800202830,         1.021589657357659,         0.671201463117980, &
         0.384849915993724,         0.251709843852577,         0.008181962186078, &
         -0.137925347334697,        -0.378620178747356,        -0.422100375291420, &
         -0.199677851399031,         0.067199037222584,         0.146307282444391, &
         0.041068134888141,        -0.076507207590182,        -0.204285699162314, &
         -0.404270064488126,        -0.606999015393086,        -0.793734660371914, &
         -0.971002368498859,        -1.175136493156319,        -1.438374185068522, &
         -1.564822278142829,        -1.653586508468266,        -1.628080770729148, &
