         0.864979227194125,         1.048874897605480,         1.325021537279468, &
         1.719433769955496,         2.235986263077654,         2.802999043555296, &
         3.232337861302228,         3.360100822518259,         3.446045726436708, &
         3.525764383363215,         3.650287944120518,         3.890150707547865, &
         4.330245278210245,         5.115209917517139,         6.381802488564301  &
         ]
    real, parameter :: previous_gds21(grid_size) = [ &
         2.451805708645641,         1.757861444519743,         1.184238001320582, &
         0.745982569312592,         0.428678577389007,         0.209013973320225, &
         0.078381142851015,         0.025466633625355,         0.026743575658215, &
         0.107024192700083,         0.185537978629618,         0.202859484715189, &
         0.165236249087947,         0.104000900300875,         0.048897370301277, &
         0.014738730179991,         0.000116745965145,        -0.011351683413264, &
         -0.044167918588620,        -0.123278332010827,        -0.270504443918309, &
         -0.493550365242459,        -0.786269199193884,        -1.097776860939904, &
         -1.309285867955996,        -1.348126284613701,        -1.339964597233310, &
         -1.292740285869304,        -1.220943563265883,        -1.147264547382129, &
         -1.095578291294417,        -1.100874950113008,        -1.188219348327781  &
         ]

    real, dimension(grid_size) :: new_bmag, new_grho, new_gbdrift, new_cvdrift, new_gds2, new_gds21

    type(theta_grid_parameters_config_type) :: theta_grid_parameters_config

    theta_grid_parameters_config = theta_grid_parameters_config_type( &
        geoType = 0, &
        shift = -0.2, &
        shiftVert = -0.1, &
        akappa = 1.3, &
        akappri = 0.1, &
        thetak = 0.7854, &
        tri = 0.2, &
        tripri = 0.2076, &
        thetad = 0.5236, &
        Rmaj = 3.0, &
        R_geo = 3.1, &
        rhoc = 0.54, &
        qinp = 1.4, &
        shat = 0.8, &
        nperiod = 1, &
        ntheta = 32 &
    )
    call theta_grid_parameters_config%setup("theta_grid_parameters", requires_index=.false.)
    call set_theta_grid_params_config(theta_grid_parameters_config)

    call init_theta_grid

    new_bmag = interpolate(bmag, previous_theta, theta)
    new_grho = interpolate(grho, previous_theta, theta)
    new_gbdrift = interpolate(gbdrift, previous_theta, theta)
    new_cvdrift = interpolate(cvdrift, previous_theta, theta)
    new_gds2 = interpolate(gds2, previous_theta, theta)
    new_gds21 = interpolate(gds21, previous_theta, theta)

    @assertEqual(new_bmag, previous_Bmag, tolerance=tolerance, message="Bmag")
    @assertEqual(new_grho, previous_grho, tolerance=tolerance, message="grho")
    @assertEqual(new_gbdrift, previous_gbdrift, tolerance=tolerance, message="gbdrift")
    @assertEqual(new_cvdrift, previous_cvdrift, tolerance=tolerance, message="cvdrift")
    @assertEqual(new_gds2, previous_gds2, tolerance=tolerance, message="gds2")
    @assertEqual(new_gds21, previous_gds21, tolerance=tolerance, message="gds21")
  end subroutine test_asym_geo_miller

