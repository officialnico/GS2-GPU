  !> Interpolate `var` from `new_theta` onto `old_theta`
  function interpolate(var, old_theta, new_theta)
    use splines, only : new_spline, splint, delete_spline, spline_type => spline
    real, dimension(grid_size), intent(in) :: var       !! The variable to spline
    real, dimension(grid_size), intent(in) :: old_theta !! The old theta grid
    real, dimension(grid_size), intent(in) :: new_theta !! The new theta grid
    real, dimension(grid_size) :: interpolate
    type(spline_type) :: spline
    integer :: i

    spline = new_spline(new_theta, var)
    do i = 1, grid_size
      interpolate(i) = splint(old_theta(i), spline)
    end do
    call delete_spline(spline)
  end function interpolate

  !> Call to dump the current values from theta grid in a vaguely useful format.
  !> Helpful when we need to update the golden results as we've fixed a bug/changed
  !> behaviour etc.
  subroutine helper_to_update_results(name, bmag, grho, gbdrift, cvdrift, &
       gds2, gds21, raw_format_in)
    implicit none
    character(len=*), intent(in) :: name
    real, dimension(:), intent(in) :: bmag, grho, gbdrift, cvdrift, gds2, gds21
    logical, intent(in), optional :: raw_format_in
    logical :: raw_format
    integer :: lun
    open(file=name,newunit=lun)

    raw_format = .false.
    if (present(raw_format_in)) raw_format = raw_format_in

    call write_data( lun, "bmag", bmag, raw_format)
    call write_data( lun, "grho", grho, raw_format)
    call write_data( lun, "gbdrift", gbdrift, raw_format)
    call write_data( lun, "cvdrift", cvdrift, raw_format)
    call write_data( lun, "gds2", gds2, raw_format)
    call write_data( lun, "gds21", gds21, raw_format)

    close(lun)

  contains
    subroutine write_data(unit, name, data, raw_format)
      implicit none
      integer, intent(in) :: unit
      character(len=*), intent(in) :: name
      real, dimension(:), intent(in) :: data
      logical, intent(in) :: raw_format

      if (raw_format) then
         write(unit, '(33(F25.15," "))') data
      else
         write(unit, '("real, parameter :: previous_",A,"(grid_size) = [ &")') name
         write(unit, '(10(" ", 3(F25.15, ", "), "&", /), " ", 2(F25.15, ", "), F25.15, "  &")') data
         write(unit, '("]")')
      end if

    end subroutine write_data

  end subroutine helper_to_update_results

end module test_asym_geo_regression_mod
