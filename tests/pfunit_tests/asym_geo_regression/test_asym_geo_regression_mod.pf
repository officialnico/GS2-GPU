         -0.753189242884156,        -0.964869598150033,        -1.215860434883826  &
         ]
    real, parameter :: previous_cvdrift(grid_size) = [ &
         -1.130563173614071,        -0.854265112154086,        -0.617664867210595, &
         -0.423226635004229,        -0.276961191228224,        -0.164483155512243, &
         -0.067364306201631,         0.026714330442412,         0.120523764471165, &
         0.292616020392388,         0.426566418896261,         0.514086724945738, &
