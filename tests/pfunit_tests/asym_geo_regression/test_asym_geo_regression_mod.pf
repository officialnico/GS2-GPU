         -0.215407891760747,        -0.368151495292818,        -0.534061866889252, &
         -0.718895562986291,        -0.931278078516834,        -1.182544254780623  &
         ]
    real, parameter :: previous_gds2(grid_size) = [ &
         14.321149742066043,        10.669806336819956,         7.746930821480138, &
         5.588458683162154,         4.085032322246800,         3.047190471388955, &
