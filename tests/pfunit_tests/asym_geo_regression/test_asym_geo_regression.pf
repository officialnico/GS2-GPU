         -0.0654498469497874, 0.149793533673363, 0.340678915178904, &
         0.528442809259481, 0.674334391009427, 0.793864599963748, &
         0.905618023099863, 1.03655091951204, 1.2205957491219, &
         1.34167062621101, 1.5707963267949, 1.70169602069447, &
         1.96349540849362, 2.22529479629277, 2.48709418409192, &
         2.74889357189107, 2.87979326579064, 3.14159265358979 ]

    real, dimension(grid_size) :: new_bmag, new_grho, new_gbdrift, new_cvdrift, new_gds2, new_gds21

    type(theta_grid_parameters_config_type) :: theta_grid_parameters_config

    theta_grid_parameters_config = theta_grid_parameters_config_type( &
        geoType = 2, &
        shift = -0.2, &
        shiftVert = -0.1, &
        mMode = 2, &
        deltam = 1.3, &
        deltampri = 0.1, &
        thetam = 0.7854, &
        nMode = 3, &
        deltan = 1.1, &
        deltanpri = 0.2076, &
        thetan = 0.5236, &
        Rmaj = 3.0, &
        R_geo = 3.1, &
        rhoc = 0.54, &
        qinp = 1.4, &
        shat = 0.8, &
        nperiod = 1, &
        ntheta = 32 &
    )
    call theta_grid_parameters_config%setup("theta_grid_parameters", requires_index=.false.)
    call set_theta_grid_params_config(theta_grid_parameters_config)

    call init_theta_grid

    new_bmag = interpolate(bmag, previous_theta, theta)
    new_grho = interpolate(grho, previous_theta, theta)
    new_gbdrift = interpolate(gbdrift, previous_theta, theta)
    new_cvdrift = interpolate(cvdrift, previous_theta, theta)
    new_gds2 = interpolate(gds2, previous_theta, theta)
    new_gds21 = interpolate(gds21, previous_theta, theta)

    @assertEqual(new_bmag, previous_Bmag, tolerance=1.e-8, message="Bmag")
    @assertEqual(new_grho, previous_grho, tolerance=1.e-8, message="grho")
    @assertEqual(new_gbdrift, previous_gbdrift, tolerance=1.e-8, message="gbdrift")
    @assertEqual(new_cvdrift, previous_cvdrift, tolerance=1.e-8, message="cvdrift")
    @assertEqual(new_gds2, previous_gds2, tolerance=1.e-8, message="gds2")
    @assertEqual(new_gds21, previous_gds21, tolerance=1.e-8, message="gds21")

  end subroutine test_asym_geo_genElong

  !> Calculates several geometric coefficients from the global
  !! flux surface specification to verify that they have not changed
  @test(npes=[1])
  subroutine test_asym_geo_global(this)
    use theta_grid, only: bmag, grho, gbdrift, cvdrift, gds2, gds21, set_theta_grid_config
    use theta_grid, only : init_theta_grid, theta
    use theta_grid_params, only: init_theta_grid_params, set_theta_grid_params_config, &
         theta_grid_parameters_config_type

    class(MPITestMethod), intent(inout) :: this

    real, parameter :: previous_Bmag(grid_size) = [ &
         1.27658976420608 , 1.27543059479085 , 1.26441546371943 , &
