         2.76926701272068, 2.9966278638664, 3.28687470178678, 3.3924932432907, &
         3.68816940490324, 4.40854661623836, 5.77781117787066, 6.72122080469637, &
         7.82487616839872, 11.6751919089698]
    real, parameter :: previous_gds21(grid_size) = [ &
         2.49282681756036, 1.98171057672493, 1.713167424188, &
         1.46178180604044, 1.02158965031201, 0.671201458202287, 0.384849911828544, &
         0.251709843723088, 0.00818196218607744, -0.137925348697144, &
         -0.378620178747353, -0.422100389034839, -0.199677854672951, &
         0.0671990372225844, 0.146307290631467, 0.0410681378244653, &
         -0.0765072059278562, -0.204285696511398, -0.404270059411236, &
         -0.606999009630022, -0.793734660038757, -0.971002365852916, &
         -1.1751364962134, -1.43837419210737, -1.56482228278578, &
         -1.65358650846827, -1.62808077621605, -1.52874236979382, &
         -1.51507996128859, -1.66427024835468, -1.79609246602364, &
         -1.95675858102594, -2.50400156926134]

    real, dimension(grid_size) :: new_bmag, new_grho, new_gbdrift, new_cvdrift, new_gds2, new_gds21

    type(theta_grid_parameters_config_type) :: theta_grid_parameters_config

    theta_grid_parameters_config = theta_grid_parameters_config_type( &
        geoType = 3, &
        shift = -0.2, &
        shiftVert = -0.1, &
        mMode = 2, &
        deltam = 1.3, &
        deltampri = 0.1, &
        thetam = 0.7854, &
        nMode = 3, &
        deltan = 1.1, &
        deltanpri = 0.2076, &
        thetan = 0.5236, &
        Rmaj = 3.0, &
        R_geo = 3.1, &
        rhoc = 0.54, &
        qinp = 1.4, &
        shat = 0.8, &
        nperiod = 1, &
        ntheta = 32 &
    )
    call theta_grid_parameters_config%setup("theta_grid_parameters", requires_index=.false.)
    call set_theta_grid_params_config(theta_grid_parameters_config)

    call init_theta_grid

    new_bmag = interpolate(bmag, previous_theta, theta)
    new_grho = interpolate(grho, previous_theta, theta)
    new_gbdrift = interpolate(gbdrift, previous_theta, theta)
    new_cvdrift = interpolate(cvdrift, previous_theta, theta)
    new_gds2 = interpolate(gds2, previous_theta, theta)
    new_gds21 = interpolate(gds21, previous_theta, theta)

    @assertEqual(new_bmag, previous_Bmag, tolerance=tolerance, message="Bmag")
    @assertEqual(new_grho, previous_grho, tolerance=tolerance, message="grho")
    @assertEqual(new_gbdrift, previous_gbdrift, tolerance=tolerance, message="gbdrift")
    @assertEqual(new_cvdrift, previous_cvdrift, tolerance=tolerance, message="cvdrift")
    @assertEqual(new_gds2, previous_gds2, tolerance=tolerance, message="gds2")
    @assertEqual(new_gds21, previous_gds21, tolerance=tolerance, message="gds21")

  end subroutine test_asym_geo_fourier

  !>  Calculates several geometric coefficients from the generalized
  !!  elongation flux surface specification to verify that they have
  !!  not changed.
  @test(npes=[1])
  subroutine test_asym_geo_genElong(this)
    use theta_grid, only: bmag, grho, gbdrift, cvdrift, gds2, gds21, set_theta_grid_config
    use theta_grid, only : init_theta_grid, theta
    use theta_grid_params, only: init_theta_grid_params, set_theta_grid_params_config, &
         theta_grid_parameters_config_type

    class(MPITestMethod), intent(inout) :: this

    real, parameter :: previous_Bmag(grid_size) = [ &
         1.32374054827664, 1.31804392669621, 1.30829002891367, &
         1.27530782709033, 1.22778077483077, 1.17404736696701, 1.12001595485753, &
         1.0930185783729, 1.04425645396722, 1.01769352943759, 0.976638334654061, &
         0.947970456742778, 0.924748817827418, 0.902550400544131, &
         0.880526695579318, 0.862428731484493, 0.856453410115731, &
         0.862428731484493, 0.880526695579318, 0.902550400544131, &
