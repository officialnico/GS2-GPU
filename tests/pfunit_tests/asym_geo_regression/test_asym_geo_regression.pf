         0.913804260054291, 1.04137270948477, 1.22325635606895, &
         1.34350356539704, 1.5707963267949, 1.70169602069447, &
         1.96349540849362, 2.22529479629277, 2.48709418409192, &
         2.61799387799149, 2.74889357189107, 3.14159265358979]
    real, parameter :: previous_Bmag(grid_size) = [ &
         1.33243312394724, 1.31609038353426, 1.29944581732185, &
         1.27865665577025, 1.22904201792353, 1.17531996543297, &
         1.1212472336655, 1.09384040948333, 1.04452336063811, &
         1.01749312268327, 0.976370713227221, 0.948526753229513, &
         0.925435118566163, 0.901347548257888, 0.876578418704114, &
         0.857978934867862, 0.853728419084156, 0.857978934867862, &
         0.876578418704114, 0.901347548257888, 0.925435118566163, &
         0.948526753229513, 0.976370713227221, 1.01749312268327, &
         1.04452336063811, 1.09384040948333, 1.1212472336655, &
         1.17531996543297, 1.22904201792353, 1.27865665577025, &
         1.29944581732185, 1.31609038353426, 1.33243312394724]
    real, parameter :: previous_grho(grid_size) = [ &
         0.671476783814217, 0.655376205516751, 0.645474330113914, &
         0.635755286635991, 0.621030571063152, 0.619021950832028, &
         0.636083048443971, 0.654858594504839, 0.715714466573281, &
         0.771688700482797, 0.906600342256315, 1.02597090961678, &
         1.082828342861, 1.0746905130402, 1.00349468546693, &
         0.889504009645021, 0.819130116239692, 0.773807436271998, &
         0.753383817344089, 0.767126347171711, 0.791641503483525, &
         0.818410486514247, 0.850385090496886, 0.890164163611287, &
         0.90760647432831, 0.914685797109559, 0.903898726229265, &
         0.859137751377334, 0.799324691492278, 0.74340860227985, &
         0.721335240987457, 0.703937480088525, 0.671476783814217]
    real, parameter :: previous_gbdrift(grid_size) = [ &
         -1.02617555770194, -0.712969498574763, -0.561130408637568, &
         -0.42910219126836, -0.212236954155456, -0.0378366665373612, &
