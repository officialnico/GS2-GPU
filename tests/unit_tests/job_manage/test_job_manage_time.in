!==============================================================================
!
!  GS2 is a gyrokinetic flux tube initial value turbulence code 
!  which can be used for fusion or astrophysical plasmas.
!  
!  	See http://bitbucket.org/gyrokinetics/gs2
!
!==============================================================================

&parameters
 beta = 0.0
/

&kt_grids_knobs
 grid_option = "single"
/

&theta_grid_parameters
 ntheta = 6
 nperiod = 1
/

&theta_grid_knobs
 equilibrium_option = "s-alpha"
/

&le_grids_knobs
 ngauss = 1
 negrid = 4
/

&dist_fn_knobs
 boundary_option = "linked"

&knobs
 fphi = 1.0
 fapar = 0.0
 fbpar = 0.0
 delt = 0.05
 nstep = 200000
 avail_cpu_time = 2.0
 margin_cpu_time = 0.0
/

&collisions_knobs
 collision_model = "none"
/

&species_knobs
 nspec = 1
/

&species_parameters_1
 z = 1.0 
 mass = 1.0 
 dens = 1.0 
 temp = 1.0 
 tprim = 6.9
 fprim = 2.2
 uprim = 0.0
 vnewk = 0.01
 type = "ion"
/

&dist_fn_species_knobs_1
 fexpr = 0.45
 bakdif = 0.05
/


