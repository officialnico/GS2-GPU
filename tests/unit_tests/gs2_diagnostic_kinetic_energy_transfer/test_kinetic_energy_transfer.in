&nonlinear_terms_knobs
 nonlinear_mode = "on"
 cfl = 0.5
/

&kt_grids_knobs
 grid_option = "box"
/

&kt_grids_box_parameters
 ny = 8
 nx = 8
 y0 = 5.0
 jtwist = 4
/

&theta_grid_parameters
 ntheta = 8
 nperiod = 1
 eps = 0.18
 epsl = 2.0
 shat = 0.8
 pk = 1.44
 shift = 0.0
/

&theta_grid_knobs
 equilibrium_option = "s-alpha"
/

&le_grids_knobs
 npassing = 3
 nesuper = 1
 nesub = 3
/

&dist_fn_knobs
 boundary_option = "linked"
 adiabatic_option = "iphi00=2"
/

&knobs
 beta = 0.0
 zeff = 1.0
 fphi = 1.0
 fapar = 0.0
 delt = 0.1
 nstep = 10
 seed = 42
/

&layouts_knobs
 layout = "xyles"
/

&collisions_knobs
 collision_model = "none"
/

&species_knobs
 nspec = 1
/

&species_parameters_1
 z = 1.0
 mass = 1.0
 dens = 1.0
 temp = 1.0
 tprim = 6.9
 fprim = 2.2
 uprim = 0.0
 vnewk = 0.01
 type = "ion"
/

&dist_fn_species_knobs_1
 fexpr = 0.45
 bakdif = 0.05
/

&init_g_knobs
 chop_side = .false.
 phiinit = 1.0
 ginit_option = "default"
/

&gs2_diagnostics_knobs
  write_ascii = .false.
  write_phi_over_time = .true.
  write_moments = .false.
  ob_midplane = .false.
  omegatinst = 500
  omegatol = -0.001 ! necessary to force nstep is actually run
  write_omega = .true.
  file_safety_check = .true.
  print_line = .false. !added
  save_distfn = .false.
  nwrite = 10
  write_kinetic_energy_transfer = .true.
/
