export
include $(GK_HEAD_DIR)/Makefile.utils

# Specify any required modules that are not in libgs2.a
TEST_MODS= $(GK_HEAD_DIR)/functional_tests.o  $(GK_HEAD_DIR)/libgs2.a $(GK_HEAD_DIR)/benchmarks.o

# Run the tests in all subfolders unless otherwise specified
# by setting the variable TESTS
ifdef TESTS
TESTS_TMP = $(filter $(wildcard */.),$(patsubst %,%/.,$(TESTS)))
else
TESTS_TMP = $(wildcard */.)
endif

ifdef EXCLUDE_TESTS
TESTS_ACTUAL = $(filter-out $(patsubst %,%/.,$(EXCLUDE_TESTS)),$(TESTS_TMP))
else
TESTS_ACTUAL = $(TESTS_TMP)
endif

.PHONY: all $(TESTS_ACTUAL) clean upload

all: $(TESTS_ACTUAL)

upload:
	$(call messageOp,"Uploading test results")
	$(QUIETSYM)$(foreach element, $(TESTS_ACTUAL),$(MAKE) $@ -C $(element);)

clean:
	$(call messageRm,"$(TEST_TYPE) test cases")
	$(QUIETSYM)$(foreach element, $(TESTS_ACTUAL),$(MAKE) $@ -C $(element) TEST_NAME=$(dir $(element)) --no-print-directory;)

$(TESTS_ACTUAL):
	$(call messageOp,"Making test case",$@)
	$(QUIETSYM)$(MAKE) all -C $@ TEST_FOLD=$@
