export
SHELL := bash
include $(GK_HEAD_DIR)/Makefile.utils

.SUFFIXES: .fpp .f90 .c .o
.PHONY: all clean_individual_test

.f90.o:
	$(call messageOp,"Compiling","\\t:",$<)
	$(QUIETSYM)$(FC) $(F90FLAGS) -I$(GK_HEAD_DIR) -c $< 

.c.o:
	$(call messageOp,"Compiling C","\\t:",$<)
	$(QUIETSYM)$(CC) $(CFLAGS) $(CPPFLAGS) -I$(GK_HEAD_DIR) -c $< 

ifdef ONE_STEP_PP
.fpp.o:
	$(call messageOp,"Compiling and preprocessing","\\t:",$<)
	$(QUIETSYM)$(FC) $(FPPFLAGS) $(F90FLAGS) -I$(GK_HEAD_DIR) -c $< 
else
.fpp.f90:
	$(call messageOp,"Preprocessing","\\t:",$<)
	$(QUIETSYM)$(CPP) $(FPPFLAGS) -I$(GK_HEAD_DIR) $< $@ 
endif

# This prevents error messages like m2c: Command not found
%.o : %.mod

CLEAN_TEST_FILES=*.o *.error *.out *.out.nc *.gridgen.200 *.lpc *.vres *.fields *.g *.fort.?? *.mod .*.scratch *.moments *.cdf *.jext *.parity *.heat *.heat2 *.vres2 *.amoments *.eigenfunc *.nc* *.mom2 *.epar .*.in results_of_test.txt *.stop *.fftw_wisdom *.phase *.kpar *.interp *.dist

ifdef CLEAN_TEXTFILES
	CLEAN_TEST_FILES+= *~ *.orig
endif

clean_individual_test:
	$(call messageRm,"\\t$(TEST_NAME)")
	-$(QUIETSYM)rm -f ${CLEAN_TEST_FILES}
	-$(QUIETSYM)rm -f ${CLEANCOMMAND}

upload:
	$(UPLOADCOMMAND)


ifdef TESTEXEC
# TESTEXEC is typically defined in a system makefile
# For example, in Makefile.debian (note the double $$):
# TESTEXEC=mpirun -np $$(1)
#
# Before r3768, TESTEXEC did not allow you to override
# the number of processes, for example, in Makefile.archer
# TESTEXEC=aprun -N 24 -n 24;
#
# This will still work (so any system Makefiles that haven't
# been updated will still work), but the correct form is now
# TESTEXEC=aprun -N $$(1) -n $$(1)';
TESTCOMMAND=$(call TESTEXEC,$(NTESTPROCS)) ./
else
ifdef USE_MPI
TESTCOMMAND=mpirun -np $(NTESTPROCS) ./
else
TESTCOMMAND=./
endif
endif

define RUNCOMMAND
$(call messageOp,"Running ","\\t:",$(1))
@$(TESTCOMMAND)$(1) $(2) $(3) > OUTPUT ; if test "$$?" != 0; then $(FAILCOMMAND) ; else $(PASSCOMMAND) ;  fi
endef

define FAILCOMMAND
echo "FAILED: `basename $$PWD` ($(TESTCOMMAND)$(1) $(2) $(3))" >> results_of_test.txt ; $(TEST_DIR)/write_test_xml.sh `basename $$PWD` 1 0 1 0 $(TEST_RESULT_DIR); cat OUTPUT
endef

define PASSCOMMAND
echo "passed: `basename $$PWD` ($(TESTCOMMAND)$(1) $(2) $(3))" >> results_of_test.txt ; $(TEST_DIR)/write_test_xml.sh `basename $$PWD` 1 0 0 0 $(TEST_RESULT_DIR)
endef

define SKIPCOMMAND
@echo "skipped: `basename $$PWD` ($(1))" >> results_of_test.txt ; $(TEST_DIR)/write_test_xml.sh `basename $$PWD` 1 0 0 1 $(TEST_RESULT_DIR)
endef

BENCHMARKEXEC=$(call TESTEXEC,$(1)) ./$(2) $(3)

BENCHMARKCOMMAND= $(call BENCHMARKEXEC,$(1),$(2),$(3)); if test "$$?" != 0; then  echo "FAILED: `basename $$PWD` ($(call BENCHMARKEXEC,$(1),$(2),$(3)))" >> results_of_test.txt; else echo "passed: `basename $$PWD` ($(call BENCHMARKEXEC,$(1),$(2),$(3)))" >> results_of_test.txt;  fi

UPLOAD_BENCHMARKS= ls $(1) | xargs -n 1 -I {} scp {} $(USER),gyrokinetics@web.sourceforge.net:htdocs/wikifiles/benchmark_data/.
